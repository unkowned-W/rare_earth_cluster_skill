      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "General protocol for 1–4: LH4 (0.074 g, 0.20 mmol) was dissolved in methanol (10 mL). Ln(NO3)3·xH2O (0.20 mmol; Gd salt for 1) and triethylamine (0.50 mmol) were added and the mixture was stirred for 30 min. Mn(ClO4)2·6H2O (0.040 g, 0.11 mmol) was then added and stirring continued for 3 h at room temperature to give a clear deep brown solution. The solution was filtered and kept in a vial for crystallization at room temperature; dark red-brown block-shaped crystals appeared in 4–7 days. Aerial oxidation in basic medium converts Mn(II) to Mn(III).",
        "reagents": [
          {
            "name": "LH4 ((E)-2,2'-(2-hydroxy-3-((2-hydroxyphenylimino)methyl)-5-methylbenzylazanediyl)diethanol)",
            "formula": "C19H24N2O4",
            "role": "ligand",
            "amount": "0.074 g, 0.20 mmol"
          },
          {
            "name": "gadolinium(III) nitrate hydrate",
            "formula": "Gd(NO3)3·xH2O",
            "role": "metal source",
            "amount": "0.20 mmol"
          },
          {
            "name": "triethylamine",
            "formula": "Et3N",
            "role": "base",
            "amount": "0.50 mmol"
          },
          {
            "name": "manganese(II) perchlorate hexahydrate",
            "formula": "Mn(ClO4)2·6H2O",
            "role": "metal source",
            "amount": "0.040 g, 0.11 mmol"
          }
        ],
        "solvents": [
          "methanol"
        ],
        "temperature": "room temperature",
        "time": "30 min then 3 h stirring; crystals in 4–7 days",
        "ph": null,
        "vessel_or_method": "stirred solution in methanol, filtered, crystallization in a vial",
        "workup_and_crystallization": "filtered deep brown solution kept in a vial at room temperature; dark red-brown block-shaped crystals by slow evaporation",
        "yield": "0.056 g (35.4% based on Gd)"
      },
      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "Global antiferromagnetic interactions. χT(300 K)=27.3 emu·K·mol−1 (expected 29.64). Fit of χT(T) for 1: g=1.93(2), J1(Mn–Gd)=−0.23(1) cm−1, J2(Gd–Gd)=−0.68(1) cm−1. M(H) at 1.8 K shows an inflection at 3.4 T (~15 μB); saturation not reached vs expected ~29 μB. No out-of-phase AC signal; no SMM behavior.",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "χT",
            "value": 27.3,
            "unit": "emu·K·mol−1",
            "conditions": "room temperature, 500 Oe dc, polycrystalline"
          },
          {
            "property_type": "magnetic",
            "name": "J1 (Mn–Gd)",
            "value": "-0.23(1)",
            "unit": "cm−1",
            "conditions": "fit of χT(T), Magpack; Mn(III) anisotropy and intermolecular interactions neglected"
          },
          {
