      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "All operations were performed in an open atmosphere. A methanol solution (5 mL) of Tb(NO3)3·6H2O (0.1360 g, 0.3 mmol) was slowly added to a dichloromethane solution (25 mL) of H2L (0.0947 g, 0.3 mmol). The mixed solution was stirred for 4 h at ambient temperature and then diffused slowly with n-hexane or petroleum ether (60–90 °C). Yellow crystals of 1 were obtained in one week.",
        "reagents": [
          {
            "name": "N,N'-bis(salicylidene)-1,2-phenylenediamine (H2L)",
            "formula": "C20H16N2O2",
            "role": "ligand",
            "amount": "0.0947 g, 0.3 mmol"
          },
          {
            "name": "terbium(III) nitrate hexahydrate",
            "formula": "Tb(NO3)3·6H2O",
            "role": "metal salt",
            "amount": "0.1360 g, 0.3 mmol"
          }
        ],
        "solvents": [
          "methanol",
          "dichloromethane",
          "n-hexane",
          "petroleum ether (60–90 °C)"
        ],
        "temperature": "ambient temperature",
        "time": "stirred 4 h; crystals in one week",
        "ph": null,
        "vessel_or_method": "open-atmosphere solution reaction followed by vapor/liquid diffusion",
        "workup_and_crystallization": "diffusion with n-hexane or petroleum ether (60–90 °C) afforded yellow crystals",
        "yield": "0.0560 g (31.1 %)"
      },
      "properties": {
        "reported": true,
        "property_type": "optical",
        "summary": "UV–Vis absorption of 1 in MeOH is ligand-based and red-shifted versus free H2L, with bands at 242, 288 and 388 nm; no luminescence or magnetic measurements are reported for the isolated complexes.",
        "measurements": [
          {
            "property_type": "optical",
            "name": "UV–Vis absorption maxima",
            "value": "242, 288, 388",
            "unit": "nm",
            "conditions": "CH3OH, 25 °C"
          }
        ]
