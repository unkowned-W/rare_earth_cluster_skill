            "property_type": "magnetic",
            "name": "Ueff",
            "value": "90",
            "unit": "K",
            "conditions": "Arrhenius analysis of χ''(ν); approximately 90 K"
          },
          {
            "property_type": "magnetic",
            "name": "slow magnetic relaxation",
            "value": null,
            "unit": null,
            "conditions": "χ''(T,ν) up to 30 K; peak in χ''(T) severely broadened; incomplete Cole–Cole plots up to 20 K"
          }
        ]
