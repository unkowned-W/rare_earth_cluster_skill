      "properties": {
        "reported": true,
        "property_type": "optical",
        "summary": "KBr-pellet NCD of P-/M-1 shows mirror-image enantiomeric CD. Ni(II) d–d bands (ca. 380, 590, 950 nm) are little changed by magnetic field, whereas Dy(III) hypersensitive 6H15/2→6F11/2 at 1298 nm gives strong NIR MCD under ±1.6 T (Faraday B-type). Hypersensitive f–f magneto-optical activity is reported as much stronger than Ni d–d and other f–f transitions.",
        "measurements": [
          {
            "property_type": "optical",
            "name": "NCD (KBr pellet)",
            "value": "mirror-symmetric enantiomeric CD vs M-1",
            "unit": null,
            "conditions": "P-1 solid in KBr; B = 0 T"
          },
          {
            "property_type": "optical",
            "name": "MCD / magneto-optic CD",
            "value": "strong NIR signal at hypersensitive 6H15/2–6F11/2",
            "unit": null,
            "conditions": "KBr pellet; CD at +1.6 and −1.6 T; MCD = [CD(+1.6 T) − CD(−1.6 T)]/2; 1298 nm"
          },
