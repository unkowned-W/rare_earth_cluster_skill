            "amount": "0.42 g; 3.33 mmol"
          },
          {
            "name": "iodine",
            "formula": "I2",
            "role": "metal activation",
            "amount": "two crystals"
          }
        ],
        "solvents": [
          "2-methoxyethanol",
          "methanol",
          "hexane"
        ],
