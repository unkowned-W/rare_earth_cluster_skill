      "synthesis": {
        "main_text_has_explicit_synthesis": false,
        "si_used": true,
        "procedure": "H2L (0.0898 g, 0.2 mmol), Eu(NO3)3·6H2O (0.0446 g, 0.1 mmol) and Eu(OAc)3·4H2O (0.0401 g, 0.1 mmol) were dissolved in 12 mL EtOH/MeOH (5:1), and TEA (1.1 mmol/L) in 1 mL EtOH was added. The mixture was stirred and heated under reflux for 15 min, then filtered at room temperature. The filtrate was layered with diethyl ether and allowed to mix by slow diffusion at room temperature for one week. Yellow crystals were filtered, washed with 5 mL EtOH, and dried at 110 °C for 6 h. The main text only states that Eu60 was obtained from H2L, Eu(NO3)3·6H2O and Eu(OAc)3·4H2O in MeOH/EtOH under reflux, without quantities.",
        "reagents": [
          {
            "name": "H2L (6,6'-((1E,1'E)-((azanediylbis(ethane-2,1-diyl))bis(azanylylidene))bis(methanylylidene))bis(2,4-dichlorophenol))",
