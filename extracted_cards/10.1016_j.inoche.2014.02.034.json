      "properties": {
        "reported": true,
        "property_type": "optical",
        "summary": "In MeCN, ligand-centered excitation sensitizes characteristic Nd3+ NIR emission (4F3/2 → 4IJ; J = 9/2, 11/2, 13/2). Residual visible ligand fluorescence is strongly quenched. Monoexponential NIR lifetime gives intrinsic quantum yield φLn = 0.40%, slightly lowered by three OH− oscillators. Energy transfer rate estimated >1.2 × 10^8 s−1 versus Gd analogue 5.",
        "measurements": [
          {
            "property_type": "optical",
            "name": "UV-vis absorption maxima",
            "value": "236–238, 276–278, 350–353",
            "unit": "nm",
            "conditions": "MeCN, complexes 2–5"
          },
          {
            "property_type": "optical",
            "name": "residual visible emission",
            "value": "476",
            "unit": "nm",
