      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "HLser (1.0 g, 3.5 mmol) was added to lithium hydroxide hydrate (0.15 g, 3.5 mmol) in water (50 mL) and stirred for 1 h until homogeneous. The solvent was removed and the precipitate dried in vacuo to give LiLser as a light yellow powder (0.868 g, 2.98 mmol). A 9 mL thick-walled glass tube with a Teflon screw top was charged with lanthanum nitrate hexahydrate (0.030 g, 0.069 mmol), LiLser (0.050 g, 0.14 mmol), water (0.8 mL), and ethanol (0.2 mL) and heated in an oil bath at 120 °C. Yellow plate crystals grew over 4 days on the vessel walls above the solvent line. Crystals were collected, washed with methanol, and dried on filter paper.",
        "reagents": [
          {
            "name": "HLser",
            "formula": "HLser",
            "role": "ligand precursor",
            "amount": "1.0 g, 3.5 mmol"
          },
          {
            "name": "lithium hydroxide hydrate",
            "formula": "LiOH·H2O",
            "role": "base",
            "amount": "0.15 g, 3.5 mmol"
          },
          {
            "name": "LiLser",
            "formula": "LiLser",
            "role": "ligand",
            "amount": "0.050 g, 0.14 mmol"
          },
          {
            "name": "lanthanum nitrate hexahydrate",
            "formula": "La(NO3)3·6H2O",
            "role": "metal source",
            "amount": "0.030 g, 0.069 mmol"
          }
        ],
        "solvents": [
          "water",
          "ethanol",
          "methanol"
        ],
        "temperature": "120 °C",
        "time": "4 days",
        "ph": null,
        "vessel_or_method": "9 mL thick-walled glass tube with Teflon screw top; oil-bath solvothermal heating",
        "workup_and_crystallization": "Yellow plate crystals grew above the solvent line; collected, washed with methanol, and dried over filter paper.",
        "yield": "0.060 g, 62%"
      },
      "properties": {
        "reported": true,
        "property_type": "optical",
        "summary": "Solid-state luminescence is dominated by the naphthalimide chromophore; compound 1 belongs to the set of pure-metal complexes (except Ce and Eu) that show identical blue-green ligand-based emission, red-shifted relative to free ligand, assigned to LMCT. No magnetic data were reported for the La analogue.",
        "measurements": [
          {
