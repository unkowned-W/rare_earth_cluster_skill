      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "SQUID data on 1 indicate antiferromagnetic Cu–Gd coupling through distorted oximate bridges, giving a ferrimagnetic ground state Stotal = 27/2 with 2J/kB = −2.9(2) K (g = 2.03, purity factor p = 0.93(2)). Magnetization at 1.8 K and 7 T reaches 1.44×10^4 erg Oe−1 mol−1 (~94% of the Stotal = 27/2, g = 2.03 calculated saturation). X-band ESR of polycrystalline 1 shows a broad g = 2.03 signal.",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "2J/kB (Cu–Gd)",
            "value": "-2.9(2)",
            "unit": "K",
            "conditions": "Heisenberg fit of χmol T; g fixed at 2.03; p = 0.93(2); 1.8–300 K SQUID"
          },
          {
            "property_type": "magnetic",
            "name": "ground-state spin Stotal",
            "value": "27/2",
            "unit": null,
            "conditions": "ferrimagnetic CuGd4 model"
