      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "A mixture of 1 M aqueous Dy(ClO4)3 (1.5 mL, 1.5 mmol), CrCl3·6H2O (133.2 mg, 0.5 mmol), and HGly (112.6 mg, 1.5 mmol) was dissolved in deionized water (4 mL). The pH was carefully adjusted to about 5.4 by slow addition of 0.1 M NaOH. After stirring for 10 min the color turned from green to red; the mixture was filtered. Red crystals were obtained by slow evaporation of the filtrate for about 3 weeks.",
