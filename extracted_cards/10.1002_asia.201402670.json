            "value": 44.57,
            "unit": "cm3 K mol-1",
            "conditions": "2 K, 1000 Oe"
          },
          {
            "property_type": "magnetic",
            "name": "magnetization",
            "value": 17.6,
            "unit": "μB",
            "conditions": "7 T, 1.9 K"
          },
          {
            "property_type": "magnetic",
            "name": "Ueff",
            "value": 37,
            "unit": "K",
            "conditions": "ac under 300 Oe dc; Arrhenius fit 5-8 K"
          },
          {
            "property_type": "magnetic",
