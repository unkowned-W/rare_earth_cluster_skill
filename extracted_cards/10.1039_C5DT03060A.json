            "role": "metal salt",
            "amount": "0.087 g, 0.23 mmol"
          },
          {
            "name": "triethylamine",
            "formula": "Et3N",
            "role": "base",
            "amount": "0.096 mL, 0.73 mmol"
          },
          {
            "name": "pivalic acid",
            "formula": "PivH",
            "role": "coligand",
            "amount": "0.028 g, 0.27 mmol"
          }
        ],
        "solvents": [
          "methanol",
          "chloroform",
          "diethyl ether"
        ],
        "temperature": "room temperature",
        "time": "20 min + 10 min + 12 h stirring; crystallization ~12 days",
        "ph": null,
        "vessel_or_method": "solution synthesis followed by slow evaporation from MeOH/CHCl3 (1:1)",
        "workup_and_crystallization": "Evaporated in vacuo; washed 2–3 times with diethyl ether; dried; redissolved in MeOH/CHCl3 (1:1); needle-shaped yellow crystals by slow evaporation after ~12 days.",
        "yield": "0.076 g, 63.3% (based on Dy3+)"
      },
      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "χmT = 64.9 cm3 K mol−1 at 290 K (0.1 T), slightly below five free Dy3+ ions; decrease on cooling attributed to ligand-field effects and weak antiferromagnetic exchange. Zero-field AC data show out-of-phase signals with small Argand curvature. Under 3000 G DC field, Cole–Cole/Arrhenius analysis gives ΔU = 5.2 ± 0.5 cm−1, τ0 = (2.6 ± 0.6)×10−2 s and α = 0.45 ± 0.08, indicating slow relaxation that is not typical SMM Orbach behaviour.",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "χmT",
            "value": 64.9,
            "unit": "cm3 K mol−1",
            "conditions": "290 K, B = 0.1 T"
          },
          {
            "property_type": "magnetic",
            "name": "effective energy barrier ΔU",
            "value": "5.2 ± 0.5",
            "unit": "cm−1",
            "conditions": "AC, Bdc = 3000 G, Arrhenius fit"
          },
          {
            "property_type": "magnetic",
            "name": "relaxation time constant τ0",
            "value": "(2.6 ± 0.6)×10−2",
            "unit": "s",
            "conditions": "AC, Bdc = 3000 G"
          },
          {
            "property_type": "magnetic",
            "name": "Cole–Cole α",
            "value": "0.45 ± 0.08",
            "unit": null,
            "conditions": "generalized Debye model, 3000 G"
          }
        ]
      },
