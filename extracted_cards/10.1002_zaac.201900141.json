      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Under Schlenk conditions, 1-tert-butyl-3-ethyl-carbodiimide (1.00 g, 7.92 mmol) in THF (50 mL) was treated at 0 °C with 4.95 mL (7.92 mmol) of 1.6 M methyllithium in diethyl ether to generate Li(L) (1) in situ. After stirring at room temperature for 24 h, a suspension of anhydrous LaCl3 (0.65 g, 2.64 mmol) in THF (50 mL) was added and stirring was continued for 5 d. The mixture was evaporated to dryness, extracted with ca. 70 mL toluene, filtered to remove LiCl, evaporated, and recrystallized from ca. 3–5 mL DME at −32 °C to give colorless block-like crystals.",
        "reagents": [
          {
            "name": "1-tert-butyl-3-ethyl-carbodiimide",
            "formula": "tBuN=C=NEt",
            "role": "ligand precursor",
            "amount": "1.00 g, 7.92 mmol"
          },
          {
            "name": "methyllithium (1.6 M in diethyl ether)",
            "formula": "MeLi",
            "role": "lithiating agent",
            "amount": "4.95 mL, 7.92 mmol"
          },
          {
            "name": "lanthanum(III) chloride",
            "formula": "LaCl3",
            "role": "metal source",
            "amount": "0.65 g, 2.64 mmol"
          }
        ],
        "solvents": [
          "THF",
          "diethyl ether",
          "toluene",
          "DME"
        ],
        "temperature": "0 °C for MeLi addition, then room temperature; recrystallization at −32 °C",
        "time": "24 h for Li(L) formation, then 5 d after LaCl3 addition",
        "ph": null,
        "vessel_or_method": "250 mL Schlenk flask; salt metathesis",
        "workup_and_crystallization": "Evaporated to dryness, extracted with toluene, filtered to remove LiCl, evaporated, recrystallized from DME at −32 °C.",
        "yield": "0.83 g (48%)"
