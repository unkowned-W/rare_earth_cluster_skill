      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Under nitrogen (drybox/Schlenk), Sm (160 mg, 1.06 mmol), Hg (39 mg, 0.19 mmol), and PhSeSePh (478 mg, 1.53 mmol) were stirred in pyridine (30 mL) for 24 h to give a clear light orange solution. NaN3 (137 mg, 2.10 mmol) and Na2O (63 mg, 1.01 mmol) were added and the mixture was stirred for 3 days in the dark, giving a clear yellow solution and a white precipitate. The solution was filtered, concentrated to 20 mL, and layered with hexanes (4 mL) in the dark to afford hexagonal colorless crystals (46 mg, 8.3%) that become white and amorphous when removed from mother liquor, turn brown at 119 °C, and detonate at 295 °C.",
        "reagents": [
