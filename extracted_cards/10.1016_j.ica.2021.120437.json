            "conditions": "1000 Oe; per complex"
          },
          {
            "property_type": "magnetic",
            "name": "magnetization",
            "value": 20.9,
            "unit": "μB",
            "conditions": "2 K, 7 T"
          },
          {
            "property_type": "magnetic",
            "name": "ac out-of-phase onset / SMM",
            "value": "χ′ and χ″ below 8 K; χ″ maxima <1.8 K",
            "unit": null,
            "conditions": "zero dc field; ac field 3 Oe; 1–1500 Hz"
          }
