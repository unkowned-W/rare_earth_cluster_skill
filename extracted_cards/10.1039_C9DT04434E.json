        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "A mixture of Dy(OAc)3·4H2O (0.2 mmol), Hpphz (0.1 mmol) and 5 drops of triethylamine in 7 mL MeOH was sealed in a Teflon-lined stainless autoclave after stirring for several minutes. The autoclave was heated to 60 °C for 48 h and then cooled to room temperature at 0.5 °C min−1, giving yellowish crystals of 1. The H2aphz− ligands formed in situ by hydrolysis of the amine Schiff-base group of Hpphz.",
        "reagents": [
          {
            "name": "dysprosium acetate tetrahydrate",
            "formula": "Dy(OAc)3·4H2O",
