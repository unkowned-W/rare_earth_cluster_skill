      },
      "properties": {
        "reported": true,
        "property_type": "optical",
        "summary": "Ligand-centered UV-vis absorption is red-shifted versus free H2L. Residual visible emission near 505 nm is almost undetectable (τ < 1 ns, Φem < 10^-5). Photoexcitation of the antenna (λex = 385/403 nm) gives characteristic Nd3+ NIR emissions at 909, 1085 and 1365 nm; the 1085 nm decay is monoexponential with τ = 1.41 μs and estimated intrinsic quantum yield ΦLn = 0.564%. NIR intensity increases in CD3CN and CD3OD versus MeCN.",
        "measurements": [
          {
            "property_type": "optical",
            "name": "UV-vis absorption maxima",
            "value": "227 (log ε 0.74), 268 (0.31), 342 (0.11)",
            "unit": "nm (log[ε/dm3 mol-1 cm-1])",
            "conditions": "1×10^-5 M in MeCN, room temperature"
          },
          {
            "property_type": "optical",
            "name": "excitation wavelengths",
            "value": "385, 403 (sh)",
            "unit": "nm",
            "conditions": "MeCN solution, monitoring NIR/visible emission"
          },
          {
            "property_type": "optical",
            "name": "Nd3+ NIR emission bands",
            "value": "909, 1085, 1365",
            "unit": "nm",
            "conditions": "MeCN, λex = 402 nm (antenna range 230–500 nm)"
          },
          {
            "property_type": "optical",
            "name": "NIR lifetime at 909 nm",
            "value": 1.39,
            "unit": "μs",
            "conditions": "MeCN, room temperature"
          },
          {
            "property_type": "optical",
            "name": "NIR lifetime at 1085 nm",
            "value": 1.41,
            "unit": "μs",
            "conditions": "MeCN, room temperature, monoexponential"
