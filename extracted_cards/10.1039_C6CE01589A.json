            "formula": "Dy(NO3)3·6H2O",
            "role": "Ln source",
            "amount": "0.1 mmol"
          },
          {
            "name": "sodium hydroxide",
            "formula": "NaOH",
            "role": "base",
            "amount": "0.1 mmol"
          }
        ],
