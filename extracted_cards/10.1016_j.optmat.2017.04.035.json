            "name": "La(NO3)3·6H2O",
            "formula": "La(NO3)3·6H2O",
            "role": "metal salt",
            "amount": "0.4 mmol, 0.173 g"
          }
        ],
        "solvents": [
          "MeOH",
          "diethyl ether"
        ],
        "temperature": "reflux then room temperature",
        "time": "6 h reflux; crystallization about two weeks",
        "ph": null,
        "vessel_or_method": "solution self-assembly under N2; diethyl ether vapor diffusion",
