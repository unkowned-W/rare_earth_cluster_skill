          {
            "name": "neodymium nitrate",
            "formula": "Nd(NO3)3",
            "role": "metal source",
            "amount": "1 mL of 10^-2 M in 0.01 M HNO3"
          },
          {
            "name": "nitric acid",
            "formula": "HNO3",
            "role": "medium",
            "amount": "0.01 M"
          },
          {
            "name": "citric acid",
            "formula": "H3Cit",
            "role": "ligand",
            "amount": "0.3 mL of 0.1 M aqueous solution"
          },
