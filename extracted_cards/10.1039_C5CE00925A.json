      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "Trinuclear Dy complex 1c shows χT close to three/six independent Dy3+ centers depending on the reported formula unit, a low-temperature χT drop attributed to intramolecular antiferromagnetic interactions, magnetic anisotropy (nonsuperimposable M vs H/T, no saturation at 7 T), and onset of slow magnetization relaxation under zero dc field. After applying a dc field the out-of-phase signals remain weak and slow relaxation is described as inconspicuous, possibly due to intramolecular Dy···Dy coupling shortcutting thermally activated relaxation.",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "χT",
            "value": 82.94,
            "unit": "cm3 K mol-1",
            "conditions": "room temperature; Hdc = 1000 Oe"
          },
          {
            "property_type": "magnetic",
            "name": "χT (expected)",
            "value": 85.02,
            "unit": "cm3 K mol-1",
            "conditions": "six independent Dy3+ ions as stated by the authors"
