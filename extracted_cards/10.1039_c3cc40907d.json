      },
      "synthesis": {
        "main_text_has_explicit_synthesis": false,
        "si_used": true,
        "procedure": "SI: 6 [Co2(μ-OH2)(O2CtBu)4(HO2CtBu)4] (0.036 g, 0.04 mmol), 7 [Gd2(O2CtBu)6(HO2CtBu)6] (0.165 g, 0.1 mmol), Et3N (0.1 mL, 1 mmol) and H2O3PC6H10NH2 (0.036 g, 0.2 mmol) in MeCN (8 mL) were stirred briefly at room temperature. The slurry was heated in a 10 mL Teflon-lined autoclave at 150 °C for 12 h and cooled to room temperature at 0.05 °C min−1. Pink block crystals were collected (10 mg, 10% based on 7). The main text gives the same solvothermal MeCN route at 150 °C and 10% yield, without reagent quantities; acetate and phosphate in the product arise from hydrolysis of MeCN and phosphonate.",
        "reagents": [
          {
            "name": "[Co2(μ-OH2)(O2CtBu)4(HO2CtBu)4]",
            "formula": "Co2(OH2)(O2CtBu)4(HO2CtBu)4",
