      ],
      "material_class": {
        "material_type": "cluster",
        "nuclearity": 4,
        "metal_composition": "homometallic",
        "rare_earth_elements": [
          "Dy"
        ],
        "other_metal_elements": [],
        "dimensionality": "0D",
        "structural_family": "planar butterfly Ln4"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Under aerobic conditions, a solution of N-methyldiethanolamine (0.089 g, 0.75 mmol) in MeCN (15 mL) was added dropwise over 20 min to a stirred solution of Dy(NO3)3·6H2O (0.114 g, 0.25 mmol) and pivalic acid (0.101 g, 1.00 mmol) in MeCN (15 mL). The mixture was stirred at room temperature for 2 h, filtered, and allowed to stand undisturbed in a sealed vial. Colorless needles of 2 suitable for X-ray crystallography were obtained after 3 days. Crystals were maintained in mother liquor or collected by filtration, washed with MeCN, and dried in vacuum.",
        "reagents": [
          {
            "name": "N-methyldiethanolamine",
            "formula": "C5H13NO2",
            "role": "ligand",
            "amount": "0.089 g, 0.75 mmol"
          },
          {
            "name": "dysprosium(III) nitrate hexahydrate",
            "formula": "Dy(NO3)3·6H2O",
            "role": "metal source",
            "amount": "0.114 g, 0.25 mmol"
          },
          {
            "name": "pivalic acid",
            "formula": "C5H10O2",
            "role": "ligand",
            "amount": "0.101 g, 1.00 mmol"
          }
        ],
        "solvents": [
          "MeCN"
        ],
        "temperature": "room temperature",
        "time": "dropwise addition 20 min, then stirred 2 h; crystals after 3 days",
        "ph": null,
        "vessel_or_method": "aerobic stirring then sealed vial crystallization",
        "workup_and_crystallization": "filtered and left undisturbed in a sealed vial; crystals washed with MeCN and dried in vacuum",
        "yield": "~45%"
      },
      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "Dy4 cluster 2 is a single-molecule magnet. χT is nearly constant from 300–60 K then decreases to 1.8 K; magnetization at 7 T is unsaturated. Frequency-dependent in-phase and out-of-phase ac signals appear below 12 K in zero dc field. Arrhenius fits give Δ = 6.2 K and τ0 = 2.4×10−5 s (zero field) and Δ = 6.9 K and τ0 = 4.8×10−5 s under 800 Oe. Micro-SQUID hysteresis opens at 1.1 K with steps below 0.3 K from resonant quantum tunneling; a small coercive field (~12 Oe) is also seen in M vs H at 1.8 K.",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "χT",
            "value": 57.7,
            "unit": "cm3 K mol-1",
            "conditions": "room temperature, 1000 Oe"
          },
          {
            "property_type": "magnetic",
            "name": "χT",
            "value": 37.6,
            "unit": "cm3 K mol-1",
            "conditions": "1.8 K, 1000 Oe"
          },
          {
            "property_type": "magnetic",
            "name": "χT expected for 4 non-interacting DyIII",
            "value": 56.68,
            "unit": "cm3 K mol-1",
            "conditions": "room temperature"
          },
          {
            "property_type": "magnetic",
            "name": "magnetization",
            "value": 25.6,
            "unit": "μB",
            "conditions": "7 T, 1.8 K"
          },
          {
            "property_type": "magnetic",
            "name": "effective energy barrier Δ",
            "value": 6.2,
            "unit": "K",
            "conditions": "zero dc field; Arrhenius fit to frequency-dependent ac data"
          },
          {
            "property_type": "magnetic",
            "name": "pre-exponential factor τ0",
            "value": "2.4e-5",
            "unit": "s",
            "conditions": "zero dc field"
          },
          {
            "property_type": "magnetic",
            "name": "effective energy barrier Δ",
            "value": 6.9,
            "unit": "K",
            "conditions": "800 Oe dc field"
          },
          {
            "property_type": "magnetic",
            "name": "pre-exponential factor τ0",
            "value": "4.8e-5",
            "unit": "s",
            "conditions": "800 Oe dc field"
          },
          {
            "property_type": "magnetic",
            "name": "characteristic ac frequency",
            "value": 240,
            "unit": "Hz",
            "conditions": "1.8 K, zero dc field"
          },
          {
            "property_type": "magnetic",
            "name": "characteristic ac frequency",
            "value": 75,
            "unit": "Hz",
            "conditions": "1.8 K, ~800 Oe dc field"
          },
          {
            "property_type": "magnetic",
            "name": "hysteresis opening temperature",
            "value": 1.1,
            "unit": "K",
            "conditions": "micro-SQUID, field along easy axis"
          },
          {
            "property_type": "magnetic",
            "name": "coercive field",
            "value": 12,
            "unit": "Oe",
            "conditions": "M vs H at 1.8 K (polycrystalline, SI Figure S2)"
          }
        ]
