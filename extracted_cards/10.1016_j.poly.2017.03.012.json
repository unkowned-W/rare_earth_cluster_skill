            "name": "magnetization M",
            "value": 29.73,
            "unit": "μB",
            "conditions": "3 K, 50 kOe"
          },
          {
            "property_type": "magnetic",
            "name": "Ueff/kB",
            "value": 6.17,
            "unit": "K",
            "conditions": "zero dc field; Arrhenius fit of frequency-dependent ac χ'' maxima"
          },
          {
            "property_type": "magnetic",
            "name": "τ0",
            "value": "4.9e-5",
            "unit": "s",
            "conditions": "zero dc field; Arrhenius pre-exponential factor"
