      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "Dc susceptibility (1.8–300 K, 0.1 T) shows χMT near the six-ion high-T limit of 65.50 cm3 K mol−1, then decreasing on cooling. Magnetization at 2 K rises rapidly (~20 μB around 1.5 T) then linearly without saturation to 7 T, indicating anisotropy/low-lying states. Ac susceptibility (zero dc field, 3.0 G ac) shows frequency-dependent χ′ and χ″; SMM behaviour with blocking temperature around 2 K. Arrhenius fit of relaxation times gives Ueff = 34.0 K and τ0 = 2.0 × 10−11 s.",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "χMT high-T expected value",
            "value": 65.5,
            "unit": "cm3 K mol−1",
            "conditions": "room temperature; six non-interacting ions; 0.1 T dc field; 1.8–300 K data"
