          },
          {
            "property_type": "optical",
            "name": "direct Eu3+ excitation peaks",
            "value": "525 (5D1←7F0), 533 (5D1←7F1 hot band), 577 (5D0←7F0)",
            "unit": "nm",
            "conditions": "solid state, 77 K, Fig. 3"
          }
