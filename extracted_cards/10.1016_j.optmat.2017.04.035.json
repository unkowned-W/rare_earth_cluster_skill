      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Homogeneous ROMP of complex monomer 1 (0.02 mmol) with NBE (8 mmol, 752 mg; feed 1:400) activated by H-Grubbs II (1.5 mol% of NBE; 11 mg added in three portions 7+2+2 mg) in dry 1,2-dichloromethane (15 ml) in a Fisher-Porter glass reactor under dry N2. The solution was purged with N2 for 10 min, sealed, and stirred at room temperature for 72 h, then quenched with ethyl vinyl ether (1 ml). The polymer was precipitated into cold ethanol, collected by filtration, and dried at 45 °C under vacuum.",
        "reagents": [
          {
            "name": "complex monomer 1",
            "formula": "{[La3(L)4(NO3)6]·(NO3)·(H3O)2}",
            "role": "macromonomer",
            "amount": "0.02 mmol"
          },
          {
