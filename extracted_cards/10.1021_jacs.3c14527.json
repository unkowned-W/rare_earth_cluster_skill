            "conditions": "CD3OD; λexc = 326 nm"
          },
          {
            "property_type": "optical",
            "name": "Eu radiative lifetime (Werts formalism)",
            "value": 1.32,
            "unit": "ms",
            "conditions": "Eu8Yb cluster"
          },
          {
            "property_type": "optical",
            "name": "Yb NIR downshifted emission",
