      "ccdc_numbers": [
        "910046"
      ],
      "ccdc_refcodes": [],
      "material_class": {
        "material_type": "complex",
        "nuclearity": 1,
        "metal_composition": "homometallic",
        "rare_earth_elements": [
          "Pr"
        ],
        "other_metal_elements": [],
        "dimensionality": "0D",
        "structural_family": "eight-coordinate tris(β-diketonate) DMF adduct"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "IPhacacH (1.50 g, 3.15 mmol, 2.5 equiv.) was suspended in KOtBu (495 mg, 4.41 mmol, 3.5 equiv.) in MeOH (15 mL)/THF (30 mL) (v/v 1:2), stirred and refluxed to a clear yellow solution (5 min), then cooled to room temperature. PrCl3·7H2O (470 mg, 1.26 mmol, 1.0 equiv.) in MeOH (10 mL) was added dropwise, inducing precipitation. After stirring overnight, additional MeOH (30 mL) was added and the precipitate was filtered. The air-dried precipitate was extracted with hot toluene (clusters, if formed) then the residue was extracted with DMF (5 mL) and filtered. Slow diffusion of water into the DMF filtrate afforded single crystals of 1 after 4 d.",
        "reagents": [
          {
            "name": "bis(p-iododibenzoyl)methane (IPhacacH)",
            "formula": "C15H10I2O2",
            "role": "ligand precursor",
            "amount": "1.50 g, 3.15 mmol, 2.5 equiv."
          },
          {
            "name": "potassium tert-butoxide",
            "formula": "KOtBu",
            "role": "base",
            "amount": "495 mg, 4.41 mmol, 3.5 equiv."
          },
          {
            "name": "praseodymium(III) chloride heptahydrate",
            "formula": "PrCl3·7H2O",
            "role": "metal source",
            "amount": "470 mg, 1.26 mmol, 1.0 equiv."
          }
        ],
        "solvents": [
          "MeOH",
          "THF",
          "DMF",
          "water"
        ],
        "temperature": "reflux then room temperature",
        "time": "overnight reaction; crystals after 4 d",
        "ph": null,
        "vessel_or_method": "solution reaction with subsequent DMF extraction and water-vapour diffusion crystallization",
        "workup_and_crystallization": "precipitate filtered, air-dried, extracted with hot toluene then DMF (5 mL); slow diffusion of water into the DMF filtrate",
        "yield": "811 mg, 38% (single crystals)"
      },
