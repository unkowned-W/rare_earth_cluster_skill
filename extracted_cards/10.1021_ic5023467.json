            "unit": "cm3 K mol−1",
            "conditions": "room temperature; H = 0.1 T (1000 Oe); polycrystalline; 2–300 K dc data"
          },
          {
            "property_type": "magnetic",
            "name": "−ΔSm (MCE)",
            "value": 34.6,
            "unit": "J kg−1 K−1",
            "conditions": "T = 2.7 K; μ0ΔH = 9 T"
          },
