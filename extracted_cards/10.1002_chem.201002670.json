      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Under Schlenk/glovebox conditions excluding air and water, AlMe3/heptane (2 mL, 1 M, 2 mmol) was added slowly to a stirred solution of [(NCN)Sc(CH2C6H4NMe2-o)2] (0.753 g, 1 mmol) in toluene (20 mL). The mixture was stirred overnight at ambient temperature. Toluene was removed under vacuum and the oily yellow residue was washed twice with cold hexane (2 mL) to give a yellow powder, which was redissolved in toluene. Concentration under reduced pressure and standing at room temperature for two days afforded yellow-green crystals of 2a (0.387 g, 76%).",
        "reagents": [
