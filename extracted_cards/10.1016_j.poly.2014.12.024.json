      "compound_label": "1",
      "compound_name": "[Tb9L4(μ4-OH)2(μ3-OH)8(NO3)8(CH3OH)2(H2O)2](NO3)·7CH3OH",
      "formula": "C59H114Tb9N13O68",
      "ccdc_numbers": [
