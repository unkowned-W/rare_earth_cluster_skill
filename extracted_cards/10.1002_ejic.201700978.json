            "name": "dysprosium(III) acetate hexahydrate",
            "formula": "Dy(CH3COO)3·6H2O",
            "role": "Dy source",
            "amount": "0.05 g, 0.11 mmol"
          },
          {
            "name": "triethylamine",
            "formula": "NEt3",
            "role": "base",
            "amount": "0.1 mL"
          }
        ],
        "solvents": [
          "CH3OH",
          "DEF"
