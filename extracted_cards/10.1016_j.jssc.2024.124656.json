      "compound_name": "{Mn5Sm5}",
      "formula": "[Mn5III Sm5III (μ4-O)4 (μ2-OH)2 (OAc)8 (OCH3)2 (ampdH)4 (NO3)4 (H2O)4](NO3)2·12H2O·2MeOH",
      "ccdc_numbers": [],
      "ccdc_refcodes": [],
      "material_class": {
        "material_type": "cluster",
        "nuclearity": 10,
