    {
      "compound_label": "4",
      "compound_name": "[Eu(tpaa)(H2O)]2·7H2O",
      "formula": "[Eu(tpaa)(H2O)]2·7H2O",
      "ccdc_numbers": [],
      "ccdc_refcodes": [],
      "material_class": {
        "material_type": "cluster",
        "nuclearity": 2,
        "metal_composition": "homometallic",
        "rare_earth_elements": [
          "Eu"
        ],
        "other_metal_elements": [],
        "dimensionality": "0D",
        "structural_family": "carboxylate-bridged Ln2(tpaa)2 dimer"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "H3tpaa (30 mg, 0.07 mmol) was added to a solution of EuCl3·6H2O (0.07 mmol) in water (10 mL). The resulting suspension was heated at 100 °C for a few minutes to give a clear solution. Slow cooling followed by slow evaporation yielded, after 48 h, [Eu(tpaa)(H2O)]2·7H2O (4) as colorless crystals suitable for X-ray analysis (yield 60–80%).",
        "reagents": [
          {
            "name": "H3tpaa",
            "formula": "C21H18N4O6",
            "role": "ligand",
            "amount": "30 mg, 0.07 mmol"
          },
          {
            "name": "europium(III) chloride hexahydrate",
            "formula": "EuCl3·6H2O",
            "role": "metal source",
            "amount": "0.07 mmol"
          }
        ],
        "solvents": [
          "water"
        ],
        "temperature": "100 °C (dissolution), then slow cooling",
        "time": "few minutes heating; crystals after 48 h",
        "ph": null,
        "vessel_or_method": "aqueous heating then slow evaporation",
        "workup_and_crystallization": "slow cooling of the clear solution followed by slow evaporation gave colorless X-ray quality crystals",
        "yield": "60–80%"
      },
      "properties": {
        "reported": true,
        "property_type": "optical",
        "summary": "Eu(5D0) luminescence lifetimes in H2O/D2O give q = 1.93 ± 0.2 coordinated water molecules, consistent with a nine-coordinate bis(aqua) monomer in solution.",
        "measurements": [
          {
            "property_type": "optical",
            "name": "luminescence lifetime τ(H2O)",
            "value": "0.438(5)",
            "unit": "ms",
            "conditions": "Eu(5D0); λexc = 290 nm, λem = 616 nm; 0.13 mM in H2O; 295 K"
          },
          {
            "property_type": "optical",
            "name": "luminescence lifetime τ(D2O)",
            "value": "2.32(2)",
            "unit": "ms",
            "conditions": "Eu(5D0); 0.13 mM in D2O; 295 K"
          },
          {
            "property_type": "optical",
            "name": "inner-sphere hydration number q",
            "value": "1.93 ± 0.2",
            "unit": null,
            "conditions": "Parker equation from τ(H2O)/τ(D2O); 295 K"
          }
        ]
      },
      "source_locations": [
