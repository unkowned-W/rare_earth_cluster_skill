      "compound_label": "1a",
      "compound_name": "[HMo2(CO)10][Sm9(OH)10(acac)16]",
      "formula": "[Sm9(acac)16(OH)10][Mo2(CO)10(μ-H)]",
      "ccdc_numbers": [
        "254789"
      ],
      "ccdc_refcodes": [
        "PECFEJ"
      ],
      "material_class": {
        "material_type": "cluster",
        "nuclearity": 9,
        "metal_composition": "heterometallic",
        "rare_earth_elements": [
          "Sm"
        ],
        "other_metal_elements": [
          "Mo"
        ],
        "dimensionality": "0D",
        "structural_family": "nonanuclear Ln9 hydroxide acetylacetonate cluster with square-antiprismatic Ln8 plus central Ln"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Under pure nitrogen, Ln(acac)3·3H2O (Ln = Sm; 1 mmol) was slowly dissolved in EtOH (30 mL) previously deaerated and N2-saturated by three freeze–pump–thaw cycles. To the stirred solution, gradually warmed to 48 °C (±1 °C), a pale yellow ethanol solution (30 mL) of K[Mo2(CO)10(μ-H)] (1.02 g, 2 mmol) was added dropwise. A white crystalline solid separated; the mixture was stirred at 48 °C for 2 h, cooled to room temperature, and filtered. The product was washed with ethanol and dried under vacuum (yield 75% based on Ln). Recrystallization at room temperature under nitrogen for at least 5 days by slow diffusion of toluene into a chloroform solution (ca. 0.15 mmol in 30 mL; 1:1 v/v CHCl3/toluene) gave crystals (ca. 70% recrystallization yield). Solid samples are air-sensitive and were stored sealed under nitrogen at low temperature.",
        "reagents": [
          {
            "name": "Sm(acac)3·3H2O",
            "formula": "Sm(acac)3·3H2O",
            "role": "lanthanide precursor",
            "amount": "1 mmol"
          },
          {
            "name": "K[Mo2(CO)10(μ-H)]",
            "formula": "K[Mo2(CO)10(μ-H)]",
            "role": "hydridic metal carbonyl source",
            "amount": "1.02 g, 2 mmol"
          }
        ],
        "solvents": [
          "EtOH",
          "CHCl3",
          "toluene"
        ],
        "temperature": "48 °C (±1 °C) for reaction; room temperature for recrystallization",
        "time": "2 h reaction; recrystallization ≥5 days",
        "ph": null,
        "vessel_or_method": "nitrogen-vacuum technique; freeze–pump–thaw deaeration of ethanol; dropwise addition; toluene-into-chloroform diffusion recrystallization",
        "workup_and_crystallization": "filtered, washed several times with ethanol, dried under vacuum; recrystallized by slow diffusion of toluene into CHCl3 solution under nitrogen",
        "yield": "75% based on Ln; recrystallization ca. 70%"
      },
