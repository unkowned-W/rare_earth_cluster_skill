      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "All complexes were prepared by essentially the same solvothermal method; the procedure for 1 is given in detail. A 20 mL Teflon cup containing Gd(NO3)3·6H2O (0.50 mmol), H2bshHtz (0.09 mmol), triethylamine (0.25 mmol), and MeOH (10 mL) was heated at 80 °C for 3 days and then cooled to room temperature, affording brown crystals. Yield 21% based on H2bshHtz.",
        "reagents": [
          {
            "name": "gadolinium(III) nitrate hexahydrate",
            "formula": "Gd(NO3)3·6H2O",
            "role": "metal salt",
            "amount": "0.50 mmol"
          },
          {
            "name": "3,6-bis(salicylaldehydehydrazinyl)-1,2,4,5-tetrazine",
            "formula": "H2bshHtz",
            "role": "ligand",
            "amount": "0.09 mmol"
          },
          {
            "name": "triethylamine",
            "formula": "NEt3",
            "role": "base",
            "amount": "0.25 mmol"
          }
        ],
        "solvents": [
          "MeOH (10 mL)"
        ],
        "temperature": "80 °C",
        "time": "3 days",
        "ph": null,
        "vessel_or_method": "20 mL Teflon cup, solvothermal",
        "workup_and_crystallization": "cooled to room temperature; brown crystals obtained",
        "yield": "21% based on H2bshHtz"
      },
      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "Dc susceptibility from 2–300 K (1 kOe) gives χT = 31.27 cm3 K mol−1 at 300 K, falling to 16.85 cm3 K mol−1 at 2 K. Magnetization saturates at 27.96 Nβ (2 K, 70 kOe). Significant magnetocaloric effect with maximum −ΔSm = 27.27 J kg−1 K−1 at 2.5 K and ΔH = 7 T (theoretical limit 33.89 J kg−1 K−1).",
        "measurements": [
          {
            "property_type": "magnetic",
