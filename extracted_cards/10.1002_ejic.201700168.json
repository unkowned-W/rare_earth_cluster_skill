      "compound_label": "1",
      "compound_name": "[Eu7(μ3-OH)4(deg)2(Hdeg)2(ben)11]·7CH3CN",
      "formula": "C107H114Eu7N7O38",
      "ccdc_numbers": [
        "1526731"
      ],
