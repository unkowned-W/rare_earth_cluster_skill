      "properties": {
        "reported": true,
        "property_type": "optical",
        "summary": "Room-temperature solid-state upconversion under 980 nm Yb(III) excitation gives Er(III) green (524 and 540 nm) and red (660 nm) emission via a two-photon ETU mechanism; 808 nm Er excitation gives no UC. Absolute UCQY is 1.5 × 10−3 % at 13.35 W cm−2. Emission lifetimes are close to 200 μs. No UC emission in methanol solution. CIE color output is power-dependent.",
        "measurements": [
          {
            "property_type": "optical",
            "name": "upconversion emission maxima (Er 2H11/2, 4S3/2, 4F9/2)",
            "value": "524, 540, 660",
            "unit": "nm",
            "conditions": "solid state, room temperature, λexc = 980 nm CW laser"
          },
          {
            "property_type": "optical",
            "name": "absolute upconversion quantum yield",
            "value": "1.5e-3",
            "unit": "%",
            "conditions": "isolated MCA solid, P = 13.35 W cm−2, {Y15} analogue as blank"
          },
          {
            "property_type": "optical",
            "name": "photoluminescence lifetime",
            "value": "~200",
            "unit": "μs",
            "conditions": "980 nm pulsed excitation; decay curves in Figure S10"
