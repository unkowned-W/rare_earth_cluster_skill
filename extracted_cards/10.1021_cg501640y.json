      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "H3L was dissolved in 30 mL of methanol/chloroform (v/v, 1:1). GdCl3·6H2O was added, followed by triethylamine (50 mg, 0.495 mmol), giving a turbid mixture. Mn(ClO4)2·6H2O and pivalic acid were then added, affording a clear brown solution that was stirred for 4 h at room temperature. The mixture was evaporated in vacuum; the brown solid was washed with diethyl ether and dried. Single crystals of 1 were obtained by vapor diffusion of diethyl ether into a methanol/acetonitrile (v/v, 1:1) solution of the compound.",
        "reagents": [
          {
            "name": "H3L (N′-(2-hydroxy-3-methoxybenzylidene)-2-(2-hydroxy-3-methoxybenzylideneamino)benzohydrazide)",
            "formula": "C23H21N3O5",
            "role": "ligand",
            "amount": "60.0 mg, 0.142 mmol"
          },
          {
            "name": "gadolinium(III) chloride hexahydrate",
            "formula": "GdCl3·6H2O",
            "role": "metal source",
            "amount": "105.5 mg, 0.284 mmol"
          },
          {
            "name": "manganese(II) perchlorate hexahydrate",
            "formula": "Mn(ClO4)2·6H2O",
            "role": "metal source",
            "amount": "51.7 mg, 0.142 mmol"
          },
          {
            "name": "pivalic acid",
            "formula": "PivH",
            "role": "ancillary ligand",
            "amount": "29.0 mg, 0.284 mmol"
          },
          {
            "name": "triethylamine",
            "formula": "NEt3",
            "role": "base",
            "amount": "50 mg, 0.495 mmol"
          }
        ],
        "solvents": [
          "methanol",
          "chloroform",
          "acetonitrile",
          "diethyl ether"
        ],
        "temperature": "room temperature",
        "time": "4 h",
        "ph": null,
        "vessel_or_method": "stirring in solution followed by vacuum evaporation; crystallization by vapor diffusion of diethyl ether",
        "workup_and_crystallization": "Evaporated in vacuum; brown solid washed with diethyl ether and dried. Single crystals by vapor diffusion of diethyl ether into methanol/acetonitrile (v/v, 1:1).",
        "yield": "75 mg, 42.5% (based on lanthanide)"
      },
      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "Dominant antiferromagnetic interactions in the Mn2Gd4 cluster. χMT is nearly constant from 300 to ~100 K then falls sharply below ~20 K, indicating very weak exchange. Magnetization at 2 K/5 T is slightly below the isolated-ion limit. No out-of-phase AC susceptibility with or without applied DC field (no SMM behavior).",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "χMT",
            "value": 40.4,
            "unit": "cm3 K mol−1",
            "conditions": "300 K"
          },
          {
            "property_type": "magnetic",
            "name": "χMT (calculated, uncoupled 4 GdIII + 2 MnII)",
            "value": 40.27,
            "unit": "cm3 K mol−1",
            "conditions": "uncoupled-ion estimate"
          },
          {
            "property_type": "magnetic",
            "name": "χMT",
            "value": 21.1,
            "unit": "cm3 K mol−1",
            "conditions": "2 K"
          },
          {
            "property_type": "magnetic",
            "name": "magnetization",
            "value": 36.9,
            "unit": "μB",
            "conditions": "2 K, 5 T"
          },
          {
            "property_type": "magnetic",
            "name": "AC susceptibility χM″",
            "value": "no out-of-phase signal",
            "unit": null,
            "conditions": "with and without applied DC field"
          }
        ]
      },
