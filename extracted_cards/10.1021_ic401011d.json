            "unit": "cm3 K mol−1",
            "conditions": "fit above 100 K"
          },
          {
            "property_type": "magnetic",
            "name": "Weiss constant θ",
            "value": -20.5,
            "unit": "K",
            "conditions": "fit above 100 K"
          },
          {
            "property_type": "magnetic",
