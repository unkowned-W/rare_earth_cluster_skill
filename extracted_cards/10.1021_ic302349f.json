            "name": "gadolinium(III) chloride hexahydrate",
            "formula": "GdCl3·6H2O",
            "role": "metal source",
            "amount": "37 mg, 0.1 mmol"
          },
          {
            "name": "manganese(II) acetate tetrahydrate",
            "formula": "Mn(OAc)2·4H2O",
            "role": "metal source",
            "amount": "49 mg, 0.2 mmol"
          },
          {
            "name": "triethylamine",
            "formula": "NEt3",
            "role": "base",
            "amount": "30 mg, 0.3 mmol"
          }
        ],
        "solvents": [
          "MeCN",
