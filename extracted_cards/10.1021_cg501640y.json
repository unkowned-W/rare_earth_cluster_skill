      "compound_label": "1",
      "compound_name": "[{LMn(Cl)(μ3-OH)Gd2(μ3-OH)(μ-Piv)2}2]·3MeCN·7MeOH·H2O",
      "formula": "[{LMn(Cl)(μ3-OH)Gd2(μ3-OH)(μ-Piv)2}2]·3MeCN·7MeOH·H2O (L = N′-(2-hydroxy-3-methoxybenzylidene)-2-(2-hydroxy-3-methoxybenzylideneamino)benzohydrazide trianion; Piv = pivalate)",
      "ccdc_numbers": [
        "1018346"
      ],
