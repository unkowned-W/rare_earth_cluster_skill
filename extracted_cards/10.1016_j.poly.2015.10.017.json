      "compound_name": "triethylammonium bis(μ4-oxo)octakis(μ3-hydroxo)octakis(μ-ferrocenylacetylacetonato)octakis(ferrocenylacetylacetonato)nonadysprosate",
      "formula": "[Dy9(μ4-O)2(μ3-OH)8(μ-Fca)8(Fca)8][HN(C2H5)3]",
      "ccdc_numbers": [
        "973492"
      ],
      "ccdc_refcodes": [
        "MUVYUZ"
      ],
      "material_class": {
        "material_type": "cluster",
        "nuclearity": 9,
        "metal_composition": "heterometallic",
        "rare_earth_elements": [
          "Dy"
        ],
        "other_metal_elements": [
          "Fe"
        ],
        "dimensionality": "0D",
        "structural_family": "sandglass Ln9 oxo-hydroxo cluster with peripheral ferrocenyl β-diketonates"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Hydrated DyCl3 and HFca were dissolved in 20 mL of methanol; excess triethylamine was added slowly and stirring continued for 12 h at room temperature. The precipitate was filtered and washed with methanol. Crystals of 1 suitable for X-ray diffraction were grown by chloroform/hexane diffusion.",
        "reagents": [
          {
            "name": "dysprosium(III) chloride hexahydrate",
            "formula": "DyCl3·6H2O",
            "role": "metal source",
            "amount": "0.174 g (0.46 mmol)"
          },
          {
            "name": "ferrocenylacetylacetone (HFca)",
            "formula": "HFca",
            "role": "ligand",
            "amount": "0.25 g (0.92 mmol)"
          },
          {
            "name": "triethylamine",
            "formula": "Et3N",
            "role": "base",
            "amount": "0.18 g (1.85 mmol)"
          }
        ],
        "solvents": [
          "methanol",
          "chloroform",
          "hexane"
        ],
        "temperature": "room temperature",
        "time": "12 h",
        "ph": null,
        "vessel_or_method": "stirring in methanol; crystallization by chloroform/hexane diffusion",
        "workup_and_crystallization": "Precipitate filtered and washed with methanol; crystals grown from chloroform/hexane diffusion.",
        "yield": "0.15 g (46%)"
      },
      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "χT at 300 K is 122 cm3 K mol−1 (expected 127 cm3 K mol−1 for nine Dy(III)). χT decreases on cooling to a minimum at 25 K then rises in a field-dependent manner, indicating a ferromagnetically coupled ground state. Magnetization at 2 K saturates at 45 μB and was modeled with a giant-spin S = 45/2 and D = −0.030 cm−1. AC data at 1000 Hz show the tail of an out-of-phase signal, indicating onset of slow relaxation below 2 K.",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "χT",
            "value": 122,
            "unit": "cm3 K mol−1",
            "conditions": "300 K"
          },
          {
            "property_type": "magnetic",
            "name": "χT minimum temperature",
            "value": 25,
            "unit": "K",
            "conditions": "DC susceptibility; rise more accentuated at 197 Oe than 3000 Oe"
          },
          {
            "property_type": "magnetic",
            "name": "magnetization saturation",
            "value": 45,
            "unit": "μB",
            "conditions": "2 K; giant-spin model S = 45/2, D = −0.030 cm−1"
          },
          {
            "property_type": "magnetic",
            "name": "slow magnetic relaxation onset",
            "value": "<2",
            "unit": "K",
            "conditions": "AC susceptibility at 1000 Hz; out-of-phase tail; Argand data at 1.8 and 4.0 K, 1–1500 Hz in SI"
          }
        ]
      },
