            "amount": "0.226 g, 0.5 mmol"
          },
          {
            "name": "sodium isobutyrate",
            "formula": "NaO2CiPr",
            "role": "carboxylate ligand",
            "amount": "0.110 g, 1.00 mmol"
          },
          {
            "name": "2-(hydroxymethyl)pyridine",
            "formula": "Hhmp",
            "role": "bridging ligand L",
            "amount": "0.10 cm3, 1.00 mmol"
          },
          {
            "name": "sodium methoxide",
