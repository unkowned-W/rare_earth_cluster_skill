        ],
        "other_metal_elements": [],
        "dimensionality": "0D",
        "structural_family": "trigonal-pyramidal {Ln4P4} phosphonate cage"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Pivalic acid (0.8 g, 7.83 mmol), Gd(NO3)3·6H2O (0.55 mmol), t-butylphosphonic acid (0.07 g, 0.50 mmol) and pyridine (0.5 mL, 6.15 mmol) were dissolved in i-butanol (15 mL) and refluxed at 120 °C for 3 h. The solution was filtered and left undisturbed at room temperature for nine days, giving colourless plate-like crystals of 1.",
        "reagents": [
          {
            "name": "pivalic acid",
            "formula": "(CH3)3CCO2H",
            "role": "coligand",
            "amount": "0.8 g, 7.83 mmol"
          },
          {
            "name": "gadolinium(III) nitrate hexahydrate",
            "formula": "Gd(NO3)3·6H2O",
            "role": "metal source",
            "amount": "0.55 mmol"
          },
          {
            "name": "tert-butylphosphonic acid",
            "formula": "tBuPO3H2",
            "role": "ligand",
            "amount": "0.07 g, 0.50 mmol"
          },
          {
            "name": "pyridine",
            "formula": "C5H5N",
            "role": "base",
            "amount": "0.5 mL, 6.15 mmol"
          }
        ],
        "solvents": [
          "iso-butanol"
        ],
        "temperature": "reflux at 120 °C; crystallization at room temperature",
        "time": "3 h reflux; 9 days crystallization",
        "ph": null,
        "vessel_or_method": "reflux in i-butanol followed by filtration and standing crystallization",
        "workup_and_crystallization": "filtered; left undisturbed at room temperature for nine days; colourless plate-like crystals",
        "yield": "45%"
      },
      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "DC susceptibility (2–300 K, 0.1 T) and magnetization (2 and 3 K, 0–7 T) show χMT near the four-ion free-ion limit at 300 K and a decline on cooling. Fitting an equilateral Gd3 triangle with a non-interacting apical Gd gives antiferromagnetic J = −0.01 cm−1 and g = 1.99. M saturates at 27.7 μB at 7 T and 2 K. AC susceptibility (1.8–10 K, with and without DC field) shows no out-of-phase signal (not an SMM).",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "χMT vs T",
            "value": "room-temperature χMT equivalent to four non-interacting Gd(III) ions",
            "unit": null,
            "conditions": "2–300 K, 0.1 T (1 kG) DC field"
          },
          {
            "property_type": "magnetic",
            "name": "magnetization M",
            "value": 27.7,
            "unit": "μB",
            "conditions": "2 K, 7 T; saturates as expected for four S = 7/2, g = 1.99 Gd(III)"
          },
          {
            "property_type": "magnetic",
            "name": "isotropic exchange J (Gd···Gd in triangular base)",
            "value": -0.01,
            "unit": "cm^-1",
            "conditions": "simultaneous fit of χMT(T) and M(H) with PHI; g = 1.99; negligible apical Gd exchange"
          },
          {
            "property_type": "magnetic",
            "name": "AC susceptibility / SMM test",
            "value": "no out-of-phase component",
            "unit": null,
            "conditions": "1.8–10 K, with and without applied DC field"
          }
        ]
      },
