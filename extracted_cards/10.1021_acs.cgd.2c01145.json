{
  "title": "The Stepwise Formation of {Gd4} Clusters with Magnetocaloric Effect, Accompanied by In Situ Condensation Cyclization Reactions",
  "doi": "10.1021/acs.cgd.2c01145",
  "list_of_rare_earth_compounds": [
    {
      "compound_label": "1",
      "compound_name": "[Gd4(L1)2(μ3-OH)2(NO3)2(Ac)6]",
      "formula": "C54H58Gd4N18O20",
      "ccdc_numbers": [
        "2210654"
      ],
      "ccdc_refcodes": [
        "SEZGAJ"
      ],
      "material_class": {
        "material_type": "cluster",
        "nuclearity": 4,
        "metal_composition": "homometallic",
        "rare_earth_elements": [
          "Gd"
        ],
        "other_metal_elements": [],
        "dimensionality": "0D",
        "structural_family": "planar tetranuclear {Gd4(μ3-OH)2} cluster"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "A mixture of bptm (0.30 mmol, 0.0912 g), Gd(NO3)3·6H2O (0.30 mmol, 0.1370 g), Gd(Ac)3·4H2O (0.30 mmol, 0.1235 g), and NaN3 (0.60 mmol, 0.0390 g) was added in 15 mL acetone, stirred at room temperature for 20 min, sealed in a 25 mL Teflon-lined stainless steel vessel, heated at 140 °C for 3 days, and cooled slowly to room temperature to give yellow single crystals. Ligand L1 is formed in situ by condensation cyclization of bptm.",
        "reagents": [
          {
            "name": "bis[3-(pyridin-2-yl)-1H-1,2,4-triazole-5-yl]methane (bptm)",
            "formula": null,
            "role": "ligand precursor",
            "amount": "0.30 mmol, 0.0912 g"
          },
          {
            "name": "gadolinium nitrate hexahydrate",
            "formula": "Gd(NO3)3·6H2O",
            "role": "metal source",
            "amount": "0.30 mmol, 0.1370 g"
          },
          {
            "name": "gadolinium acetate tetrahydrate",
            "formula": "Gd(Ac)3·4H2O",
            "role": "metal source",
            "amount": "0.30 mmol, 0.1235 g"
          },
          {
            "name": "sodium azide",
            "formula": "NaN3",
            "role": "reagent",
            "amount": "0.60 mmol, 0.0390 g"
          }
        ],
        "solvents": [
          "acetone"
        ],
        "temperature": "stirred at room temperature, then 140 °C",
        "time": "20 min stirring, then 3 days",
        "ph": null,
        "vessel_or_method": "solvothermal; Teflon-lined stainless steel vessel (25 mL)",
        "workup_and_crystallization": "cooled slowly to room temperature; yellow single crystals suitable for X-ray diffraction",
        "yield": "58% based on Gd(III)"
      },
      "properties": {
