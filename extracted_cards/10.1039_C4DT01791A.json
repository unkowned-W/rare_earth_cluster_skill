      "compound_name": "[(CoII)3(CoIII)2Gd3(μ3-OH)5(O2CtBu)12(L)2]·2H2O",
      "formula": "[(CoII)3(CoIII)2Gd3(μ3-OH)5(O2CtBu)12(L)2]·2H2O",
      "ccdc_numbers": [
        "991802"
      ],
