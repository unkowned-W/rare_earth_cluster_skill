            "formula": "C15H15N3O4",
            "role": "Schiff-base ligand",
            "amount": "0.05 mmol, 0.0151 g"
          },
          {
            "name": "NaOH",
            "formula": "NaOH",
            "role": "base",
            "amount": "0.05 mmol, 0.002 g"
