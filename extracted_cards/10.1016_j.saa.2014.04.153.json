            "name": "UV-Vis absorption maxima",
            "value": "229 (log ε 1.71), 258 (0.95), 344 (0.25)",
            "unit": "nm",
            "conditions": "1×10−5 M MeCN, room temperature"
          },
          {
            "property_type": "optical",
            "name": "excitation wavelength",
            "value": "296 (sh), 350",
            "unit": "nm",
            "conditions": "MeCN, 1×10−5 M"
          },
          {
