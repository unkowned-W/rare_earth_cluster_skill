      "compound_label": "1Y",
      "compound_name": "[Ni2Y2(L1)4Cl2(CH3CN)2]",
      "formula": "Ni2Y2(C14H11NO3)4Cl2(CH3CN)2",
      "ccdc_numbers": [],
      "ccdc_refcodes": [],
      "material_class": {
        "material_type": "cluster",
        "nuclearity": 4,
        "metal_composition": "heterometallic",
        "rare_earth_elements": [
