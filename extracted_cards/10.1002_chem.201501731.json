      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Under air, a solution of diethylenetriamine (0.1290 g, 0.135 mL, 1.25 mmol) in CH3CN (20 mL) was added dropwise over 15 min to a stirred solution of Ce(NO3)3·6H2O (0.1119 g, 0.25 mmol) and pivalic acid (0.0781 g, 0.75 mmol) in CH3CN (20 mL). A white cloudy suspension formed during addition and disappeared upon complete addition. The mixture was heated under reflux for 1 h and then allowed to cool to room temperature undisturbed. Yellow block-shaped crystals appeared over a period of days.",
        "reagents": [
          {
            "name": "cerium(III) nitrate hexahydrate",
            "formula": "Ce(NO3)3·6H2O",
            "role": "metal precursor",
            "amount": "0.1119 g, 0.25 mmol"
          },
          {
            "name": "pivalic acid",
            "formula": "tBuCO2H",
            "role": "carboxylate ligand",
            "amount": "0.0781 g, 0.75 mmol"
