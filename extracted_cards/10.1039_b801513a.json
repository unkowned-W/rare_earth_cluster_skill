      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Triethylamine (4 mL of 0.1 M MeCN solution) was added to a solution of H2L (0.106 g, 0.20 mmol) and Eu(NO3)3·6H2O (0.107 g, 0.25 mmol) in 30 mL of MeOH. The mixture was stirred and refluxed for 30 min (color change red to yellow), cooled to room temperature, and filtered. Diethyl ether was allowed to diffuse slowly into the filtrate at room temperature, giving yellow single crystals of 1 in one week.",
        "reagents": [
          {
            "name": "H2L (N,N′-bis(5-bromo-3-methoxysalicylidene)phenylene-1,2-diamine)",
            "formula": "C22H18Br2N2O4",
            "role": "Schiff-base ligand",
            "amount": "0.106 g, 0.20 mmol"
          },
          {
            "name": "europium(III) nitrate hexahydrate",
            "formula": "Eu(NO3)3·6H2O",
            "role": "metal salt",
            "amount": "0.107 g, 0.25 mmol"
          },
          {
            "name": "triethylamine",
            "formula": "Et3N",
            "role": "base",
            "amount": "4 mL of 0.1 M MeCN solution"
          }
        ],
        "solvents": [
          "MeOH",
          "MeCN",
          "diethyl ether"
        ],
        "temperature": "reflux, then room temperature",
        "time": "reflux 30 min; crystals in one week",
        "ph": null,
        "vessel_or_method": "stirred reflux then diethyl-ether vapor diffusion",
        "workup_and_crystallization": "cooled to room temperature, filtered; Et2O slow diffusion into the MeOH solution gave yellow single crystals",
        "yield": "0.085 g (50%)"
      },
      "properties": {
        "reported": true,
        "property_type": "optical",
        "summary": "In MeCN, ligand-centered excitation of 1 produces typical Eu(III) 5D0→7Fj (j = 1–4) visible emission with no residual ligand 1π–π* emission; ligand-to-metal energy transfer is efficient. Fluorescence quantum yield φem = 0.084 in MeCN.",
        "measurements": [
          {
            "property_type": "optical",
            "name": "fluorescence quantum yield (φem)",
            "value": 0.084,
            "unit": null,
            "conditions": "CH3CN; relative to [Ru(bipy)3]Cl2 in water (φem = 0.028)"
          },
          {
            "property_type": "optical",
            "name": "Eu(III) emission",
            "value": "5D0 → 7Fj (j = 1, 2, 3, 4)",
            "unit": null,
            "conditions": "CH3CN, 1 × 10^-6 M, room temperature; ligand-centered excitation"
          }
        ]
