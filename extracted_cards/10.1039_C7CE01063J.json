      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "A mixture of Gd(NO3)3·6H2O (45.6 mg, 0.1 mmol), H5L (20.9 mg, 0.1 mmol), benzoic acid (12.2 mg, 0.1 mmol) and tetraethylammonium hydroxide (0.2 mL, 0.3 mmol) was dissolved in 10 mL of CH3CN/CH3OH (4:1, v/v). Then 0.1 mL toluene was added. The mixture was heated at 120 °C under autogenous pressure for 12 h in 25 mL Parr Teflon-lined stainless steel vessels, then cooled to room temperature. The resulting solution was left undisturbed, giving square-like crystals that were collected, washed with mother liquor, and dried under ambient conditions.",
