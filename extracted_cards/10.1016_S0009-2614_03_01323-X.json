            "name": "saturation magnetization",
            "value": "1.44e4",
            "unit": "erg Oe−1 mol−1",
            "conditions": "1.8 K, 7 T; 94% of 1.53e4 calculated for S = 27/2, g = 2.03"
          },
          {
            "property_type": "magnetic",
            "name": "ESR g-value",
            "value": 2.03,
            "unit": null,
            "conditions": "X-band 9.7 GHz, polycrystalline sample, room temperature; peak-to-peak linewidth 1400 G"
