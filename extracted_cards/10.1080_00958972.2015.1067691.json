      },
      "properties": {
        "reported": true,
        "property_type": "both",
        "summary": "Solid-state emission at room temperature (λex = 390 nm) is much weaker than that of free H2L, with λem,max = 524 nm (nearly quenched ligand π–π* emission). DC susceptibility (2–300 K, 1000 Oe): χMT(300 K) = 54.55 cm3 K mol−1, rises to 70.59 cm3 K mol−1 at 15 K then falls to 51.01 cm3 K mol−1 at 2 K, consistent with weak ferromagnetism (C = 54.27 cm3 K mol−1, θ = 5.1 K). AC susceptibility under zero dc field (10–1500 Hz) shows strong out-of-phase signals, indicating slow magnetic relaxation and SMM behavior.",
        "measurements": [
          {
            "property_type": "optical",
            "name": "emission maximum",
            "value": 524,
            "unit": "nm",
            "conditions": "solid state, room temperature, λex = 390 nm"
          },
          {
            "property_type": "magnetic",
            "name": "χMT",
            "value": 54.55,
            "unit": "cm3 K mol−1",
            "conditions": "room temperature, 1000 Oe"
          },
