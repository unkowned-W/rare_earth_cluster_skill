      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Under Ar or CO2 atmosphere with Schlenk techniques, DyCl3(DME)2 (0.90 g, 2.0 mmol) was dissolved in toluene (30 mL) and diisopropylamine (3.0 mL, 21.3 mmol) was added. Upon vigorous stirring, CO2 was bubbled through for 15 min at room temperature. Stirring was continued for 3 days under a CO2 atmosphere at room temperature. The mixture was filtered and the clear colourless solution was kept at 5 °C for crystallisation. After one week, colourless block-shaped crystals of 1 suitable for X-ray diffraction were obtained; yield after two weeks 195.7 mg (16.8%).",
        "reagents": [
          {
            "name": "DyCl3(DME)2",
            "formula": "DyCl3(DME)2",
            "role": "metal precursor",
            "amount": "0.90 g, 2.0 mmol"
          },
          {
            "name": "diisopropylamine",
            "formula": "iPr2NH",
            "role": "amine / carbamate source",
            "amount": "3.0 mL, 21.3 mmol"
          },
          {
            "name": "carbon dioxide",
            "formula": "CO2",
            "role": "carbamate-forming feedstock",
            "amount": "bubbled 15 min"
          }
        ],
        "solvents": [
          "toluene"
        ],
        "temperature": "room temperature; crystallisation at 5 °C",
        "time": "CO2 bubbling 15 min; stirring 3 days; crystallisation 1–2 weeks",
        "ph": null,
        "vessel_or_method": "Schlenk techniques under Ar or CO2 atmosphere",
        "workup_and_crystallization": "filtered; colourless solution crystallised at 5 °C to colourless block-shaped crystals",
        "yield": "195.7 mg (16.8%)"
      },
      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "χMT at 300 K is 53.25 cm3 K mol−1 (about 10% below 56.7 cm3 K mol−1 for four free Dy(III) ions), then drops below 100 K. Magnetisation approaches but does not saturate at 7 T. No out-of-phase AC signal at 2 K with or without DC field, so 1 is not an SMM; antiferromagnetic Dy–Dy interactions and tilted easy axes are implicated.",
        "measurements": [
          {
