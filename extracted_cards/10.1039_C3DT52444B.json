            "name": "N′-(amino-(pyrimidin-2-yl)methylene)-o-vanilloyl hydrazine",
            "formula": "H2L",
            "role": "ligand",
            "amount": "0.2 mmol, 0.0575 g (as for 1)"
          },
          {
            "name": "sodium hydroxide",
            "formula": "NaOH",
            "role": "base",
            "amount": "0.4 mmol, 0.016 g (as for 1)"
          }
