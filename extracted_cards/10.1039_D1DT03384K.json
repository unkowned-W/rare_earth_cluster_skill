      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Under argon using Schlenk/glovebox techniques, H2L (0.16 g, 0.50 mmol) was added to a stirred suspension of [(Me3Si)2N]3Y(μ-Cl)Li(THF)3 (0.41 g, 0.50 mmol) in 15 mL of toluene. The mixture was stirred at 110 °C for 12 h, forming a yellow solution. After standing at 110 °C, a yellow supernatant and gray insoluble material formed. The supernatant was collected by filtration, and colorless crystals suitable for single-crystal X-ray diffraction were obtained by keeping the solution at room temperature for several days.",
        "reagents": [
          {
            "name": "[(Me3Si)2N]3Y(μ-Cl)Li(THF)3",
            "formula": "[(Me3Si)2N]3Y(μ-Cl)Li(THF)3",
            "role": "rare-earth amido chloride starting material",
            "amount": "0.41 g, 0.50 mmol"
          },
          {
            "name": "2-amidate-functionalized indolyl proligand H2L (2-(2,6-iPr2C6H3NHC=O)C8H5NH)",
            "formula": "H2L",
            "role": "proligand",
            "amount": "0.16 g, 0.50 mmol"
          }
        ],
        "solvents": [
          "toluene"
        ],
        "temperature": "110 °C (reaction); room temperature (crystallization)",
        "time": "12 h stirring; crystals after several days",
        "ph": null,
        "vessel_or_method": "Schlenk line and glovebox under argon; filtration of supernatant",
        "workup_and_crystallization": "Stand at 110 °C to give a yellow supernatant and gray insoluble material; filter the supernatant; colorless crystals grow at room temperature over several days.",
        "yield": "0.26 g, 80%"
      },
