            "value": 38.1,
            "unit": "cm3 K mol−1",
            "conditions": "300 K, 1000 Oe; mixture of 1 and 3"
          },
          {
            "property_type": "magnetic",
            "name": "χMT",
            "value": 29.18,
            "unit": "cm3 K mol−1",
            "conditions": "19 K; mixture of 1 and 3"
          },
          {
            "property_type": "magnetic",
            "name": "χMT",
            "value": 16.86,
            "unit": "cm3 K mol−1",
            "conditions": "1.8 K; mixture of 1 and 3"
          },
          {
