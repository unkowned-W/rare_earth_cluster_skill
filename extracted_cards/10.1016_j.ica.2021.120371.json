      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Clusters 1–3 were prepared analogously by changing only the lanthanide salt. H2L (0.0528 g, 0.1 mmol) and triethylamine (100 μL) were dissolved in 9 mL dichloromethane/methanol (2:1 v/v) and stirred at room temperature for 10 min. Solid Cd(OAc)2·2H2O (0.0267 g, 0.1 mmol) and Sm(NO3)3·6H2O (44.5 mg, 0.1 mmol) were added and the mixture was stirred for 1 h. Nicotinic acid (HNA, 0.0123 g, 0.1 mmol) was then added and stirring continued for 4 h, after which the mixture was filtered. Yellow block crystals of 1 suitable for X-ray diffraction were obtained by slow diffusion of n-hexane into the filtrate for three days at ambient temperature. Yield 40.9%.",
        "reagents": [
          {
            "name": "bis(5-bromine-3-methoxysalicylidene)-3-oxapentane-1,5-diamine (H2L)",
            "formula": "C19H20Br2N2O5",
            "role": "Schiff-base ligand",
            "amount": "0.0528 g, 0.1 mmol"
          },
          {
            "name": "triethylamine",
            "formula": "C6H15N",
            "role": "base",
            "amount": "100 μL"
          },
          {
            "name": "cadmium acetate dihydrate",
            "formula": "Cd(CH3COO)2·2H2O",
            "role": "Cd source",
            "amount": "0.0267 g, 0.1 mmol"
          },
          {
            "name": "samarium(III) nitrate hexahydrate",
            "formula": "Sm(NO3)3·6H2O",
            "role": "Ln source",
            "amount": "44.5 mg, 0.1 mmol"
          },
          {
            "name": "nicotinic acid (HNA)",
            "formula": "C6H5NO2",
            "role": "bridging/ancillary ligand",
            "amount": "0.0123 g, 0.1 mmol"
          },
          {
            "name": "n-hexane",
            "formula": "C6H14",
            "role": "antisolvent for crystallization",
            "amount": null
          }
        ],
        "solvents": [
          "dichloromethane",
          "methanol",
          "n-hexane"
        ],
        "temperature": "room/ambient temperature",
        "time": "10 min ligand/base mixing, then 1 h after metal salts, then 4 h after HNA; crystallization 3 days",
        "ph": null,
        "vessel_or_method": "solution mixing and filtration, then n-hexane vapor/diffusion crystallization",
        "workup_and_crystallization": "filtered after stirring; crystals grown by slowly diffusing n-hexane into the clarified filtrate for three days at ambient temperature",
        "yield": "40.9%"
      },
      "properties": {
        "reported": true,
        "property_type": "optical",
        "summary": "Solid-state luminescence of 1 at room temperature shows ligand-centered π*→π emission at 470 nm (λex = 370 nm) plus characteristic Sm3+ bands at 562, 598 and 645 nm (4G5/2 → 6H5/2, 6H7/2, 6H9/2). The 598 nm magnetic-dipole transition is strongest, with Φ = 0.29% and τ = 8.55 μs, indicating L2− sensitizes Sm3+ red emission. In DMF only ligand-centered emission remains (λex 358 nm, λem 405 nm), attributed to DMF blocking energy transfer to Ln3+. UV/Vis in DMF: λmax = 363 nm.",
        "measurements": [
          {
            "property_type": "optical",
            "name": "solid-state excitation wavelength",
            "value": 370,
            "unit": "nm",
            "conditions": "solid state, room temperature"
          },
          {
            "property_type": "optical",
            "name": "solid-state emission (π*→π)",
            "value": 470,
            "unit": "nm",
            "conditions": "solid state, room temperature, λex = 370 nm; Stokes shift 100 nm"
          },
          {
            "property_type": "optical",
            "name": "Sm3+ emission 4G5/2 → 6H5/2",
            "value": 562,
            "unit": "nm",
            "conditions": "solid state, room temperature"
          },
          {
            "property_type": "optical",
            "name": "Sm3+ emission 4G5/2 → 6H7/2",
            "value": 598,
            "unit": "nm",
            "conditions": "solid state, room temperature; magnetic dipole transition"
          },
          {
            "property_type": "optical",
            "name": "Sm3+ emission 4G5/2 → 6H9/2",
            "value": 645,
            "unit": "nm",
            "conditions": "solid state, room temperature; electric dipole transition"
          },
          {
            "property_type": "optical",
            "name": "photoluminescence quantum yield",
            "value": 0.29,
            "unit": "%",
            "conditions": "associated with 4G5/2 → 6H7/2; absolute QY, relative error ±10%"
          },
          {
            "property_type": "optical",
            "name": "emission lifetime",
            "value": 8.55,
            "unit": "μs",
            "conditions": "associated with 4G5/2 → 6H7/2"
          },
          {
