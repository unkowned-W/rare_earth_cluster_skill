    {
      "compound_label": "1",
      "compound_name": "[La2(Omes)6(thf)4]·2THF",
      "formula": "C78H114La2O12",
      "ccdc_numbers": [],
      "ccdc_refcodes": [],
      "material_class": {
        "material_type": "cluster",
        "nuclearity": 2,
        "metal_composition": "homometallic",
        "rare_earth_elements": [
          "La"
        ],
        "other_metal_elements": [],
        "dimensionality": "0D",
        "structural_family": "2,4,6-trimethylphenolate (Omes) aryloxide"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "General THF redox transmetallation/ligand-exchange: a Schlenk flask was charged with HOmes (0.54 g, 4.0 mmol) and Hg(C6F5)2 (1.07 g, 2.0 mmol); La metal filings (3.0 mmol) and THF (50 mL) were added. The mixture was stirred at ambient temperature for 5 days under purified nitrogen. Precipitated mercury and unreacted metal were filtered off; the solution was concentrated in vacuo to ~10 mL and cooled to −10 °C, yielding colourless blocks after several days, which were isolated and dried under vacuum. An alternative sealed-tube route (La 0.69 g, 5.0 mmol; HOmes 0.35 g, 2.6 mmol; Hg 2 drops; 220 °C, vacuum, 5 days) gave toluene-insoluble “La(Omes)3”, which after THF extraction (50 mL), concentration to 20 mL, and storage at −10 °C also afforded 1 (0.41 g, 62%).",
        "reagents": [
          {
            "name": "2,4,6-trimethylphenol (HOmes)",
            "formula": "C9H12O",
            "role": "ligand precursor",
            "amount": "0.54 g, 4.0 mmol"
          },
          {
            "name": "bis(pentafluorophenyl)mercury",
            "formula": "Hg(C6F5)2",
            "role": "oxidant/transmetallation reagent",
            "amount": "1.07 g, 2.0 mmol"
          },
          {
            "name": "lanthanum metal filings",
            "formula": "La",
            "role": "metal source",
            "amount": "3.0 mmol"
          }
        ],
        "solvents": [
          "THF"
        ],
        "temperature": "ambient temperature (crystallization at −10 °C)",
        "time": "5 days stirring; crystals after several days",
        "ph": null,
        "vessel_or_method": "Schlenk flask under purified nitrogen (standard Schlenk/dry-box)",
        "workup_and_crystallization": "filter off Hg and unreacted La; concentrate THF solution to ~10 mL; cool to −10 °C; isolate crystals and dry under vacuum",
        "yield": "0.59 g (58%)"
      },
