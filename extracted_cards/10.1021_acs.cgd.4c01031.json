      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "A mixture of Gd(NO3)3·6H2O (1 mmol, 0.451 g), N-methyldiethanolamine (2 mmol, 0.119 g), triethylamine (2 mmol, 0.202 g), and 10 mL ethanol was placed in a 20 mL polytetrafluoroethylene reactor and reacted at 100 °C for 2 days. The solution was gradually cooled to ambient temperature, then filtered and rinsed with a small amount of ethanol to give bulk crystals.",
        "reagents": [
          {
            "name": "gadolinium(III) nitrate hexahydrate",
            "formula": "Gd(NO3)3·6H2O",
            "role": "metal source",
            "amount": "1 mmol, 0.451 g"
          },
          {
