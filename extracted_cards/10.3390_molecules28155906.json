        "vessel_or_method": "solvothermal reaction in 18 cm Pyrex tube sealed under vacuum",
        "workup_and_crystallization": "slowly cooled to room temperature, giving red crystals",
        "yield": "31% (based on Dy)"
      },
      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "χmT at 300 K is 109.52 cm3 K mol−1 (calc. 110.44). χmT decreases to 61.00 cm3 K mol−1 at 2 K. M vs H/T curves at 2–5 K do not overlay, indicating magnetic anisotropy and possible low-lying excited states. Hysteresis at 2 K is essentially closed. Under zero dc field, χ″ is nearly zero and χ′ shows little frequency dependence; no χ″ peaks, consistent with QTM and no clear slow-relaxation maxima.",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "χmT",
            "value": 109.52,
            "unit": "cm3 K mol−1",
            "conditions": "300 K, 1000 Oe dc field"
          },
          {
            "property_type": "magnetic",
            "name": "χmT",
            "value": 61.0,
            "unit": "cm3 K mol−1",
            "conditions": "2 K, 1000 Oe dc field"
          },
          {
            "property_type": "magnetic",
            "name": "isothermal magnetization",
            "value": "fast then slow increase; M vs H/T non-superimposable at high H/T",
            "unit": null,
            "conditions": "2, 3, 5 K"
          },
          {
            "property_type": "magnetic",
            "name": "magnetic hysteresis",
            "value": "imperceptible/negligible loop",
            "unit": null,
            "conditions": "2 K, scan rate 200 Oe/s"
          },
          {
            "property_type": "magnetic",
            "name": "ac susceptibility",
            "value": "nearly zero χ″; χ′ temperature-dependent but no clear frequency dependence or χ″ peaks",
            "unit": null,
            "conditions": "zero dc field"
          }
        ]
      },
