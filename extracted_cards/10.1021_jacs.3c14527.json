            "conditions": "300 K; calculated 16.14 cm3 K mol−1 for eight Eu3+ (1.7) plus one Yb3+ (2.57)"
          },
          {
            "property_type": "magnetic",
            "name": "χmT",
            "value": "very low; attributed solely to Yb3+",
            "unit": null,
            "conditions": "2 K (Eu3+ contributes negligibly)"
          },
          {
            "property_type": "magnetic",
            "name": "ac out-of-phase signal / SMM",
