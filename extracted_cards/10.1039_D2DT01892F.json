      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Ln(acac)3·2H2O (0.03 mmol, Ln = Gd for 1) and Schiff-base ligand HL (0.03 mmol) were added to methanol (3 mL), ethanol (6 mL) and dichloromethane (2 mL) and dissolved by sonication. The mixed solution was placed in a sealed 20 mL vial, heated to 70 °C for 48 h under autogenous pressure, then cooled to room temperature at 10 °C h−1. Yellow blocky crystals of 1 were obtained.",
        "reagents": [
          {
            "name": "Gd(acac)3·2H2O",
            "formula": "Gd(acac)3·2H2O",
            "role": "metal precursor",
            "amount": "0.03 mmol"
          },
          {
            "name": "pyridine-2-carboxylic acid (5-hydroxymethyl-furan-2-ylmethylene)-hydrazide (HL)",
            "formula": "C12H11N3O3",
            "role": "ligand",
            "amount": "0.03 mmol"
          }
        ],
        "solvents": [
          "methanol (3 mL)",
          "ethanol (6 mL)",
          "dichloromethane (2 mL)"
        ],
        "temperature": "70 °C (solvothermal), then cooled at 10 °C h−1",
        "time": "48 h",
        "ph": null,
        "vessel_or_method": "solvothermal synthesis in a sealed 20 mL vial under autogenous pressure; sonication to dissolve",
        "workup_and_crystallization": "yellow blocky crystals obtained on cooling to room temperature",
        "yield": "37% (based on Gd(acac)3·2H2O)"
      },
      "properties": {
        "reported": true,
        "property_type": "both",
        "summary": "Cluster 1 shows antiferromagnetic interactions among Gd(III) ions and a large magnetocaloric effect, with a maximum −ΔSm of 46.14 J kg−1 K−1 at 2.0 K and ΔH = 7.0 T. UV–vis spectra in methanol display ligand/Hacac-derived absorptions near 202, 300 and 342 nm, red-shifted relative to free HL and Hacac.",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "χMT (300 K)",
            "value": 62.89,
            "unit": "cm3 mol−1 K",
            "conditions": "1.0 kOe dc field; 300–2.0 K"
          },
          {
            "property_type": "magnetic",
            "name": "magnetization M",
            "value": 56.09,
            "unit": "Nβ",
            "conditions": "T = 2.0 K, H = 7.0 T; saturation vs 56 Nβ calculated for eight free Gd(III)"
          },
          {
            "property_type": "magnetic",
            "name": "magnetic entropy change −ΔSm",
            "value": 46.14,
            "unit": "J kg−1 K−1",
            "conditions": "T = 2.0 K, ΔH = 7.0 T; Maxwell relation from M(T,H); calculated limit 49.16 J kg−1 K−1"
          },
          {
            "property_type": "optical",
            "name": "UV–vis absorption maxima",
            "value": "ca. 202, 300 and 342 nm",
            "unit": null,
            "conditions": "methanol solution, room temperature"
          }
        ]
