      "compound_label": "1",
      "compound_name": "[Y9(μ4-OH)2(μ3-OH)8(sal-R)16]Cl (R = Me (0.70), Et (0.30))",
      "formula": "[Y9(μ4-OH)2(μ3-OH)8(sal-R)16]Cl",
      "ccdc_numbers": [],
      "ccdc_refcodes": [],
      "material_class": {
        "material_type": "cluster",
        "nuclearity": 9,
        "metal_composition": "homometallic",
        "rare_earth_elements": [
          "Y"
        ],
        "other_metal_elements": [],
        "dimensionality": "0D",
        "structural_family": "sandglass-like nonanuclear hydroxo cluster"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Under nitrogen in a 150 mL Schlenk flask, methyl salicylate (0.65 mL; 5.0 mmol), THF (15 mL), and metallic lithium (0.0312 g; 4.5 mmol) were stirred at room temperature for 2 h until lithium had fully reacted. YCl3 (0.2937 g; 1.50 mmol) and 20–30 mL of methanol were added to the light yellow solution, and the mixture was stirred for an additional 72 h. Because of limited solubility, 10–20 mL of EtOH was added, causing partial transesterification of sal-Me (compound 1 contains ca. 9% sal-Et by 1H NMR). After several days of crystallization at ambient conditions, colorless crystals were collected by filtration, washed with hexane (3 × 10 mL), and dried under vacuum.",
        "reagents": [
          {
            "name": "methyl salicylate",
            "formula": "C8H8O3",
            "role": "ligand precursor",
            "amount": "0.65 mL; 5.0 mmol"
          },
          {
            "name": "metallic lithium",
            "formula": "Li",
            "role": "base / metalating agent",
            "amount": "0.0312 g; 4.5 mmol"
          },
          {
            "name": "yttrium(III) chloride",
            "formula": "YCl3",
            "role": "metal source",
            "amount": "0.2937 g; 1.50 mmol"
          }
        ],
        "solvents": [
          "THF (15 mL)",
          "methanol (20–30 mL)",
          "ethanol (10–20 mL)",
          "hexane (wash)"
        ],
        "temperature": "room temperature",
        "time": "2 h (lithium reaction) then 72 h; crystallization several days",
        "ph": null,
        "vessel_or_method": "150 mL Schlenk flask under nitrogen",
        "workup_and_crystallization": "Crystallization at ambient conditions; filtration; hexane wash (3 × 10 mL); vacuum drying.",
        "yield": "0.26 g (46%)"
      },
