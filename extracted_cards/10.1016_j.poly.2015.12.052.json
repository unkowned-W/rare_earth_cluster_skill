      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Aqueous Eu(NO3)3·5H2O (0.4280 g, 1 mmol, 10 mL water) was added to aqueous NaL (0.7535 g, 3 mmol). A white precipitate of mixed CAPh-based hydrated tris-complex and hydroxo species formed immediately, was isolated, washed with water to remove NaNO3, and dried over CaCl2. The dried solid was dissolved in CH2Cl2:2-propanol (1:3). Crystals of the hydroxo complex appeared in one day, were filtered, washed with 2-propanol, and dried. Hydroxide ions form in situ by hydrolysis of L−; metal:ligand ratios 1:1–1:4 did not change the product.",
        "reagents": [
          {
            "name": "europium(III) nitrate pentahydrate",
            "formula": "Eu(NO3)3·5H2O",
            "role": "metal source",
            "amount": "0.4280 g, 1 mmol"
          },
