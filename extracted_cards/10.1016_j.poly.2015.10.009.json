        "dimensionality": "0D",
        "structural_family": "carbonato–carbamato lanthanide cluster"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "A solution of dibutylamine (10.0 mL, 66 mmol) in heptane (50 mL) was saturated with CO2 and cooled to 0 °C. Aqueous lanthanum chloride (20 mL, 0.33 M, 6.6 mmol) was cooled to 0 °C. The solutions were mixed and shaken for a few seconds at 0 °C. The aqueous layer was removed; the organic layer was evaporated at 1.0×10−3 Torr. The colorless oil was redissolved in a few mL of heptane and evaporated three times. The colorless solid was dried in vacuo at 35 °C.",
        "reagents": [
          {
            "name": "dibutylamine",
            "formula": "NHBu2",
            "role": "extractant/ligand precursor",
            "amount": "10.0 mL, 66 mmol"
          },
          {
            "name": "carbon dioxide",
            "formula": "CO2",
            "role": "carbamation reagent",
            "amount": "saturated organic solution"
          },
          {
            "name": "lanthanum chloride aqueous solution",
            "formula": "LaCl3",
            "role": "metal source",
            "amount": "20 mL, 0.33 M, 6.6 mmol"
          }
        ],
        "solvents": [
          "heptane",
          "water"
        ],
        "temperature": "0 °C extraction; dried at 35 °C",
        "time": "few seconds shaking; repeated heptane evaporations",
        "ph": null,
        "vessel_or_method": "liquid–liquid extraction of La3+ into NHBu2/CO2/heptane",
        "workup_and_crystallization": "Phase separation, reduced-pressure evaporation, three heptane redissolve/evaporate cycles, vacuum drying at 35 °C.",
        "yield": "1.95 g, 50.5%"
      },
      "properties": {
