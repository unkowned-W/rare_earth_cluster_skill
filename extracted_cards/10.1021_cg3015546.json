        "workup_and_crystallization": "filtration, concentration, layering with n-hexane; yellow crystals",
        "yield": "78%"
      },
      "properties": {
        "reported": true,
        "property_type": "optical",
        "summary": "Geometric isomer 1 shows dual NIR emission from Yb(III) (~1000 nm) and Er(III) (~1535 nm) in CH2Cl2 and the solid state, sensitized by 8-hydroxyquinolinato; incomplete Yb→Er energy transfer. Fluoride titration (2 equiv [Bu4N]F) roughly doubles Yb emission intensity before excess F− quenches it. No up-conversion was observed under 980 nm laser irradiation (460 mW).",
        "measurements": [
          {
            "property_type": "optical",
            "name": "absorption maxima",
            "value": "234 (190400), 256 (153500), 304 (55900), 371 (13900)",
            "unit": "nm (ε/M−1 cm−1)",
            "conditions": "CH2Cl2"
          },
          {
            "property_type": "optical",
            "name": "emission wavelength and lifetime (Yb)",
            "value": "1000 nm (1.26 ± 0.05 μs)",
            "unit": null,
            "conditions": "CH2Cl2, 298 K, λex = 400 nm"
          },
          {
            "property_type": "optical",
            "name": "emission wavelength and lifetime (Er)",
            "value": "1535 nm (1.13 ± 0.07 μs)",
            "unit": null,
            "conditions": "CH2Cl2, 298 K, λex = 400 nm"
          },
          {
            "property_type": "optical",
            "name": "quantum yield (Yb-based, Φ = τobs/τ0)",
            "value": 0.00063,
            "unit": null,
            "conditions": "estimated with τ0(Yb) = 2 ms"
          },
          {
            "property_type": "optical",
