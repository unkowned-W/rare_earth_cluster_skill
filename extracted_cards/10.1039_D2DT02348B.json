    {
      "compound_label": "1",
      "compound_name": "[DyIII4L4(μ3-OH)2(formate)2(dmf)2]",
      "formula": "C68H70N6O20Dy4",
      "ccdc_numbers": [
        "2176193"
      ],
      "ccdc_refcodes": [
        "NEMFEU"
      ],
      "material_class": {
        "material_type": "cluster",
        "nuclearity": 4,
        "metal_composition": "homometallic",
        "rare_earth_elements": [
          "Dy"
        ],
        "other_metal_elements": [],
        "dimensionality": "0D",
        "structural_family": "defect dicubane / planar butterfly Dy4"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "A methanol solution (5 mL) of DyCl3·xH2O (0.054 g, 0.2 mmol) was added dropwise to a stirred suspension of H2L (0.052 g, 0.2 mmol) in methanol (10 mL). After stirring for 30 min, a methanol solution of sodium formate (0.041 g, 0.6 mmol) was added. An orange precipitate formed and was dissolved by adding the requisite amount of dmf. The orange solution was refluxed for 30 min, cooled, filtered, and the filtrate was left at room temperature for slow evaporation. After a few days, orange diffraction-quality crystals were collected by filtration and washed with cold methanol.",
        "reagents": [
          {
            "name": "dysprosium(III) chloride hydrate",
            "formula": "DyCl3·xH2O",
            "role": "metal salt",
            "amount": "0.054 g, 0.2 mmol"
          },
          {
            "name": "2-(2-hydroxy-3-ethoxybenzylideneamino)phenol",
            "formula": "H2L",
            "role": "ligand",
            "amount": "0.052 g, 0.2 mmol"
          },
          {
            "name": "sodium formate",
            "formula": "HCO2Na",
            "role": "carboxylate source",
            "amount": "0.041 g, 0.6 mmol"
          }
        ],
        "solvents": [
          "methanol",
          "N,N-dimethylformamide"
        ],
        "temperature": "reflux, then room-temperature crystallization",
        "time": "30 min stirring; 30 min reflux; crystallization over a few days",
        "ph": null,
        "vessel_or_method": "solution synthesis with reflux and slow evaporation",
        "workup_and_crystallization": "filtered after cooling; filtrate evaporated at room temperature; crystals collected by filtration and washed with cold methanol",
        "yield": "0.066 g (68%)"
      },
      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "Zero-field SMM with two relaxation channels (slow/fast assigned to SAPR Dyw and TDD Dyb). Weak antiferromagnetic interactions and strong anisotropy. Simulated Ueff = 49.0 cm−1, τ0 = 1.76×10−7 s.",
