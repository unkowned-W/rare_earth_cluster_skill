      "compound_label": "1",
      "compound_name": "tetranuclear homoleptic terbium(III) salen complex Tb4L6 as mixed methanol/water solvate",
      "formula": "Tb4L6·6MeOH·4H2O (L = salen2− = N,N′-ethylenebis(salicylideneiminate))",
      "ccdc_numbers": [
        "680102"
      ],
      "ccdc_refcodes": [
        "UFIXIR"
      ],
      "material_class": {
        "material_type": "cluster",
        "nuclearity": 4,
        "metal_composition": "homometallic",
        "rare_earth_elements": [
          "Tb"
        ],
        "other_metal_elements": [],
        "dimensionality": "0D",
        "structural_family": "homoleptic tetranuclear salen cluster (two Tb2L3 moieties linked by μ-O phenoxides)"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "A solution of Tb(OAc)3·4H2O (0.067 g, 0.20 mmol) in MeOH (10 ml) was added to a solution of H2L (0.081 g, 0.30 mmol) in MeCN (10 ml). The mixture was stirred and heated under reflux for 2 h; the solution color changed from pale yellow to brown. After cooling to room temperature and filtration, diethyl ether was allowed to diffuse slowly into the solution at room temperature, giving dark yellow single crystals in three weeks.",
        "reagents": [
          {
            "name": "terbium(III) acetate tetrahydrate",
            "formula": "Tb(OAc)3·4H2O",
            "role": "metal salt",
            "amount": "0.067 g, 0.20 mmol"
          },
          {
            "name": "H2salen (N,N′-ethylenebis(salicylideneimine))",
            "formula": "H2L",
            "role": "ligand",
            "amount": "0.081 g, 0.30 mmol"
          }
        ],
        "solvents": [
          "MeOH",
          "MeCN",
          "diethyl ether"
        ],
        "temperature": "reflux, then room temperature crystallization",
        "time": "reflux 2 h; crystals in three weeks",
        "ph": null,
        "vessel_or_method": "stirred reflux then diethyl ether vapor diffusion",
        "workup_and_crystallization": "cooled to room temperature, filtered; Et2O diffused into the filtrate at room temperature; dark yellow single crystals in three weeks",
        "yield": "0.050 g (40%)"
      },
      "properties": {
        "reported": true,
        "property_type": "optical",
        "summary": "In MeOH, ligand-centered excitation of 1 (237 nm) gives typical Tb3+ 5D4→7Fn (n = 6–3) emission with no ligand-centered 1π–π* emission. Φem = 0.230, higher than 2 and 3, attributed to complete encapsulation of Tb3+ by Schiff-base ligands without coordinated solvent. Efficient ligand-to-metal energy transfer is indicated by the absence of typical Tb3+ excitation bands.",
        "measurements": [
          {
            "property_type": "optical",
            "name": "excitation wavelength (ligand-centered)",
            "value": 237,
            "unit": "nm",
            "conditions": "MeOH solution of 1"
          },
          {
            "property_type": "optical",
            "name": "fluorescence quantum yield (φem)",
            "value": 0.23,
            "unit": null,
            "conditions": "MeOH; quinine sulfate standard (Φ = 0.546 in 0.5 M H2SO4)"
          }
        ]
      },
