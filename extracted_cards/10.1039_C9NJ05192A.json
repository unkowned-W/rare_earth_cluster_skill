            "name": "[3,6-bis(2-hydroxy-3-methoxybenzylidene)hydrazinecarbonyl]pyridazine",
            "formula": "H4L",
            "role": "ligand",
            "amount": "0.10 mmol"
          },
          {
            "name": "triethylamine",
            "formula": "Et3N",
            "role": "base",
            "amount": "0.40 mmol"
          }
        ],
