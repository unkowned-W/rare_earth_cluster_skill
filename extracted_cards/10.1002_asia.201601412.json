            "name": "magnetization",
            "value": 28.3,
            "unit": "Nβ",
            "conditions": "2.0 K, 70 kOe"
          },
          {
            "property_type": "magnetic",
            "name": "effective energy barrier Ueff",
            "value": "85(1)",
            "unit": "K",
            "conditions": "zero dc field; thermally activated regime above 10 K"
          },
          {
            "property_type": "magnetic",
            "name": "pre-exponential factor τ0",
            "value": "3.9(5)×10−7",
            "unit": "s",
            "conditions": "zero dc field Arrhenius fit"
          },
          {
            "property_type": "magnetic",
            "name": "Cole–Cole α",
            "value": "0.10–0.31",
            "unit": null,
            "conditions": "zero dc field; 2.0–16.0 K; increases to ~0.6 in tunneling regime below 10 K"
          }
        ]
      },
