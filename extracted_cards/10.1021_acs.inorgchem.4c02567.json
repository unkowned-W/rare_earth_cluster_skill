      "compound_label": "1",
      "compound_name": "[Me4N]2[Er4(μ2-η1:η1-PO2R2)8(η2-CO2But)4(μ4-CO3)] (R = CH(OH)PhBr)",
      "formula": "[Me4N]2[Er4(μ2-η1:η1-PO2R2)8(η2-CO2But)4(μ4-CO3)] (R = CH(OH)PhBr); anal. Br16C141Er4H156N2O43P8",
      "ccdc_numbers": [
