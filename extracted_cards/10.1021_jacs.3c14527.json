      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "General preparation of [LnnLn′9−n(BA)16(OH)10]Cl: benzoylacetone (BA) (649 mg, 4 mmol, 4 equiv) and piperidine (396 mL as printed, 4 mmol, 4 equiv) were dissolved in CH3OH (60 mL) and heated with stirring at 75 °C for 1 h. LnCl3·6H2O (x mmol, n/9 equiv) and Ln′Cl3·6H2O (1−x mmol, (9−n)/9 equiv) were dissolved in 20 mL H2O, added dropwise to the alcoholic solution, and stirred at 75 °C for 3 h until a transparent solution formed. Heating was then stopped; the solution was cooled to room temperature, filtered, and left undisturbed. Cubic crystals suitable for X-ray analysis were harvested after 1 week. For Eu8Yb this corresponds to EuCl3·6H2O (8/9 equiv) and YbCl3·6H2O (1/9 equiv).",
        "reagents": [
          {
            "name": "benzoylacetone (BA)",
            "formula": "C10H10O2",
            "role": "ligand",
            "amount": "649 mg, 4 mmol, 4 equiv"
          },
          {
            "name": "piperidine",
            "formula": "C5H11N",
            "role": "base",
            "amount": "396 mL as printed, 4 mmol, 4 equiv"
          },
          {
            "name": "europium(III) chloride hexahydrate",
            "formula": "EuCl3·6H2O",
            "role": "metal source",
            "amount": "n/9 equiv in general procedure (Eu8Yb: 8/9 equiv)"
          },
          {
            "name": "ytterbium(III) chloride hexahydrate",
            "formula": "YbCl3·6H2O",
            "role": "metal source",
            "amount": "(9−n)/9 equiv in general procedure (Eu8Yb: 1/9 equiv)"
          }
        ],
        "solvents": [
          "CH3OH (60 mL)",
          "H2O (20 mL)"
        ],
        "temperature": "75 °C (ligand heating 1 h; after metal addition 3 h), then room temperature crystallization",
        "time": "1 h then 3 h reaction; crystals after 1 week",
        "ph": null,
        "vessel_or_method": "solution synthesis with heating/stirring, filtration, and undisturbed crystallization",
        "workup_and_crystallization": "cooled to room temperature, filtered, left undisturbed; cubic crystals after 1 week",
