      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "General procedure for 1–4: to a methanolic solution (40 mL) of LH2, Ln(NO3)3·nH2O was added under stirring; after ~15 min, Et3N was added dropwise to give a clear light yellow solution, which was stirred for 12 h, then concentrated and filtered. Slow diffusion of diethyl ether into the filtrate afforded colorless single crystals after one week. For 1: Dy(NO3)3·5H2O (0.0649 g, 0.15 mmol), LH2 (0.04 g, 0.15 mmol), Et3N (0.078 mL, 0.6 mmol).",
        "reagents": [
          {
            "name": "dysprosium(III) nitrate pentahydrate",
            "formula": "Dy(NO3)3·5H2O",
            "role": "metal source",
            "amount": "0.0649 g, 0.15 mmol"
          },
          {
            "name": "6-(hydroxymethyl)-N′-[1-(pyridin-2-yl)ethylidene]picolinohydrazide",
            "formula": "LH2 / C14H14N4O2",
            "role": "ligand",
            "amount": "0.04 g, 0.15 mmol"
          },
          {
            "name": "triethylamine",
            "formula": "Et3N",
            "role": "base",
            "amount": "0.078 mL, 0.6 mmol"
          }
        ],
        "solvents": [
          "methanol",
          "diethyl ether"
        ],
        "temperature": null,
        "time": "stir 12 h; crystallization 1 week",
        "ph": null,
        "vessel_or_method": "solution reaction in methanol followed by diethyl ether vapor diffusion",
        "workup_and_crystallization": "concentrate, filter; slow diffusion of diethyl ether into the filtrate gave colorless single crystals after one week",
        "yield": "0.055 g, 68.75% (based on Dy)"
      },
      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "χMT = 55.0 cm3 K mol−1 at 290 K (0.1 T), in or slightly below the range for four non-interacting DyIII ions; χMT decreases on cooling. Fitted weak antiferromagnetic exchange (J1 = −0.14, J2 = −0.03, J3 = −0.01 cm−1). AC susceptibility down to 2 K at zero and small DC field showed no out-of-phase SMM signals.",
        "measurements": [
