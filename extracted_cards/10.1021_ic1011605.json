      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "The same aerobic procedure used for 2 was applied to all analogues: a MeCN solution of N-methyldiethanolamine was added dropwise over 20 min to a stirred MeCN solution of the corresponding Ln(NO3)3·6H2O and pivalic acid; the mixture was stirred at room temperature for 2 h, filtered, and left undisturbed in a sealed vial to give crystals after 3 days. Crystals were collected by filtration, washed with MeCN, and dried in vacuum.",
        "reagents": [
          {
            "name": "N-methyldiethanolamine",
            "formula": "C5H13NO2",
            "role": "ligand",
            "amount": "0.089 g, 0.75 mmol (procedure given for 2)"
          },
          {
            "name": "terbium(III) nitrate hexahydrate",
            "formula": "Tb(NO3)3·6H2O",
            "role": "metal source",
            "amount": "corresponding Ln salt in place of Dy(NO3)3·6H2O (0.114 g, 0.25 mmol in the detailed Dy procedure)"
          },
          {
            "name": "pivalic acid",
            "formula": "C5H10O2",
            "role": "ligand",
            "amount": "0.101 g, 1.00 mmol (procedure given for 2)"
          }
        ],
        "solvents": [
          "MeCN"
        ],
        "temperature": "room temperature",
        "time": "dropwise addition 20 min, then stirred 2 h; crystals after 3 days",
        "ph": null,
        "vessel_or_method": "aerobic stirring then sealed vial crystallization",
        "workup_and_crystallization": "filtered and left undisturbed in a sealed vial; crystals maintained in mother liquor or collected, washed with MeCN, and dried in vacuum",
        "yield": "45%"
      },
      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "Dc susceptibility of the Tb4 cluster is essentially temperature-independent from 300–60 K then falls rapidly to 1.8 K; χT at RT matches four weakly coupled/uncoupled TbIII ions. Magnetization at 7 T is unsaturated, consistent with anisotropy and/or low-lying excited states. No slow magnetization relaxation under zero dc field.",
        "measurements": [
