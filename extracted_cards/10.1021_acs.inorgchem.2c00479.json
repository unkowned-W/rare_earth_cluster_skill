          "THF"
        ],
        "temperature": "room temperature addition; crystallization at −40 °C",
        "time": "2 days crystallization",
        "ph": null,
        "vessel_or_method": "argon glovebox/Schlenk; protonolysis",
        "workup_and_crystallization": "concentrate to 1 mL; store at −40 °C to give orange crystals",
        "yield": "78% (89.3 mg, 0.043 mmol)"
