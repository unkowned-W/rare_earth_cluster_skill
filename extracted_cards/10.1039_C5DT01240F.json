      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "Weak intramolecular antiferromagnetic Gd–Gd exchange. Room-temperature χMT = 47.2 cm3 K mol−1 (expected 47.3 for six S = 7/2, g = 2.0); χMT remains nearly constant to ~20 K then falls to 42.3 cm3 K mol−1 at 2 K. Independent fits of χMT and VTVB data give JGd–Gd = −0.004 cm−1 (gGd fixed at 2.0). Magnetization at 5 T and 2 K is 42.1 μB (7.0 μB per Gd). Specific-heat MCE: −ΔSm reaches 22.6 J kg−1 K−1 at 1.7 K, close to the 23.7 J kg−1 K−1 maximum for six GdIII spins.",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "χMT",
            "value": 47.2,
            "unit": "cm3 K mol−1",
            "conditions": "room temperature; B = 0.1 T"
          },
          {
            "property_type": "magnetic",
            "name": "χMT",
            "value": 42.3,
            "unit": "cm3 K mol−1",
            "conditions": "2 K; B = 0.1 T"
          },
          {
            "property_type": "magnetic",
            "name": "JGd–Gd",
            "value": -0.004,
            "unit": "cm−1",
            "conditions": "isotropic spin Hamiltonian; gGd = 2.0; independent fits of χMT and VTVB"
          },
          {
            "property_type": "magnetic",
            "name": "magnetization",
            "value": 42.1,
            "unit": "μB",
            "conditions": "5 T, 2 K"
          },
          {
            "property_type": "magnetic",
            "name": "magnetic entropy change −ΔSm",
            "value": 22.6,
            "unit": "J kg−1 K−1",
            "conditions": "T = 1.7 K; from specific heat (0.3–30 K; B = 0, 1, 3, 7 T)"
          }
        ]
