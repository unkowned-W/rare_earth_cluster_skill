      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Under argon Schlenk conditions, a yellow solution of L^{CO}H (164 mg, 0.528 mmol) in 15 mL THF was added to a white suspension of Y[N(SiMe3)2]3 (301 mg, 0.528 mmol) in 20 mL hexane cooled to -78 °C. A dark yellow-orange suspension formed immediately, was stirred overnight (16 h) at room temperature and filtered. Volatiles were evaporated in vacuo, the residue was washed with 20 mL pentane and filtered again. The solution was concentrated to about one third of its volume and stored at -30 °C for four days to give yellow crystals.",
        "reagents": [
          {
            "name": "Y[N(SiMe3)2]3",
            "formula": "Y[N(SiMe3)2]3",
            "role": "metal precursor",
            "amount": "301 mg, 0.528 mmol"
          },
          {
            "name": "L^{CO}H (2-(2-methoxyphenylamino)-4-(2-methoxyphenylimino)pent-2-ene)",
            "formula": "L^{CO}H",
            "role": "ligand",
            "amount": "164 mg, 0.528 mmol"
          }
        ],
        "solvents": [
          "hexane",
          "THF",
          "pentane"
        ],
        "temperature": "addition at -78 °C, then room temperature overnight; crystallization at -30 °C",
        "time": "16 h stirring; 4 days crystallization",
        "ph": null,
        "vessel_or_method": "Schlenk techniques under argon",
        "workup_and_crystallization": "filtration, evaporation, pentane wash, concentration, freezer crystallization",
        "yield": "247 mg, 0.343 mmol, 65%"
