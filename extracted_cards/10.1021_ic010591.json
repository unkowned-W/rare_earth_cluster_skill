      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "Gd(tpaa) shows unusually high water-proton relaxivity attributed to a short Gd–H(water) distance and a probable bis(aqua)/tris(aqua) equilibrium (mean q slightly >2), with fast water exchange. Low aqueous solubility (<10−3 M) limits MRI use.",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "relaxivity r1p",
            "value": 13.3,
            "unit": "mM−1 s−1",
            "conditions": "25 °C, 60 MHz"
          },
          {
            "property_type": "magnetic",
            "name": "fitted inner-sphere hydration number q",
            "value": 2.5,
            "unit": null,
            "conditions": "NMRD fit of 1/T1 profiles at 278 and 298 K; c(Gd) = 0.169 mM"
          },
          {
            "property_type": "magnetic",
            "name": "Gd–H(water) distance rGdH",
            "value": "2.88 ± 0.05",
            "unit": "Å",
            "conditions": "NMRD fit with q = 2.5"
          },
          {
            "property_type": "magnetic",
            "name": "rotational correlation time τR298",
            "value": "76 ± 10",
            "unit": "ps",
            "conditions": "NMRD fit"
          },
          {
            "property_type": "magnetic",
            "name": "electronic correlation time τv298",
            "value": "48 ± 11",
            "unit": "ps",
            "conditions": "NMRD fit"
          },
          {
            "property_type": "magnetic",
            "name": "transient ZFS Δ2",
            "value": "0.14 ± 0.05 × 10^20",
            "unit": "s−2",
            "conditions": "NMRD fit"
          }
        ]
      },
