          },
          {
            "property_type": "magnetic",
            "name": "χ″ peak temperature",
            "value": "~4",
            "unit": "K",
            "conditions": "ac susceptibility, 1488 Hz, 0 dc field, 3 Oe ac"
          },
          {
            "property_type": "magnetic",
            "name": "Ueff (magnetization decay, μ-SQUID)",
            "value": 5.43,
            "unit": "K",
            "conditions": "single crystal, 0.03–0.5 K Orbach+Raman+QTM fit"
          },
