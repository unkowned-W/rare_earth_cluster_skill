            "amount": "0.22 g, 0.3 mmol",
            "formula": "L²GdCl2(THF)2",
            "name": "complex 2",
            "role": "gadolinium precursor"
          },
          {
            "amount": "0.30 g, 1.5 mmol; 5 equivalents",
            "formula": "Al(iBu)3",
            "name": "triisobutylaluminum",
            "role": "reaction component"
          },
          {
            "amount": "0.28 g, 0.3 mmol",
            "formula": "[Ph3C][B(C6F5)4]",
            "name": "trityl tetrakis(pentafluorophenyl)borate",
            "role": "borate reagent"
          }
        ],
        "si_used": false,
        "solvents": [
          "toluene, 20 mL",
          "chlorobenzene, 5 mL"
        ],
