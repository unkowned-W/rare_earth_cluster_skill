      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "All Ln4 compounds 1–3 were prepared by the same procedure. Eu(dbm)3·2H2O (0.025 mmol) was dissolved in 20 mL ethanol/acetonitrile (1/1, v/v). Then 5 mL CH2Cl2 containing HL (0.025 mmol) was added and the mixture was stirred for 5 h at room temperature. The solution was filtered and kept in the dark for slow evaporation at room temperature. After about 5 days, yellow block crystals suitable for single-crystal X-ray diffraction were obtained. Yield 55% based on Eu.",
        "reagents": [
          {
            "name": "Eu(dbm)3·2H2O",
            "formula": "Eu(dbm)3·2H2O",
            "role": "metal precursor",
            "amount": "0.025 mmol"
          },
          {
            "name": "5-(4-methylbenzylidene)-8-hydroxyquinoline (HL)",
            "formula": "C17H14N2O",
            "role": "ligand",
            "amount": "0.025 mmol in 5 mL CH2Cl2"
          }
        ],
        "solvents": [
          "ethanol",
          "acetonitrile",
          "dichloromethane"
        ],
        "temperature": "room temperature",
        "time": "stirred 5 h; crystals after about 5 days",
        "ph": null,
        "vessel_or_method": "solution mixing, filtration, and slow evaporation in the dark",
        "workup_and_crystallization": "filtered and concentrated slowly by evaporation at room temperature in the dark; yellow block crystals after about 5 days",
        "yield": "55% (based on Eu)"
      },
      "properties": {
        "reported": true,
        "property_type": "optical",
        "summary": "Solid-state luminescence of 1 at room temperature under 320 nm excitation shows Eu(III) characteristic emissions at 489, 539, 590, 617 and 696 nm, assigned to 5D1→7FJ and 5D0→7FJ transitions, with the 5D1→7F2 emission strongest. Fluorescence lifetime 12.417 μs; experimental quantum yield φem = 1.51%; theoretical φLn = 0.26%; ligand-to-Eu sensitization efficiency ηsens = 5.81%. UV–vis spectra in ethanol show ligand-based absorptions in the ranges 200–228, 228–299 and 299–419 nm.",
        "measurements": [
          {
            "property_type": "optical",
            "name": "excitation wavelength",
            "value": 320,
            "unit": "nm",
            "conditions": "solid state, room temperature"
          },
          {
            "property_type": "optical",
            "name": "emission maxima",
            "value": "489, 539, 590, 617, 696",
            "unit": "nm",
            "conditions": "solid state, λex = 320 nm, room temperature"
          },
          {
            "property_type": "optical",
            "name": "fluorescence lifetime",
            "value": 12.417,
            "unit": "μs",
            "conditions": "solid state; FLS980"
          },
