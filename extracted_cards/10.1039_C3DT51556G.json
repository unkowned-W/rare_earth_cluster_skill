            "name": "N,N'-bis(2-hydroxy-3-methoxybenzylidene)-1,3-propanediamine (H2L)",
            "formula": "H2L",
            "role": "ligand",
            "amount": "0.068 g, 0.2 mmol"
          }
        ],
        "solvents": [
          "methanol",
          "dichloromethane",
          "hexane"
        ],
        "temperature": "ambient temperature",
        "time": "10 h stirring; crystals in about two weeks",
        "ph": null,
        "vessel_or_method": "solution mixing followed by solvent diffusion",
        "workup_and_crystallization": "Filtered; hexane diffused into the filtrate; stored in the dark at ambient temperature; yellow crystals.",
        "yield": "0.061 g (51%)"
      },
      "properties": {
        "reported": true,
        "property_type": "optical",
        "summary": "All of 1–5 show Yb(III) NIR emission near 975 nm (2F5/2 → 2F7/2) in isoabsorptive CH3CN; relative intensity is 3 > 4 > 1 > 2 > 5. Complex 1 is stronger than dinuclear 2 because two H2L ligands encapsulate the single Yb(III) ion, despite having only one emissive center.",
