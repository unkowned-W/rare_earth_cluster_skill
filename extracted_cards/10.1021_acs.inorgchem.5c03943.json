      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "LH4 (0.030 g, 0.077 mmol) and Dy(NO3)3·5H2O (0.0678 g, 0.154 mmol) were combined in 3 mL of acetonitrile, giving a yellow slurry that was stirred for 15 min at room temperature. Triethylamine (0.308 mmol) was added dropwise, then 1 mL DMF, producing a clear yellow solution that was stirred for 10 min. Hydrogen peroxide (34.5–36.5%, 0.077 mmol) was added and the mixture was stirred for 6 h, then concentrated to 1 mL. Crystals suitable for X-ray diffraction formed over 3 days by slow diffusion of diethyl ether.",
        "reagents": [
          {
            "name": "LH4 ((E)-6-((bis(2-hydroxyethyl)amino)methyl)-N′-(2-hydroxy-3-methoxybenzylidene)picolinohydrazide)",
