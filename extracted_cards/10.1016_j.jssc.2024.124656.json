      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "A mixture of Mn(OAc)2·4H2O (1.0 mmol), Sm(NO3)3·6H2O (1.0 mmol) and 2-amino-2-methyl-1,3-propanediol (ampdH2, 1.0 mmol) was dissolved in 15 mL methanol, giving a light yellow solution. After addition of Et3N (50 μL), the solution was stirred for 5 h at room temperature and turned reddish brown. The resulting solution was filtered and evaporated in air for about one week to obtain reddish brown crystals. Yield 27% based on manganese.",
        "reagents": [
          {
            "name": "manganese(II) acetate tetrahydrate",
            "formula": "Mn(OAc)2·4H2O",
            "role": "Mn source",
            "amount": "1.0 mmol"
          },
          {
            "name": "samarium(III) nitrate hexahydrate",
            "formula": "Sm(NO3)3·6H2O",
            "role": "Ln source",
            "amount": "1.0 mmol"
          },
          {
            "name": "2-amino-2-methyl-1,3-propanediol",
            "formula": "ampdH2",
            "role": "ligand",
            "amount": "1.0 mmol"
          },
          {
            "name": "triethylamine",
            "formula": "Et3N",
            "role": "base",
            "amount": "50 μL"
          }
        ],
        "solvents": [
          "methanol"
        ],
        "temperature": "room temperature",
        "time": "stirred 5 h; evaporated in air about one week",
        "ph": null,
        "vessel_or_method": "one-pot solution synthesis; filtration and air evaporation",
        "workup_and_crystallization": "filtered and evaporated in air for about one week to obtain reddish brown crystals",
        "yield": "27% (based on manganese)"
      },
      "properties": {
        "reported": true,
        "property_type": "optical",
        "summary": "{Mn5Sm5}/PVA film shows the strongest third-order NLO reverse-saturable absorption and optical-limiting response among the measured analogues.",
        "measurements": [
          {
            "property_type": "optical",
            "name": "nonlinear absorption coefficient β",
            "value": "1.28e-7",
            "unit": "m W^-1",
            "conditions": "OA Z-scan; {Mn5Sm5}/PVA film; 1550 nm, 1 kHz, 35 fs; incident intensity 9.09 GW cm^-2"
          },
          {
            "property_type": "optical",
            "name": "minimum normalized transmittance Tmin",
            "value": "~0.18",
            "unit": null,
            "conditions": "OA Z-scan at 1550 nm, 9.09 GW cm^-2"
          },
          {
