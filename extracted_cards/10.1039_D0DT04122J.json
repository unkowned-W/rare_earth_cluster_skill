            "amount": "0.135 g, 0.3 mmol"
          }
        ],
        "solvents": [
          "DMF",
          "methanol"
        ],
        "temperature": "80 °C (reflux)",
        "time": "stir 0.5 h, then reflux 8 h; crystallization 7 days",
        "ph": null,
