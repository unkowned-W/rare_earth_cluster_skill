      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "All reactions were performed in air. Hpiv (1.0 mmol, 101 mg) and CrCl3·6H2O (0.2 mmol, 53 mg) were dissolved in 15 mL CH3CN with 0.6 mL Et3N. After stirring for 1 h, 15 mL CH2Cl2 was added and the mixture was stirred for another 1 h. Ho(NO3)3·6H2O (0.3 mmol, 138 mg) was then added. A light-purple solution was obtained after stirring for 0.5 h with heating, then cooled to room temperature and filtered. Well-shaped purple crystals formed after about two weeks, were washed with CH3CN/CH2Cl2 (10 mL, 1:1 v/v) and dried in air.",
        "reagents": [
          {
            "name": "pivalic acid (Hpiv)",
            "formula": "C5H10O2",
            "role": "ligand",
            "amount": "1.0 mmol, 101 mg"
          },
          {
            "name": "chromium(III) chloride hexahydrate",
            "formula": "CrCl3·6H2O",
            "role": "metal source",
            "amount": "0.2 mmol, 53 mg"
          },
          {
            "name": "triethylamine",
            "formula": "Et3N",
            "role": "base",
            "amount": "0.6 mL"
          },
          {
            "name": "holmium(III) nitrate hexahydrate",
            "formula": "Ho(NO3)3·6H2O",
            "role": "metal source",
            "amount": "0.3 mmol, 138 mg"
          }
        ],
        "solvents": [
          "CH3CN",
          "CH2Cl2"
        ],
        "temperature": "stirred with heating, then cooled to room temperature; crystallization at ambient temperature",
        "time": "stirring 1 h + 1 h + 0.5 h; crystals after about two weeks",
        "ph": null,
        "vessel_or_method": "solution synthesis in air, filtration and slow crystallization",
        "workup_and_crystallization": "filtered after cooling; purple crystals washed with CH3CN/CH2Cl2 (10 mL, 1:1) and dried in air",
        "yield": "12% (66 mg) based on Ho"
      },
      "properties": {
        "reported": true,
        "property_type": "both",
        "summary": "DC susceptibility (2–300 K, 1000 Oe) shows χMT nearly constant from 300–50 K then falling to 12.68 cm3 K mol−1 at 2.0 K; room-temperature χMT is 42.29 cm3 K mol−1. Magnetization reaches 24.87 NμB. No frequency-dependent χ″ under zero DC field. {Ln3Cr2} UV–vis bands at 405 and 550 nm.",
        "measurements": [
          {
            "property_type": "magnetic",
