        "other_metal_elements": [
          "Ni"
        ],
        "dimensionality": "0D",
        "structural_family": "defect dicubane Ni2Ln2"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Under aerobic conditions, H2L1 (0.2 mmol, 48 mg) and Et3N (0.5 mmol, 69 μL) were added to MeCN (20 mL) and stirred for 10 min. NiCl2·6H2O (0.1 mmol, 24 mg) and YCl3·xH2O (0.1 mmol) were added and the mixture was refluxed for 2 h, giving a green precipitate from a yellow solution. The solid was filtered, washed with cold MeCN (20 mL) and Et2O (10 mL), and dried overnight at 60 °C. The series yield is 69–95% based on Ln. Elemental analysis matches the formula without lattice MeCN; TGA indicates loss of four MeCN molecules (coordinated and lattice).",
        "reagents": [
          {
            "name": "(E)-2-(2-hydroxy-3-methoxybenzylideneamino)phenol",
            "formula": "H2L1",
            "role": "ligand",
            "amount": "0.2 mmol, 48 mg"
          },
          {
            "name": "triethylamine",
            "formula": "Et3N",
            "role": "base",
            "amount": "0.5 mmol, 69 μL"
          },
