        "structural_family": "tetranuclear Ln4 alkoxo-bridged cluster"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "SmCl3·6H2O (0.0245 g, 0.0671 mmol) and heda (1 mL) were placed in a thick Pyrex tube (~20 cm long, 1.5 cm diameter). The tube was sealed by an acetylene torch under ambient conditions and kept at 150 °C for 3 days to give orange-block crystals of 1a.",
        "reagents": [
          {
            "name": "samarium(III) chloride hexahydrate",
            "formula": "SmCl3·6H2O",
            "role": "metal source",
            "amount": "0.0245 g, 0.0671 mmol"
          },
          {
            "name": "N-(2-hydroxyethyl)ethylenediamine",
            "formula": "Hheda",
            "role": "ligand/solvent",
            "amount": "1 mL"
          }
        ],
        "solvents": [
          "Hheda"
        ],
        "temperature": "150 °C",
        "time": "3 days",
        "ph": null,
        "vessel_or_method": "sealed thick Pyrex tube, solvothermal",
        "workup_and_crystallization": "orange-block crystals obtained directly from the sealed-tube reaction",
        "yield": "71% based on SmCl3"
      },
      "properties": {
        "reported": true,
        "property_type": "both",
        "summary": "UV/Vis absorption of 1a shows Cl/O/N→Ln charge-transfer bands at 200–330 nm and Sm3+ f–f peaks at 404 and 1085 nm. Variable-temperature magnetism (2–300 K, 1 kOe) gives χMT = 0.35 cm3·K·mol−1 at 300 K (close to 0.36 for four uncoupled Sm3+), decreasing to 0.03 cm3·K·mol−1 at 2 K; antiferromagnetic Sm–Sm interactions are inferred from the Sm–O–Sm angle 112.02(12)°. χM−1 vs T does not obey Curie–Weiss law.",
        "measurements": [
          {
            "property_type": "optical",
            "name": "UV/Vis absorption (Sm3+ f–f)",
            "value": "404 nm (6H5/2 → 4F7/2); 1085 nm (6H5/2 → 6F9/2)",
            "unit": null,
            "conditions": "solid-state, room temperature, 200–1200 nm"
          },
          {
            "property_type": "magnetic",
            "name": "χMT",
            "value": "0.35",
            "unit": "cm3·K·mol−1",
            "conditions": "300 K, 1 kOe"
          },
          {
            "property_type": "magnetic",
            "name": "χMT",
            "value": "0.03",
            "unit": "cm3·K·mol−1",
            "conditions": "2 K, 1 kOe"
          }
        ]
      },
