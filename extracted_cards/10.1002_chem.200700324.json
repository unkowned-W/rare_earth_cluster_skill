      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "General procedure for [Ln3L6(OH)(H2O)3](ClO4)2: TEA (98 μL, 0.67 mmol, 2.3 equiv) was added to (+)- or (−)-HL·HCl·H2O (100 mg, 1 equiv) in methanol (3 mL). A methanol solution of Ln(ClO4)3·xH2O (about 0.05 M, 0.5 equiv) was dropped into the stirred mixture. A white precipitate formed quantitatively, was collected by filtration, washed with cold methanol, and dried under high vacuum (10−5 mbar). Crystals for X-ray analysis were grown by slow evaporation of a CD3CN solution. The La complex was prepared with (−)-L.",
        "reagents": [
          {
