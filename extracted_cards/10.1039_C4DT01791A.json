      ],
      "material_class": {
        "material_type": "cluster",
        "nuclearity": 8,
        "metal_composition": "heterometallic",
        "rare_earth_elements": [
          "Gd"
        ],
        "other_metal_elements": [
          "Co"
        ],
        "dimensionality": "0D",
        "structural_family": "crab-shaped Co5Gd3 cage with edge-sharing distorted cubane cores"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "[Co2(μ-OH2)(O2CtBu)4]·(HO2CtBu)4 (Co2; 100 mg, 0.1 mmol) was dissolved in CH3CN (8 mL). n-N-butyldiethanolamine (H2L; 24 mg, 0.15 mmol) was added while stirring, followed by Gd(NO3)3·6H2O (45 mg, 0.1 mmol). The mixture was stirred for ~12 h at room temperature, filtered, and the filtrate kept at 4 °C for slow evaporation. Purple block crystals formed within 3–4 days, were collected by filtration, washed with cold CH3CN, and dried in air.",
        "reagents": [
          {
            "name": "[Co2(μ-OH2)(O2CtBu)4]·(HO2CtBu)4",
            "formula": "[Co2(μ-OH2)(O2CtBu)4]·(HO2CtBu)4",
            "role": "Co source",
            "amount": "100 mg, 0.1 mmol"
          },
          {
            "name": "n-N-butyldiethanolamine (H2L)",
            "formula": "H2L",
            "role": "ligand",
            "amount": "24 mg, 0.15 mmol"
          },
          {
            "name": "gadolinium(III) nitrate hexahydrate",
            "formula": "Gd(NO3)3·6H2O",
            "role": "Ln source",
            "amount": "45 mg, 0.1 mmol"
          }
        ],
        "solvents": [
          "CH3CN"
        ],
        "temperature": "room temperature stirring; crystallization at 4 °C",
        "time": "~12 h stirring; crystals in 3–4 days",
        "ph": null,
        "vessel_or_method": "ambient stirring then slow evaporation",
        "workup_and_crystallization": "filtered; filtrate evaporated at 4 °C; crystals washed with cold CH3CN and dried in air",
        "yield": "47% based on Co2"
      },
      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "DC susceptibility and magnetization support mixed-valent CoII/CoIII plus three GdIII ions. Significant magnetocaloric effect with −ΔSm = 21.57 J kg−1 K−1.",
        "measurements": [
          {
