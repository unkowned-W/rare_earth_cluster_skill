            "amount": "1:1 molar ratio vs LaCl3·6H2O"
          },
          {
            "name": "lanthanum(III) chloride hexahydrate",
            "formula": "LaCl3·6H2O",
            "role": "metal source",
            "amount": "1:1 molar ratio vs H4L"
