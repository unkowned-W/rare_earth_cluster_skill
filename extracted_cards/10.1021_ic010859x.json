      "compound_label": "1",
      "compound_name": "[Eu15(μ3-OH)20(μ5-Cl)(μ3-Tyr)10(OH)2(μ2-H2O)5(H2O)18](ClO4)12·9H2O",
      "formula": "[Eu15(μ3-OH)20(μ5-Cl)(μ3-Tyr)10(OH)2(μ2-H2O)5(H2O)18](ClO4)12·9H2O",
      "ccdc_numbers": [
        "190844"
      ],
      "ccdc_refcodes": [
        "GOKLUN02"
      ],
      "material_class": {
        "material_type": "cluster",
        "nuclearity": 15,
        "metal_composition": "homometallic",
        "rare_earth_elements": [
          "Eu"
        ],
        "other_metal_elements": [],
        "dimensionality": "0D",
        "structural_family": "halide-templated vertex-sharing cubane wheel [Ln15(μ3-OH)20(μ5-X)]"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "L-Tyrosine (0.181 g, 1.0 mmol) was added as a solid to aqueous Eu(ClO4)3 (1.0 M, 4.0 mmol). Aqueous HCl (0.25 mL, 1.0 M) was added. The mixture (pH 1–2) was stirred at about 80 °C while aqueous NaOH (5 mL, 0.5 M) was added dropwise to an incipient permanent precipitate. The mixture was filtered and the filtrate (pH 6–7) reduced to about 4 mL. The hot solution was covered with Parafilm and allowed to stand on the cooling heating plate. Colorless parallelepipeds appeared in about one week, were collected by filtration, washed with ice-cold water, and dried under dynamic vacuum over silica gel.",
        "reagents": [
          {
            "name": "L-tyrosine",
            "formula": "C9H11NO3",
            "role": "supporting ligand",
            "amount": "0.181 g, 1.0 mmol"
          },
          {
            "name": "europium(III) perchlorate",
            "formula": "Eu(ClO4)3",
            "role": "metal source",
            "amount": "1.0 M, 4.0 mmol"
          },
          {
            "name": "hydrochloric acid",
            "formula": "HCl",
            "role": "chloride template source",
            "amount": "0.25 mL, 1.0 M"
          },
          {
            "name": "sodium hydroxide",
            "formula": "NaOH",
            "role": "base for hydrolysis",
            "amount": "5 mL, 0.5 M"
          }
        ],
        "solvents": [
          "water"
        ],
        "temperature": "about 80 °C during hydrolysis; crystallization on a gradually cooling heating plate",
        "time": "crystals appeared in about one week",
        "ph": "initial pH 1–2; filtrate pH 6–7",
        "vessel_or_method": "heating plate; aqueous hydrolysis and concentration",
        "workup_and_crystallization": "filtration; concentration of filtrate to ~4 mL; Parafilm-covered hot solution; colorless parallelepipeds; wash with ice-cold water; dry under dynamic vacuum over silica gel",
        "yield": "60% (based on tyrosine)"
      },
      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "Room-temperature effective magnetic moment by Evans’ method agrees with the Van Vleck value assuming magnetically noninteractive Eu(III) ions.",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "μeff",
            "value": 12.9,
            "unit": "μB",
            "conditions": "293 K, Evans’ method; calculated 13.2 μB"
          }
        ]
      },
