            "name": "glacial acetic acid",
            "role": "acetate source"
          },
          {
            "amount": "0.250 g, 0.576 mmol",
            "formula": "Ce(NO3)3·6H2O",
            "name": "cerium(III) nitrate hexahydrate",
            "role": "rare-earth source"
          },
          {
            "amount": "0.252 g, 1.140 mmol",
            "formula": "(CH3)2SnCl2",
            "name": "dimethyltin dichloride",
            "role": "organotin source"
          },
          {
            "amount": "6 mol L−1; volume not reported",
