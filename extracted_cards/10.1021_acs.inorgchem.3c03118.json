          {
            "name": "(E)-2-(2-hydroxy-3-methoxybenzylideneamino)phenol (H2L1)",
            "formula": "C14H13NO3",
            "role": "bridging Schiff-base ligand",
            "amount": "0.25 mmol"
          },
          {
            "name": "(+)-3-trifluoroacetyl camphor (D-Htfc)",
            "formula": "C12H15F3O2",
            "role": "chiral beta-diketone ligand",
            "amount": "0.125 mmol"
          },
          {
            "name": "dysprosium(III) trifluoromethanesulfonate",
            "formula": "Dy(CF3SO3)3",
            "role": "metal source",
            "amount": "0.25 mmol"
          },
          {
            "name": "triethylamine",
            "formula": "Et3N",
            "role": "base",
            "amount": "0.75 mmol"
          }
        ],
        "solvents": [
