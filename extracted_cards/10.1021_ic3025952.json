      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Under aerobic conditions, Eu(NO3)3·6H2O (0.338 g, 1 mmol) was added to a stirred MeOH (25 mL) solution of Mn(OAc)2·4H2O (0.980 g, 4 mmol) and ClshiH3 (0.752 g, 4 mmol). The pH was adjusted to 8 with tetrabutylammonium hydroxide. The green solution was stirred at room temperature for 6 h, becoming dark green, then filtered and left undisturbed at room temperature. Black block crystals formed after 2 weeks, were collected by filtration, washed with cold MeOH, and dried in air.",
        "reagents": [
          {
            "name": "europium(III) nitrate hexahydrate",
            "formula": "Eu(NO3)3·6H2O",
            "role": "lanthanide source",
            "amount": "0.338 g, 1 mmol"
          },
          {
            "name": "manganese(II) acetate tetrahydrate",
            "formula": "Mn(OAc)2·4H2O",
            "role": "metal source",
            "amount": "0.980 g, 4 mmol"
          },
          {
            "name": "5-chlorosalicylhydroxamic acid",
            "formula": "ClshiH3",
            "role": "ligand",
            "amount": "0.752 g, 4 mmol"
          },
          {
            "name": "tetrabutylammonium hydroxide",
            "formula": "[(C4H9)4N]OH",
            "role": "base",
            "amount": "to pH 8"
          }
        ],
        "solvents": [
          "MeOH"
        ],
        "temperature": "room temperature",
        "time": "6 h stirring; crystallization over 2 weeks",
        "ph": "8",
        "vessel_or_method": "aerobic solution reaction, then undisturbed crystallization",
        "workup_and_crystallization": "Filtered after 6 h and left at room temperature; black block crystals after 2 weeks, washed with cold MeOH and dried in air.",
        "yield": "13 mg (27%, based on the ligand)"
      },
      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "DC susceptibility shows antiferromagnetic interactions. Room-temperature χMT is below the uncoupled value, falls to 0.86 cm3 K mol−1 at 1.8 K, and the low-temperature data indicate a ground-state spin S = 0 because EuIII is effectively diamagnetic at low temperature. Magnetization reaches 10.78 μB at 7 T without saturation, and reduced-magnetization curves do not superimpose. No out-of-phase ac signal is observed in zero dc field.",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "χMT",
            "value": "27.74",
            "unit": "cm3 K mol−1",
            "conditions": "300 K, 2000 Oe, per Mn8Eu4 dimer"
          },
          {
            "property_type": "magnetic",
            "name": "χMT",
            "value": "0.86",
            "unit": "cm3 K mol−1",
            "conditions": "1.8 K, 2000 Oe, per Mn8Eu4 dimer"
          },
          {
            "property_type": "magnetic",
            "name": "magnetization",
            "value": "10.78",
            "unit": "μB",
            "conditions": "7 T, 1.8–10 K"
          },
          {
            "property_type": "magnetic",
            "name": "ground-state spin S",
            "value": "0",
            "unit": null,
            "conditions": "inferred from low-temperature χMT approaching zero"
          }
        ]
      },
