            "role": "ligand",
            "amount": "0.036 g, 0.2 mmol"
          },
          {
            "name": "acetonitrile",
            "formula": "MeCN",
            "role": "solvent",
            "amount": "8 mL"
          }
        ],
        "solvents": [
          "MeCN"
        ],
        "temperature": "150 °C",
