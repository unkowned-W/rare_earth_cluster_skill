      "properties": {
        "reported": true,
        "property_type": "optical",
        "summary": "In CD3OD the complex shows ligand-sensitized Yb NIR emission and solution-state cooperative luminescence under 980 nm excitation. The UC emission near 503 nm is a two-photon process (log-log slope 1.8), and its decay is about half the Yb lifetime, as expected for cooperative luminescence.",
        "measurements": [
          {
            "property_type": "optical",
            "name": "ligand molar absorption coefficient",
            "value": "1.9e5",
            "unit": "M^-1 cm^-1",
            "conditions": "CD3OD, 289 nm; Table 1, Yb9(DLn:Ds:HL)"
          },
          {
            "property_type": "optical",
            "name": "Yb molar absorption coefficient",
            "value": "58",
            "unit": "M^-1 cm^-1",
            "conditions": "CD3OD, NIR Yb absorption; Table 1"
          },
          {
            "property_type": "optical",
            "name": "Yb luminescence lifetime",
            "value": "15",
            "unit": "μs",
            "conditions": "CD3OD, excitation 340 nm; Table 1 (prose ms values are consistent with μs)"
          },
          {
            "property_type": "optical",
            "name": "Yb radiative lifetime",
            "value": "742",
            "unit": "μs",
            "conditions": "calculated from NIR absorption; Table 1"
          },
          {
            "property_type": "optical",
            "name": "sensitization efficiency",
            "value": "20",
            "unit": "%",
            "conditions": "ligand-to-Yb; Table 1"
          },
          {
            "property_type": "optical",
