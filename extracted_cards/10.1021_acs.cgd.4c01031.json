            "formula": "H2L1",
            "role": "ligand",
            "amount": "2 mmol, 0.119 g"
          },
          {
            "name": "triethylamine",
            "formula": "Et3N",
            "role": "base",
            "amount": "2 mmol, 0.202 g"
          }
        ],
        "solvents": [
          "ethanol"
        ],
        "temperature": "100 °C",
        "time": "2 days",
        "ph": null,
        "vessel_or_method": "solvothermal reaction in 20 mL PTFE reactor",
        "workup_and_crystallization": "cooled to ambient temperature, filtered, and rinsed with a small amount of ethanol to give bulk crystals",
        "yield": "0.538 g (16% based on Gd)"
      },
      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "Intramolecular antiferromagnetic interactions and magnetocaloric effect. χMT at 300 K is 69.77 cm3 K mol−1 (nine isolated Gd3+ expected 70.92). χMT falls to 29.05 cm3 K mol−1 at 3 K. Curie–Weiss fit: C = 70.08 cm3 K mol−1, θ = −1.86 K. Magnetization 59.40 Nβ at 7 T and 3 K. −ΔSm max = 33.65 J kg−1 K−1 at 3 K and 7 T (theoretical 47.31 J kg−1 K−1).",
        "measurements": [
