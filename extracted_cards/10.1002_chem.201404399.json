        "structural_family": "tetranuclear ytterbium dithionite/sulfinate metallocene cluster"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "SO2 (0.3 mmol) was condensed onto a stirred solution of [Cp*2Yb(THF)2] (175 mg, 0.3 mmol) in THF (20 mL) at −50 °C. The mixture turned dark violet immediately, was stirred for 1 h at −50 °C, then stood overnight without stirring while slowly warming to room temperature. THF was removed in vacuum and the residue was washed with n-pentane (15 mL), giving a pale solid (27 mg) and a red-violet n-pentane solution. The pentane solution was filtered and stored at room temperature for two weeks to give red-violet crystals of 1 suitable for X-ray analysis.",
        "reagents": [
          {
            "name": "sulfur dioxide",
            "formula": "SO2",
            "role": "substrate",
            "amount": "0.3 mmol"
          },
          {
            "name": "decamethylytterbocene bis(THF)",
            "formula": "[(η5-C5Me5)2Yb(THF)2]",
            "role": "metal precursor",
            "amount": "175 mg; 0.3 mmol"
          }
        ],
        "solvents": [
          "THF",
          "n-pentane"
        ],
        "temperature": "−50 °C then warm to RT; crystallization at RT",
        "time": "1 h stirring at −50 °C, overnight warming, two weeks crystallization",
        "ph": null,
        "vessel_or_method": "SO2 condensation onto THF solution",
        "workup_and_crystallization": "THF removed in vacuum; residue washed with n-pentane (15 mL); pentane filtrate stored at RT for two weeks to give red-violet crystals",
        "yield": "14 mg, 9%"
      },
