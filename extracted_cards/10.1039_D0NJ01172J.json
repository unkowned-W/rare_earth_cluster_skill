            "role": "metal precursor",
            "amount": "0.025 mmol"
          }
        ],
        "solvents": [
          "dichloromethane",
          "methanol",
          "acetonitrile"
        ],
        "temperature": "stirred at room temperature, then heated at 75 °C",
        "time": "stirred ~1 h, then 72 h solvothermal",
