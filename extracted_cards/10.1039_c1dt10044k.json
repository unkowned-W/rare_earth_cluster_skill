      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "A mixture of LiOH·H2O (0.5 mmol) and (S)-4-amino-2-hydroxybutanoic acid (0.5 mmol) in methanol (10 mL) was stirred for 20 min; 2-hydroxybenzaldehyde (0.5 mmol) was then added and stirred for about 1 h at room temperature to form the Schiff-base HL− in situ. Mn(OAc)2·4H2O (0.5 mmol), Dy(NO3)3·6H2O (0.25 mmol) and triethylamine (1.0 mmol) were added and the mixture was stirred for another 4 h under ambient conditions. The resulting dark brown solution was layered with n-hexane; block dark crystals of 1 were collected after a few days.",
        "reagents": [
          {
            "name": "lithium hydroxide monohydrate",
            "formula": "LiOH·H2O",
            "role": "base for in situ ligand formation",
            "amount": "0.5 mmol"
          },
          {
            "name": "(S)-4-amino-2-hydroxybutanoic acid",
            "formula": "C4H9NO3",
            "role": "chiral ligand precursor",
            "amount": "0.5 mmol"
          },
          {
            "name": "2-hydroxybenzaldehyde",
            "formula": "C7H6O2",
            "role": "Schiff-base ligand precursor",
            "amount": "0.5 mmol"
          },
          {
            "name": "manganese(II) acetate tetrahydrate",
            "formula": "Mn(OAc)2·4H2O",
            "role": "Mn source",
            "amount": "0.5 mmol"
          },
          {
            "name": "dysprosium(III) nitrate hexahydrate",
            "formula": "Dy(NO3)3·6H2O",
            "role": "Ln source",
            "amount": "0.25 mmol"
          },
          {
            "name": "triethylamine",
            "formula": "NEt3",
            "role": "base",
            "amount": "1.0 mmol"
          }
        ],
        "solvents": [
          "methanol",
          "n-hexane"
        ],
        "temperature": "room temperature / ambient conditions",
        "time": "ligand formation ~1 h after 20 min pre-stir; then 4 h stirring; crystals in a few days",
        "ph": null,
        "vessel_or_method": "in situ Schiff-base formation followed by solution layering crystallization",
        "workup_and_crystallization": "dark brown MeOH solution layered with n-hexane; block dark crystals collected after a few days",
        "yield": "40.0% based on Mn"
      },
      "properties": {
        "reported": true,
        "property_type": "both",
        "summary": "dc susceptibility of 1 shows χMT = 59.73 cm3 mol−1 K at 300 K (close to 60.51 cm3 mol−1 K expected for 6 MnIII + 3 DyIII), decreasing slowly to ~50 K then dropping to 21.90 cm3 mol−1 K at 2 K, attributed to thermal depopulation of Dy Stark sublevels and/or weak antiferromagnetic coupling. CD spectra of single-crystal and bulk 1 in MeOH confirm enantiopurity and that the cationic cluster remains undissociated in solution.",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "χMT",
            "value": 59.73,
            "unit": "cm3 mol−1 K",
            "conditions": "300 K, 1000 Oe, 2–300 K dc susceptibility"
          },
          {
            "property_type": "magnetic",
            "name": "χMT",
            "value": 21.9,
            "unit": "cm3 mol−1 K",
            "conditions": "2 K, 1000 Oe"
          },
          {
            "property_type": "optical",
            "name": "CD spectra (enantiopurity)",
            "value": "single-crystal and bulk samples in MeOH essentially identical; time-independent over 10 min–10 h",
            "unit": null,
            "conditions": "MeOH solution; Fig. 3"
          }
        ]
      },
