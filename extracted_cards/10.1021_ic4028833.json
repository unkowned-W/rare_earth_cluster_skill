            "name": "J2 (Gd–Gd)",
            "value": "-0.68(1)",
            "unit": "cm−1",
            "conditions": "fit of χT(T)"
          },
          {
            "property_type": "magnetic",
            "name": "g",
            "value": "1.93(2)",
            "unit": null,
            "conditions": "fit of χT(T)"
          },
          {
            "property_type": "magnetic",
            "name": "magnetization inflection field",
            "value": 3.4,
