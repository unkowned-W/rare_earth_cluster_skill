      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Under inert nitrogen-glovebox conditions, a toluene solution of 2-amino-4,6-dimethylpyrimidine (0.15 g, 1.20 mmol in 45 ml) was added to Cp3Nd (0.40 g, 1.20 mmol) at −78 °C. The mixture was warmed to room temperature and stirred for 1 h (no colour change). The precipitate was dissolved, the hot solution filtered through Celite (porosity 3), reduced to ca. 15 ml, redissolved, and stored at room temperature for 24 h to give blue crystals of 1.",
        "reagents": [
          {
            "name": "2-amino-4,6-dimethylpyrimidine",
            "formula": "C6H9N3",
            "role": "ligand precursor",
            "amount": "0.15 g, 1.20 mmol"
          },
          {
            "name": "tris(cyclopentadienyl)neodymium(III)",
            "formula": "Cp3Nd",
            "role": "metal source / Brønsted base",
            "amount": "0.40 g, 1.20 mmol"
          }
        ],
        "solvents": [
          "toluene"
        ],
        "temperature": "addition at −78 °C, then room temperature",
        "time": "stirred 1 h; stored 24 h",
        "ph": null,
        "vessel_or_method": "inert-atmosphere Schlenk/glovebox; hot filtration through Celite (porosity 3)",
        "workup_and_crystallization": "hot filtration, concentration to ca. 15 ml, redissolution, crystallization at room temperature (24 h)",
        "yield": "0.39 g, 41%"
      },
      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "SQUID susceptibility (100 G, 5–300 K) of the Nd dimer shows χT below the free-ion value and a large negative Weiss constant, consistent with crystal-field effects and possible antiferromagnetic coupling; orbital contributions prevent a simple isotropic-exchange model.",
