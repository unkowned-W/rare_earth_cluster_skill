            "formula": "NEt3",
            "role": "base",
            "amount": "1 mL (excess)"
          }
        ],
        "solvents": [
          "methanol",
          "toluene"
        ],
        "temperature": null,
        "time": "12 h (reaction); 1 h (toluene stir)",
        "ph": null,
        "vessel_or_method": "round-bottomed flask with stirrer bead; ambient solution reaction then slow evaporation",
        "workup_and_crystallization": "Methanol removed; residue stirred in toluene (~2 mL), filtered, and slowly evaporated in an open vial. Pale yellow crystals harvested prior to complete solvent loss.",
