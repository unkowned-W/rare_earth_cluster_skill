    {
      "compound_label": "3",
      "compound_name": "tetranuclear lanthanum carbonato–N,N-dibutylcarbamate",
      "formula": "[La4(CO3)(O2CNBu2)10]",
      "ccdc_numbers": [],
      "ccdc_refcodes": [],
      "material_class": {
