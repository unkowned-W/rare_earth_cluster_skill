      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "Dc χMT is 78.97 cm3 K mol-1 at 300 K (expected 85.02 for six free DyIII) and 58.12 cm3 K mol-1 at 2 K. Magnetization at 3 K reaches 29.73 μB at 50 kOe without saturation. Zero-field ac susceptibility (1–999 Hz) shows in-phase and out-of-phase signals below ~15 K, indicating slow relaxation/SMM behavior. Arrhenius fit of τ = 1/(2πν) from χ'' maxima gives Ueff/kB = 6.17 K and τ0 = 4.9 × 10-5 s.",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "χMT",
            "value": 78.97,
            "unit": "cm3 K mol-1",
            "conditions": "300 K, 1 kOe"
          },
          {
            "property_type": "magnetic",
            "name": "χMT",
            "value": 58.12,
            "unit": "cm3 K mol-1",
            "conditions": "2 K, 1 kOe"
          },
          {
