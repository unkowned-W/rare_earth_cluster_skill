          {
            "name": "neodymium(III) trifluoromethanesulfonate",
            "formula": "Nd(OTf)3",
            "role": "metal source",
            "amount": "0.0349 g, 0.05 mmol"
          },
          {
            "name": "bis(aqua)tris(dibenzoylmethanido)neodymium(III)",
            "formula": "Nd(DBM)3(H2O)2",
            "role": "precursor",
            "amount": "0.085 g, 0.1 mmol"
          },
          {
            "name": "toluene",
            "formula": "C7H8",
            "role": "solvent",
            "amount": "2.0 mL plus 5.0 mL"
          }
        ],
        "solvents": [
          "toluene"
        ],
        "temperature": "reflux; crystallization at 0 °C",
        "time": "1 h reflux, then overnight at 0 °C",
