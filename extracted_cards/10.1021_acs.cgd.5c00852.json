            "name": "χT",
            "value": 16.85,
            "unit": "cm3 K mol−1",
            "conditions": "2 K, 1 kOe"
          },
          {
            "property_type": "magnetic",
            "name": "magnetization M",
            "value": 27.96,
            "unit": "Nβ",
            "conditions": "2 K, 70 kOe"
