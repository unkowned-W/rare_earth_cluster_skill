      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "H2L was prepared in situ by 1:1 condensation of o-vanillin and 1-amino-2-propanol in MeOH under reflux and used without isolation. To a MeCN–MeOH (3:1) solution of HL (0.1 mmol) was added solid Gd(NO3)3·6H2O (0.0451 g, 0.1 mmol) with stirring to give a light yellow solution. After 10 min, solid LiOH (0.0840 g, 0.2 mmol) was added and the mixture was stirred for 1 h. A MeOH solution of Ni(OAc)2·4H2O (0.0260 g, 0.1 mmol) was then added and the mixture was stirred for a further 7 h to give a green solution, which was filtered and left for slow evaporation in air. Green block crystals suitable for X-ray analysis formed after 5 days.",
        "reagents": [
          {
            "name": "2-[{(2-hydroxypropyl)imino}methyl]-6-methoxyphenol (HL, in situ)",
            "formula": "H2L",
            "role": "ligand",
            "amount": "1 mL, 0.1 mmol"
          },
          {
            "name": "gadolinium(III) nitrate hexahydrate",
            "formula": "Gd(NO3)3·6H2O",
            "role": "Ln source",
            "amount": "0.0451 g, 0.1 mmol"
          },
          {
            "name": "nickel(II) acetate tetrahydrate",
            "formula": "Ni(OAc)2·4H2O",
            "role": "Ni source / acetate source",
            "amount": "0.0260 g, 0.1 mmol"
          },
          {
            "name": "lithium hydroxide",
            "formula": "LiOH",
            "role": "base",
            "amount": "0.0840 g, 0.2 mmol"
          }
        ],
        "solvents": [
          "MeCN",
          "MeOH"
        ],
        "temperature": "room temperature (standard laboratory conditions)",
        "time": "10 min after Ln salt; 1 h after LiOH; 7 h after Ni salt; crystals after 5 days",
        "ph": null,
        "vessel_or_method": "sequential stirring in mixed solvent, filtration, slow evaporation in air",
        "workup_and_crystallization": "green solution filtered and kept for slow evaporation in air; green block crystals after 5 days",
        "yield": "0.045 g; 75% based on Gd"
      },
      "properties": {
        "reported": true,
        "property_type": "both",
        "summary": "Dc susceptibility of 1 is consistent with four Ni(II) and four Gd(III) ions and a low-T χT increase indicating ferromagnetic components; PHI fitting of a Ni2Gd2 model gives small J values (JNi–Ni antiferromagnetic). Complex 1 is not an SMM. UV–vis absorption in MeOH is reported.",
