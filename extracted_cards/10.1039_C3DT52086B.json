      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "Gd8 horseshoe is paramagnetic with weak antiferromagnetic Gd–Gd exchange (J = −0.03 cm−1). Room-temperature χMT is 61.9 emu K mol−1 (calc. 63). χMT is nearly constant to ~20 K then falls to 42.2 emu K mol−1 at 2 K. Magnetization reaches 53.7 μB at 7 T and 2 K, approaching the eight S = 7/2, g = 2 saturation. Magnetic entropy change ΔSm = 32.3 J kg−1 K−1 at 3 K for ΔH = 0–7 T (theoretical maximum 45.9 J kg−1 K−1). AC susceptibility shows no SMM behaviour.",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "χMT",
            "value": 61.9,
            "unit": "emu K mol−1",
            "conditions": "room temperature; polycrystalline sample"
          },
          {
            "property_type": "magnetic",
            "name": "χMT (calculated)",
            "value": 63,
            "unit": "emu K mol−1",
            "conditions": "eight S = 7/2, g = 2"
