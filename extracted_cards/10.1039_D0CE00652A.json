      "compound_label": "{Nd6}",
      "compound_name": "[Nd6(H2shi)6(2-pyca)12(CH3CN)4]",
      "formula": "C122H96Nd6N22O42",
      "ccdc_numbers": [],
      "ccdc_refcodes": [],
      "material_class": {
        "material_type": "cluster",
        "nuclearity": 6,
        "metal_composition": "homometallic",
        "rare_earth_elements": [
          "Nd"
