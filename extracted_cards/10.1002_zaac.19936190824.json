    {
      "compound_label": "Cs2[Lu3(CH3COO)10(OH)(H2O)]",
      "compound_name": "dicesium hydroxo-aqua-decakis(acetato)trilutetate",
      "formula": "Cs2[Lu3(CH3COO)10(OH)(H2O)]",
      "ccdc_numbers": [
        "1203766"
      ],
      "ccdc_refcodes": [
        "LASSON"
      ],
      "material_class": {
        "material_type": "cluster",
        "nuclearity": 3,
        "metal_composition": "homometallic",
        "rare_earth_elements": [
          "Lu"
        ],
        "other_metal_elements": [
          "Cs"
        ],
        "dimensionality": "0D",
        "structural_family": "trimeric acetate/hydroxo cluster, fragment of Ho(CH3COO)3-type chains"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "After repeated redissolution and recrystallization of initially obtained CsLu(CH3COO)4 (itself prepared from 100 mg Lu(CH3COO)3·4H2O and 45.3 mg Cs(CH3COO) in 15 ml dilute acetic acid) with distilled water, crystals of Cs2[Lu3(CH3COO)10(OH)(H2O)] were isolated. Attempts to prepare larger amounts remained unsuccessful; using CsOH·H2O, Cs(CH3COO) and Lu(CH3COO)3·4H2O in 1:1:3 molar ratio in distilled water under inert atmosphere gave CsLu(CH3COO)4 as the main product.",
        "reagents": [
          {
            "name": "cesium lutetium tetraacetate",
            "formula": "CsLu(CH3COO)4",
            "role": "starting material for recrystallization",
            "amount": "product from 100 mg Lu(CH3COO)3·4H2O + 45.3 mg Cs(CH3COO)"
          },
          {
            "name": "lutetium acetate tetrahydrate",
            "formula": "Lu(CH3COO)3·4H2O",
            "role": "rare-earth source (initial preparation)",
            "amount": "100 mg"
          },
          {
            "name": "cesium acetate",
            "formula": "Cs(CH3COO)",
            "role": "Cs source",
            "amount": "45.3 mg"
          },
          {
            "name": "cesium hydroxide monohydrate",
            "formula": "CsOH·H2O",
            "role": "base in unsuccessful scale-up attempt",
            "amount": "1:1:3 molar ratio vs. Cs(CH3COO):Lu acetate"
          }
        ],
        "solvents": [
          "distilled water",
          "dilute aqueous acetic acid (initial CsLu(CH3COO)4 preparation)"
        ],
        "temperature": "room temperature (implied for recrystallization)",
        "time": null,
        "ph": null,
        "vessel_or_method": "repeated dissolution/recrystallization from water; unsuccessful alternative under protective-gas atmosphere",
        "workup_and_crystallization": "repeated redissolution of CsLu(CH3COO)4 in distilled water and recrystallization; crystals isolated; bulk-scale attempts unsuccessful",
        "yield": null
      },
      "properties": {
        "reported": false,
