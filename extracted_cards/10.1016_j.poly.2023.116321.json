            "name": "quantum yield φem",
            "value": 1.51,
            "unit": "%",
            "conditions": "solid state"
          },
          {
            "property_type": "optical",
            "name": "theoretical quantum yield φLn",
            "value": 0.26,
            "unit": "%",
            "conditions": "φLn = τ/τ0 with natural lifetime of Eu3+ = 4620 μs"
          },
          {
            "property_type": "optical",
            "name": "energy transfer efficiency ηsens",
            "value": 5.81,
            "unit": "%",
            "conditions": "ηsens = φem/φLn"
