      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "0.044 g CrCl3·6H2O was dissolved by refluxing in 2 mL acetonitrile. After cooling to room temperature, 0.041 g N-methyldiethanolamine in 0.07 mL acetonitrile was added. The green slurry was stirred for 1.5 h, then 0.085 g Gd(NO3)3·xH2O in 0.2 mL, 0.068 g pivalic acid in 0.12 mL, 0.10 g triethylamine and 1 mL dichloromethane were added consecutively. The mixture turned purple, was stirred 24 h, filtered, treated with 0.5 mL dichloromethane, and left to evaporate slowly to give purple crystals. Remaining crystals were washed with MeCN:CH2Cl2 (2:1) and air-dried.",
        "reagents": [
