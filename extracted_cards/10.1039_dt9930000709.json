{
  "title": "A Lanthanide-templated Schiff-base Condensation Reaction to give a Trinuclear Macrocyclic Complex",
  "doi": "10.1039/dt9930000709",
  "list_of_rare_earth_compounds": [
    {
      "compound_label": "[La3L3(OH)2(NO3)4]·nH2O (n = 4 vacuum-dried; n = 7 crystal)",
      "compound_name": "trinuclear lanthanum (3+3) Schiff-base macrocyclic complex",
      "formula": "[La3L3(OH)2(NO3)4]·7H2O",
      "ccdc_numbers": [
        "1229720"
      ],
      "ccdc_refcodes": [
        "PEBKEM"
      ],
      "material_class": {
        "material_type": "cluster",
        "nuclearity": 3,
        "metal_composition": "homometallic",
        "rare_earth_elements": [
          "La"
        ],
        "other_metal_elements": [],
        "dimensionality": "0D",
        "structural_family": "(3+3) Schiff-base macrocycle encapsulating a La3 triangle with μ3-OH; pairs of La3 units are OH-bridged in the solid state to a hexalanthanum motif"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "La(NO3)3·xH2O (6.22 mmol) in MeOH (25 cm3) was added to 2,6-diacetylpyridine (1.019 g, 6.02 mmol) and 1,3-diamino-2-hydroxypropane (0.533 g, 6.14 mmol) in MeOH (25 cm3). The mixture was stirred and heated under reflux for 3 h. The pale yellow microcrystalline precipitate was filtered off, washed with cold MeOH and dried in vacuo (yield 5.29 g, 60%). Products were normally analytically pure as isolated; further purification by Soxhlet extraction with MeOH. Crystals of the heptahydrate suitable for X-ray diffraction were obtained from water.",
        "reagents": [
          {
            "name": "lanthanum(III) nitrate hydrate",
            "formula": "La(NO3)3·xH2O",
            "role": "metal template/starting salt",
            "amount": "6.22 mmol"
          },
          {
            "name": "2,6-diacetylpyridine",
            "formula": "C9H9NO2",
            "role": "diketone precursor of L3",
            "amount": "1.019 g, 6.02 mmol"
          },
          {
            "name": "1,3-diamino-2-hydroxypropane",
            "formula": "C3H10N2O",
            "role": "diamine precursor of L3",
            "amount": "0.533 g, 6.14 mmol"
          }
        ],
        "solvents": [
          "MeOH"
        ],
        "temperature": "reflux",
        "time": "3 h",
        "ph": null,
        "vessel_or_method": "stirred reflux; optional Soxhlet extraction with MeOH",
        "workup_and_crystallization": "pale yellow precipitate filtered, washed with cold MeOH, dried in vacuo; X-ray crystals from water (heptahydrate)",
        "yield": "5.29 g (60%)"
      },
      "properties": {
        "reported": false,
        "property_type": "none",
        "summary": "La3 complex is diamagnetic and was used as a host for Gd-doped ESR samples; no magnetic moment or optical luminescence data are reported for the pure La compound.",
        "measurements": []
      },
