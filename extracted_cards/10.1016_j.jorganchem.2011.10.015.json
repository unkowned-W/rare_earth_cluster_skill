          "Tm"
        ],
        "other_metal_elements": [],
        "dimensionality": "0D",
        "structural_family": "thulium semiquinonate/catecholate/hydroxyphenolate cluster"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Under Schlenk/evacuated-tube conditions, a red THF solution of 3,5-di-tert-butyl-o-benzoquinone (Q) was added to Tm shavings activated by iodine. Over 3 h the mixture turned dark blue. The solution was filtered, THF was removed in vacuo, and crystallization of the residue from DME gave blue crystals of 1 used for X-ray analysis. A blue amorphous Tm(SQ)3(DME)3 co-product was isolated from the mother liquor.",
        "reagents": [
          {
            "name": "3,5-di-tert-butyl-o-benzoquinone (Q)",
            "formula": "C14H20O2",
            "role": "ligand precursor",
            "amount": "0.394 g, 1.79 mmol"
          },
          {
            "name": "thulium shavings",
            "formula": "Tm",
            "role": "metal source",
            "amount": "0.127 g, 0.75 mmol"
          },
          {
            "name": "iodine",
            "formula": "I2",
            "role": "activator",
            "amount": "3 mg, 0.01 mmol"
          }
        ],
        "solvents": [
          "THF",
          "DME",
          "hexane"
        ],
        "temperature": "room temperature",
        "time": "3 h",
        "ph": null,
        "vessel_or_method": "evacuated tubes / Schlenk; filtration and vacuum condensation",
        "workup_and_crystallization": "filter; remove THF in vacuo; crystallize residue from DME to give blue crystals of 1 (0.107 g)",
        "yield": "0.107 g, 18%"
      },
      "properties": {
        "reported": true,
        "property_type": "optical",
        "summary": "Related Tm(SQ)3 species absorb at 305 and 380 nm (vibrational structure 348/363/378 nm) plus a weak 750 nm LMCT band; compound 1 itself is a structurally characterized blue cluster from that family. No metal-centered luminescence is reported for Tm.",
        "measurements": [
          {
            "property_type": "optical",
            "name": "UV-vis absorption maxima of related Tm(SQ)3",
            "value": "305, 380, 750",
            "unit": "nm",
            "conditions": "THF solution; Fig. 4"
          }
        ]
      },
