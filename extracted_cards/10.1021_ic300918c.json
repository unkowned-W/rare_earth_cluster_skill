      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "To a stirred solution of H2L (0.115 g, 0.3 mmol) in absolute EtOH (8 mL) were added Et3N (100 μL) and a solution of NdCl3·6H2O (0.3 mmol, 0.107 g) in absolute EtOH (8 mL). The mixture was refluxed for 2 h, cooled to room temperature, and filtered. Diethyl ether was allowed to diffuse slowly into the filtrate at room temperature, giving pale yellow microcrystals of 1 in a few weeks.",
        "reagents": [
          {
            "name": "H2L (N,N′-bis(3-methoxysalicylidene)cyclohexane-1,2-diamine)",
            "formula": "C22H26N2O4",
            "role": "ligand",
            "amount": "0.115 g, 0.3 mmol"
          },
          {
            "name": "triethylamine",
            "formula": "Et3N",
            "role": "base",
            "amount": "100 μL"
          },
          {
            "name": "neodymium(III) chloride hexahydrate",
            "formula": "NdCl3·6H2O",
            "role": "metal source",
            "amount": "0.3 mmol, 0.107 g"
          }
        ],
        "solvents": [
          "absolute EtOH",
          "diethyl ether"
        ],
        "temperature": "reflux then room temperature",
        "time": "reflux 2 h; crystallization over a few weeks",
        "ph": null,
        "vessel_or_method": "solution reflux followed by diethyl ether vapor diffusion",
        "workup_and_crystallization": "cooled, filtered; Et2O vapor diffusion into the filtrate at room temperature afforded pale yellow microcrystals (single crystals of 1·6EtOH used for XRD)",
        "yield": "0.080 g, 47%"
      },
      "properties": {
        "reported": true,
        "property_type": "both",
        "summary": "Characteristic Nd3+ NIR luminescence is sensitized from 1LC/3LC of the Salen ligand (lifetimes ~1.5 μs; estimated ΦLn = 0.62%). Weak residual visible emission is observed. DC susceptibility (1.8–300 K, 1000 Oe) shows χmT decreasing from 4.79 cm3 K mol−1 at 300 K to 1.72 cm3 K mol−1 at 1.8 K, with Curie–Weiss C = 4.89 cm3 mol−1 K and θ = −8.59 K, consistent with crystal-field depopulation and antiferromagnetic Ln···Ln interaction.",
        "measurements": [
          {
            "property_type": "optical",
            "name": "absorption λab",
            "value": "228 (2.89), 268 (1.31), 342 (0.45)",
            "unit": "nm [log(ε/dm3 mol−1 cm−1)]",
            "conditions": "1×10−5 M in MeCN, room temperature"
          },
          {
            "property_type": "optical",
            "name": "excitation λex",
            "value": "374 (sh), 401",
            "unit": "nm",
            "conditions": "MeCN solution"
          },
          {
            "property_type": "optical",
            "name": "emission λem (visible residual)",
            "value": "525 (weak)",
            "unit": "nm",
            "conditions": "MeCN, room temperature"
          },
          {
            "property_type": "optical",
            "name": "NIR emission λem (τ)",
            "value": "888 (1.53 μs), 1068 (1.57 μs), 1361 (1.55 μs)",
            "unit": "nm (μs)",
            "conditions": "MeCN; monoexponential NIR decay"
          },
          {
            "property_type": "optical",
            "name": "intrinsic quantum yield ΦLn",
            "value": 0.62,
            "unit": "%",
            "conditions": "estimated as τobs/τ0 with τ0(Nd3+) = 0.25 ms"
