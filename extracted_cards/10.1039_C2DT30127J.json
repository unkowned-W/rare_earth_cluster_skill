  "list_of_rare_earth_compounds": [
    {
      "compound_label": "1",
      "compound_name": "[Mn4Gd4(OH)6(H2L)2(H3L)2(PhCO2)2(N3)2(MeOH)4]Cl1.6(N3)0.4(NO3)2·2.4H2O·1.6MeOH",
      "formula": "[Mn4Gd4(OH)6(H2L)2(H3L)2(PhCO2)2(N3)2(MeOH)4]Cl1.6(N3)0.4(NO3)2·2.4H2O·1.6MeOH",
      "ccdc_numbers": [
        "863299"
      ],
      "ccdc_refcodes": [
        "KAXDOE"
      ],
      "material_class": {
        "material_type": "cluster",
        "nuclearity": 8,
        "metal_composition": "heterometallic",
        "rare_earth_elements": [
          "Gd"
        ],
        "other_metal_elements": [
          "Mn"
        ],
        "dimensionality": "0D",
        "structural_family": "Mn4Ln4 octanuclear cluster with nearly planar core of six edge-sharing triangles"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Under aerobic conditions at room temperature, a methanol solution of bis-tris (H5L), benzoic acid and NaN3 was added to a methanol solution of MnCl2·4H2O and Gd(NO3)3·6H2O (molecular ratio 1:1:1:1:4). After 2 h stirring the mixture was left undisturbed for 2 weeks, giving light-brown rectangular block crystals of 1, which were washed with water and dried in air.",
        "reagents": [
          {
            "name": "manganese(II) chloride tetrahydrate",
            "formula": "MnCl2·4H2O",
            "role": "Mn source",
            "amount": "0.200 g, 1.0 mmol"
          },
          {
            "name": "gadolinium(III) nitrate hexahydrate",
            "formula": "Gd(NO3)3·6H2O",
            "role": "Ln source",
            "amount": "0.456 g, 1.0 mmol"
          },
          {
            "name": "bis-tris (H5L)",
            "formula": "C8H19NO5",
            "role": "ligand",
            "amount": "0.209 g, 1 mmol"
          },
          {
            "name": "benzoic acid",
            "formula": "PhCO2H",
            "role": "coligand",
            "amount": "0.112 g, 1 mmol"
          },
          {
            "name": "sodium azide",
            "formula": "NaN3",
            "role": "azide source",
            "amount": "0.240 g, 4.0 mmol"
          }
        ],
        "solvents": [
          "MeOH"
        ],
        "temperature": "room temperature",
        "time": "2 h stirring, then 2 weeks undisturbed",
        "ph": null,
        "vessel_or_method": "aerobic solution reaction in methanol",
        "workup_and_crystallization": "left undisturbed for 2 weeks; light-brown rectangular block crystals washed with water and dried in air",
        "yield": "78% based on Gd"
      },
      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "Weak antiferromagnetic coupling within the Mn4Gd4 cluster. χT falls from 42.10 cm3 K mol−1 at 300 K to 8.86 cm3 K mol−1 at 1.8 K; Weiss constant θ = −4.7 K. Magnetisation at 2 K and 70 kOe is 35.0 μB, below the 44 μB saturation expected for four S=7/2 GdIII and four S=2 MnIII. No out-of-phase ac signal.",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "χT expected for non-interacting ions",
            "value": 43.5,
            "unit": "cm3 K mol−1",
            "conditions": "g=2 for MnIII"
          },
          {
            "property_type": "magnetic",
            "name": "χT",
            "value": 42.1,
            "unit": "cm3 K mol−1",
            "conditions": "300 K, dc susceptibility"
          },
          {
            "property_type": "magnetic",
            "name": "χT",
            "value": 8.86,
            "unit": "cm3 K mol−1",
            "conditions": "1.8 K"
          },
          {
            "property_type": "magnetic",
            "name": "Weiss constant θ",
            "value": -4.7,
            "unit": "K",
            "conditions": "Curie–Weiss fit above 30 K"
          },
          {
            "property_type": "magnetic",
            "name": "magnetisation M",
            "value": 35.0,
            "unit": "μB",
            "conditions": "2 K, 7 T (70 kOe)"
          }
        ]
      },
