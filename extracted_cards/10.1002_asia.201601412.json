        "yield": "0.0105 g (23%, based on Dy)"
      },
      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "Dc χMT at 300 K is 84.2 cm3 K mol−1. χMT decreases on cooling, consistent with weak antiferromagnetic coupling (Weiss constant −3.4 K). Magnetization at 2.0 K reaches 28.3 Nβ at 70 kOe, well below 60 Nβ, with a small hysteresis at 2.0 K. Zero-field ac susceptibility is strongly frequency dependent (SMM). Arrhenius fit above 10 K gives Ueff = 85(1) K and τ0 = 3.9(5)×10−7 s; QTM dominates below 2.5 K. Cole–Cole α ≈ 0.10–0.31 in the thermal regime.",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "χMT (300 K)",
            "value": 84.2,
            "unit": "cm3 K mol−1",
            "conditions": "1.0 kOe; polycrystalline; 300–2 K dc study"
          },
          {
            "property_type": "magnetic",
            "name": "Weiss constant",
            "value": -3.4,
            "unit": "K",
            "conditions": "Curie–Weiss analysis of dc susceptibility"
          },
          {
