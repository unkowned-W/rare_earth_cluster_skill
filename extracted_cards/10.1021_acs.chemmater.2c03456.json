            "name": "water",
            "formula": "H2O",
            "role": "reaction medium",
            "amount": "100 μL (5.6 mmol)"
          },
          {
            "name": "propionic acid",
            "formula": "CH3CH2CO2H",
            "role": "propionate precursor",
            "amount": "30 μL (0.4 mmol)"
          },
          {
            "name": "cerium(IV) ammonium nitrate",
            "formula": "(NH4)2Ce(NO3)6",
            "role": "cerium precursor",
            "amount": "0.055 g (0.1 mmol)"
          },
          {
            "name": "ammonium iodide",
            "formula": "NH4I",
            "role": "additive",
            "amount": "0.015 g (0.1 mmol)"
          },
          {
            "name": "acetonitrile",
            "formula": "CH3CN",
            "role": "crystallization solvent",
            "amount": "2 mL (38.3 mmol)"
          }
        ],
        "solvents": [
          "pyridine",
          "water",
          "acetonitrile"
        ],
