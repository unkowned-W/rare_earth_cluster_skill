      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Under N2, NH(iPr)2 (13.5 mL, 96.5 mmol) in toluene (200 mL) was stirred under CO2 until amine carbonation equilibrium was reached. [LaCl3(DME)] (4.57 g, 13.6 mmol) was added and the suspension was stirred under CO2 for 2 days, then filtered to discard NH2iPr2Cl. The filtrate was concentrated to dryness and the colorless residue was dried in vacuo at room temperature for 3 h, treated with heptane (25 mL), filtered, and dried in vacuo.",
        "reagents": [
          {
            "name": "diisopropylamine",
            "formula": "NH(iPr)2",
            "role": "ligand precursor",
            "amount": "13.5 mL, 96.5 mmol"
          },
          {
            "name": "carbon dioxide",
            "formula": "CO2",
            "role": "carbamation reagent",
            "amount": null
          },
          {
            "name": "lanthanum chloride DME adduct",
            "formula": "[LaCl3(DME)]",
            "role": "metal source",
            "amount": "4.57 g, 13.6 mmol"
          }
        ],
        "solvents": [
          "toluene",
          "heptane"
        ],
        "temperature": "room temperature",
        "time": "2 days stirring under CO2; 3 h drying in vacuo",
        "ph": null,
        "vessel_or_method": "CO2-saturated amine carbonation then salt metathesis under dinitrogen",
        "workup_and_crystallization": "Filtration to remove ammonium chloride, concentration to dryness, heptane wash, vacuum drying.",
        "yield": "3.78 g, 48.6%"
      },
