      },
      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "Dc susceptibility of 1–4 (2–300 K, 1000 Oe) shows χMT(300 K) slightly below 19 free Dy(III) ions and a rapid low-T drop attributed to Stark depopulation and weak antiferromagnetic interactions. Magnetization vs field is anisotropic/nonsuperimposable. Ac susceptibility (2.5 Oe, 1–1000 Hz, 0 Oe dc) shows slow magnetic relaxation for 1, 3, and 4 (not 2), with 3 most prominent.",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "χMT",
            "value": 251.27,
            "unit": "cm3 K mol−1",
            "conditions": "300 K, 1000 Oe dc"
          },
