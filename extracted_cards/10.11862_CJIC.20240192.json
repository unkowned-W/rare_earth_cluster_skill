      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Complexes 1–3 were prepared analogously by a solvothermal route. Ln(dbm)3·6H2O (0.05 mmol; Ln = Eu for 1), H2L (0.05 mmol, 0.0151 g) and NaOH (0.05 mmol, 0.002 g) were placed in a 20 mL glass vial, then methanol (150 μL) and dichloromethane (5 mL) were added. The mixture was stirred at room temperature for 30 min, then kept at 70 °C in a reaction oven for 2 d and cooled to room temperature. The precipitated yellow block crystals were washed three times with methanol and dried. Yield of 1: 42% based on Eu(dbm)3·6H2O.",
        "reagents": [
          {
            "name": "Eu(dbm)3·6H2O",
