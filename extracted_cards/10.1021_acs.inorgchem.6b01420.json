      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Y(dbm)3·2H2O (0.03 mmol) was dissolved in 15 mL of acetonitrile. Then 5 mL of a CH2Cl2 solution of HL (0.0075 g, 0.03 mmol) was added to the stirred acetonitrile solution, and the mixture was stirred for 5 h at room temperature. The solution was filtered, and yellow block crystals suitable for single-crystal X-ray diffraction were isolated by keeping the filtrate at ambient conditions for 1 week.",
        "reagents": [
          {
            "name": "Y(dbm)3·2H2O",
            "formula": "Y(dbm)3·2H2O",
            "role": "metal precursor",
            "amount": "0.03 mmol"
          },
          {
            "name": "HL (5-(4-fluorobenzylidene)-8-hydroxyquinoline)",
            "formula": "C16H11FN2O",
            "role": "ligand",
            "amount": "0.0075 g, 0.03 mmol"
          }
        ],
        "solvents": [
          "acetonitrile",
          "CH2Cl2"
        ],
        "temperature": "room temperature",
        "time": "stirred 5 h; crystals after 1 week",
        "ph": null,
        "vessel_or_method": "solution mixing, filtration, ambient crystallization",
        "workup_and_crystallization": "filtered; yellow block crystals grown from the filtrate at ambient conditions for 1 week",
        "yield": "0.038 g, 43.6% based on Y"
      },
      "properties": {
        "reported": true,
        "property_type": "optical",
        "summary": "In methanol at room temperature, 1 shows ligand-centered π–π* emission matching free HL when excited at 250 nm; Y3+ does not give characteristic metal emission or enhance ligand luminescence.",
        "measurements": [
          {
            "property_type": "optical",
            "name": "excitation wavelength",
