      "compound_label": "{Sm20}",
      "compound_name": "icosanuclear samarium(III) molecular cluster-aggregate [Sm20(chp)30(CO3)12(NO3)6(H2O)6]·H2O",
      "formula": "[Sm20(chp)30(CO3)12(NO3)6(H2O)6]·H2O",
      "ccdc_numbers": [
        "2023765"
      ],
      "ccdc_refcodes": [
        "UMIKAF"
      ],
      "material_class": {
        "material_type": "cluster",
        "nuclearity": 20,
        "metal_composition": "homometallic",
        "rare_earth_elements": [
          "Sm"
        ],
        "other_metal_elements": [],
        "dimensionality": "0D",
        "structural_family": "Ln20 molecular cluster-aggregate (pentagonal dodecahedron metal core)"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": false,
        "si_used": true,
        "procedure": "All manipulations under aerobic conditions. Homometallic cluster-aggregates prepared by a previously reported method: 1.00 mmol of Sm(NO3)3·6H2O and 6-chloro-2-pyridinol (0.130 g, 1.00 mmol) were added in 20 mL of MeOH/MeCN (1:1), followed by triethylamine (0.139 mL, 1.00 mmol). After 12 h the solution was filtered and left undisturbed in an open vial for solvent evaporation at room temperature. Colorless block-like single crystals formed in 5–10 days. Atmospheric CO2 capture templates the cluster via carbonate.",
        "reagents": [
          {
            "name": "samarium(III) nitrate hexahydrate",
            "formula": "Sm(NO3)3·6H2O",
            "role": "metal source",
            "amount": "1.00 mmol (reported as 0.444 mg)"
          },
          {
            "name": "6-chloro-2-pyridinol",
            "formula": "C5H4ClNO",
            "role": "bridging ligand (chpH)",
            "amount": "0.130 g, 1.00 mmol"
          },
          {
            "name": "triethylamine",
            "formula": "NEt3",
            "role": "base",
            "amount": "0.139 mL, 1.00 mmol"
          }
        ],
        "solvents": [
          "MeOH",
          "MeCN"
        ],
        "temperature": "room temperature (crystallization)",
        "time": "12 h reaction; crystals in 5–10 days",
        "ph": null,
        "vessel_or_method": "open vial, solvent evaporation under aerobic conditions",
        "workup_and_crystallization": "filter after 12 h; leave undisturbed for evaporation; colorless block crystals",
        "yield": "25–35% (range for homometallic Ln20 series)"
      },
      "properties": {
        "reported": true,
        "property_type": "optical",
        "summary": "No characteristic Sm(III) 4f–4f emission was observed, attributed to non-radiative deactivation by O–H oscillators. Heterometallic Sm/Tb analogues are luminescent (see those cards).",
        "measurements": []
      },
