          "methanol"
        ],
        "temperature": "90 °C",
        "time": "stir 10 min, then 7 days",
        "ph": null,
        "vessel_or_method": "sealed flask, oven heating (one-pot solvothermal-type reaction)",
        "workup_and_crystallization": "Orange crystals collected by filtration and dried in air.",
