      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Same procedure used for all complexes; described in detail for 1. GdCl3·6H2O (0.1 mmol, 38 mg), CdCl2·H2O (0.11 mmol, 22 mg) and H2L (0.2 mmol, 48.6 mg) were stirred in MeOH (20 mL) for 20 min with Et3N (0.36 mmol, 36 mg). THF (20 mL) was added to the turbid yellow solution to give a clear orange-red solution. Rod-shaped orange crystals of 1 formed within 3–4 days. CdCl2 is used to suppress further hydrolysis of the lanthanide salt and is not incorporated in the product.",
        "reagents": [
          {
            "name": "gadolinium(III) chloride hexahydrate",
            "formula": "GdCl3·6H2O",
            "role": "metal source",
            "amount": "0.1 mmol, 38 mg"
          },
          {
            "name": "cadmium(II) chloride monohydrate",
            "formula": "CdCl2·H2O",
            "role": "additive (hydrolysis control)",
            "amount": "0.11 mmol, 22 mg"
          },
          {
            "name": "(E)-2-(2-hydroxy-3-methoxybenzylideneamino)phenol",
            "formula": "H2L",
            "role": "ligand",
            "amount": "0.2 mmol, 48.6 mg"
          },
          {
            "name": "triethylamine",
            "formula": "Et3N",
            "role": "base",
            "amount": "0.36 mmol, 36 mg"
          }
        ],
        "solvents": [
          "MeOH",
          "THF"
        ],
        "temperature": null,
        "time": "stirred 20 min; crystals in 3–4 days",
        "ph": null,
        "vessel_or_method": "solution stirring followed by slow evaporation/crystallization",
        "workup_and_crystallization": "THF added to give a clear orange-red solution; rod-shaped orange crystals obtained; crystals separated by filtration and washed with MeOH/THF",
        "yield": "68%"
      },
      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "Isostructural Gd4 defect-dicubane cluster. χT is nearly constant from 300 to 25 K then falls to 13.66 cm3 K mol−1 at 1.8 K, indicating weak intramolecular antiferromagnetic coupling. Curie–Weiss fit above 15 K gives θ = −2.45 K. Magnetization at 2 K and 7 T is 28.03 μB. No slow relaxation of magnetization (ac).",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "χT (300 K)",
            "value": 31.59,
            "unit": "cm3 K mol−1",
            "conditions": "dc field 1000 Oe; powder; expected 31.50 for four non-interacting GdIII"
          },
          {
            "property_type": "magnetic",
            "name": "χT (1.8 K)",
            "value": 13.66,
            "unit": "cm3 K mol−1",
            "conditions": "dc field 1000 Oe"
          },
          {
            "property_type": "magnetic",
            "name": "Curie constant C",
            "value": 31.85,
            "unit": "cm3 K mol−1",
            "conditions": "Curie–Weiss fit above 15 K"
          },
          {
            "property_type": "magnetic",
            "name": "Weiss constant θ",
            "value": -2.45,
            "unit": "K",
            "conditions": "Curie–Weiss fit above 15 K"
          },
          {
            "property_type": "magnetic",
            "name": "magnetization",
            "value": 28.03,
            "unit": "μB",
            "conditions": "2 K, 7 T"
          }
        ]
