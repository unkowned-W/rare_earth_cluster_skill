      "synthesis": {
        "main_text_has_explicit_synthesis": false,
        "si_used": true,
        "procedure": "Mix K7HNb6O19·13H2O, Dy(Ac)3·6H2O and risedronic acid in Na2CO3/NaHCO3 buffer. Stir for 1 hour, seal in a 20 mL glass vial and heat at 80 °C for 3 days. After cooling, filter and keep the filtrate at room temperature for two weeks to obtain colorless rod-shaped crystals. The SI reports pH 8.0 before and 8.2 after reaction.",
        "reagents": [
          {
            "name": "Potassium hexaniobate hydrate",
            "formula": "K7HNb6O19·13H2O",
            "role": "polyoxoniobate precursor",
            "amount": "0.375 g, 0.27 mmol"
          },
          {
            "name": "Dysprosium acetate hexahydrate",
            "formula": "Dy(Ac)3·6H2O",
            "role": "dysprosium source",
            "amount": "0.158 g, 3.84 mmol (as reported)"
          },
          {
            "name": "Risedronic acid",
            "formula": null,
            "role": "organophosphonate ligand",
            "amount": "0.180 g, 6.36 mmol (as reported)"
          },
          {
            "name": "Sodium carbonate/sodium bicarbonate buffer",
            "formula": "Na2CO3/NaHCO3",
            "role": "reaction medium",
            "amount": "8 mL, 0.05 M"
          }
        ],
        "solvents": [
          "Aqueous Na2CO3/NaHCO3 buffer"
        ],
        "temperature": "80 °C; then room temperature",
        "time": "1 hour stirring; 3 days heating; 2 weeks crystallization",
        "ph": "Buffer pH 10.5; reported reaction-mixture pH 8.0 before and 8.2 after heating",
        "vessel_or_method": "Sealed 20 mL glass vial",
        "workup_and_crystallization": "Cool, filter, and leave filtrate at room temperature for two weeks.",
        "yield": "Approximately 30 mg (8.1%, based on K7HNb6O19·13H2O)"
      },
      "properties": {
        "reported": true,
        "property_type": "optical",
        "summary": "Reversible photochromism: initially colorless material turns blue under irradiation and slowly returns to colorless in the dark. Irradiation produces a broad visible absorption attributed to NbIV-to-NbV intervalence charge transfer.",
        "measurements": [
          {
            "property_type": "optical",
            "name": "Photoinduced absorption maximum",
            "value": "approximately 680",
            "unit": "nm",
            "conditions": "After irradiation with a 500 W Hg lamp, approximately 110 mW cm−2"
          },
          {
            "property_type": "optical",
            "name": "Coloration saturation time",
            "value": "16",
            "unit": "min",
            "conditions": "Hg-lamp irradiation"
          },
          {
            "property_type": "optical",
            "name": "Photochromic apparent rate constant",
            "value": "1.93 × 10−3",
            "unit": "s−1",
            "conditions": "Fitted absorbance change at 680 nm"
          },
          {
            "property_type": "optical",
            "name": "Calculated colorability",
            "value": "3.50",
            "unit": null,
            "conditions": "Reported comparison of irradiated Ln analogues"
          }
        ]
      },
