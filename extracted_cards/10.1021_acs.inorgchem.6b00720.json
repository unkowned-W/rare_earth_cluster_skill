            "formula": "NiCl2·6H2O",
            "role": "metal source",
            "amount": "0.1 mmol, 24 mg"
          },
          {
            "name": "yttrium(III) chloride hydrate",
            "formula": "YCl3·xH2O",
            "role": "metal source",
            "amount": "0.1 mmol"
          }
        ],
        "solvents": [
          "MeCN",
          "Et2O"
        ],
        "temperature": "reflux; dried at 60 °C",
        "time": "10 min pre-stir, then reflux 2 h; dried overnight",
        "ph": null,
