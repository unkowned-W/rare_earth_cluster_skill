      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Under aerobic conditions, solid Eu(NO3)3·5H2O (0.21 g, 0.5 mmol) was added to a stirred colorless solution of pdmH2 (0.14 g, 1.0 mmol) and NEt3 (0.14 mL, 1.0 mmol) in MeOH (20 mL). The pale yellow solution was stirred at room temperature for about 20 min, filtered, and the filtrate was layered with Et2O (40 mL). After 2 days, colorless prismatic crystals of 1 were collected, washed with cold MeOH (2 × 2 mL) and Et2O (2 × 3 mL), and dried in air. The air-dried solid analyzed as solvent-free 1; crystals were not of sufficient quality for a complete X-ray data set.",
        "reagents": [
          {
            "name": "europium(III) nitrate pentahydrate",
            "formula": "Eu(NO3)3·5H2O",
            "role": "metal source",
            "amount": "0.21 g, 0.5 mmol"
          },
          {
            "name": "pyridine-2,6-dimethanol",
            "formula": "pdmH2",
            "role": "chelating/bridging ligand",
            "amount": "0.14 g, 1.0 mmol"
          },
          {
            "name": "triethylamine",
            "formula": "NEt3",
            "role": "base",
            "amount": "0.14 mL, 1.0 mmol"
          }
        ],
        "solvents": [
          "MeOH",
          "Et2O"
        ],
        "temperature": "room temperature",
        "time": "stirred ~20 min; crystals after 2 days",
        "ph": null,
        "vessel_or_method": "aerobic solution synthesis; filtration and Et2O layering",
        "workup_and_crystallization": "filtrate layered with Et2O (40 mL); crystals collected by filtration, washed with cold MeOH (2 × 2 mL) and Et2O (2 × 3 mL), dried in air",
        "yield": "60%"
      },
      "properties": {
        "reported": true,
        "property_type": "optical",
        "summary": "Solid-state photoluminescence at room temperature: upon excitation at 396 nm, 1 shows relatively strong red Eu(III) emission assigned to 5D0 → 7FJ transitions. Magnetic susceptibility of 1 was not measured (Eu(III) 7F0, J = 0).",
