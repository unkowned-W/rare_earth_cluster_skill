      "compound_label": "1",
      "compound_name": "tetrapyridinium [Gd4(μ3-OH)(O3P tBu)3(HO3P tBu)(O2C tBu)2(NO3)6] pyridine solvate",
      "formula": "[pyH]4[Gd4(μ3-OH)(O3P tBu)3(HO3P tBu)(O2C tBu)2(NO3)6]·py",
