      "compound_label": "1",
      "compound_name": "pentanuclear dysprosium cluster 1",
      "formula": "C65H55Dy5N12O22·CH4O",
      "ccdc_numbers": [
        "2061004"
      ],
      "ccdc_refcodes": [
        "TUNROM01"
      ],
      "material_class": {
        "material_type": "cluster",
        "nuclearity": 5,
        "metal_composition": "homometallic",
        "rare_earth_elements": [
          "Dy"
        ],
        "other_metal_elements": [],
        "dimensionality": "0D",
        "structural_family": "pentanuclear Dy5 cluster (P-1)"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "H4L1 (0.05 mmol, ~25 mg), Dy(OAc)3·6H2O (0.4 mmol, ~180 mg), 1.5 mL CH3OH, 0.5 mL CH3CN, and 0.15 mL HOAc were added to a ~25 cm Pyrex tube. The mixed-system pH was about 6.4. The mixture was shaken and sonicated for 15 min, sealed, heated at 80 °C for 3 days, then slowly cooled to room temperature to give yellow lumpy crystals.",
        "reagents": [
          {
            "name": "H4L1 (N'2,N'9-bis((E)-2-hydroxybenzylidene)-1,10-phenanthroline-2,9-dicarbohydrazide)",
            "formula": "C26H18N6O4",
            "role": "ligand",
            "amount": "0.05 mmol (~25 mg)"
          },
          {
            "name": "dysprosium(III) acetate hexahydrate",
            "formula": "Dy(OAc)3·6H2O",
            "role": "metal source",
            "amount": "0.4 mmol (~180 mg)"
          },
          {
            "name": "acetic acid",
            "formula": "HOAc",
            "role": "pH adjuster",
            "amount": "0.15 mL"
          }
        ],
        "solvents": [
          "CH3OH",
          "CH3CN"
        ],
        "temperature": "80 °C then cool to room temperature",
        "time": "sonicate 15 min; heat 3 days",
        "ph": "6.4",
        "vessel_or_method": "sealed Pyrex tube solvothermal reaction",
        "workup_and_crystallization": "slow cooling precipitated yellow lumpy crystals",
        "yield": "about 38.3% based on ligand (EA calc. C66H57Dy5N12O23)"
      },
      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "χmT at 300 K is 69.87 cm3 mol−1 K (five Dy(III) theoretical 70.85). Magnetization at 2 K/5 T is 27.7 Nβ. Frequency-dependent AC susceptibility under zero field without peaks; Ueff = 2.0 K and τ0 = 5.6×10−6 s. No evident hysteresis at 2 K.",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "χmT",
            "value": 69.87,
            "unit": "cm3 mol−1 K",
            "conditions": "300 K, 1000 Oe DC"
          },
          {
            "property_type": "magnetic",
            "name": "magnetization",
            "value": 27.7,
            "unit": "Nβ",
            "conditions": "2 K, 5 T"
          },
          {
            "property_type": "magnetic",
            "name": "Ueff",
            "value": 2.0,
            "unit": "K",
            "conditions": "zero-field AC; Debye ln(χ''/χ') fit"
          },
          {
            "property_type": "magnetic",
            "name": "τ0",
            "value": "5.6e-6",
            "unit": "s",
            "conditions": "zero-field AC"
          }
        ]
