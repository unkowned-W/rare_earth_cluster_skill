      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Under aerobic ambient conditions, mpkoH (0.24 g, 2.0 mmol) in MeCN/CH2Cl2 (22/3 mL) was treated with YCl3·6H2O (0.61 g, 2.0 mmol) then NMe4OH (316 μL, 4.0 mmol) in MeOH. After 10 min stirring, Mn(O2CPh)2·4H2O (0.74 g, 2.0 mmol) was added and the dark brown solution was stirred for 6 h, filtered, and left to evaporate slowly at ambient temperature. Dark brown plate-like crystals grew over one week, were collected, washed with Et2O, and dried under vacuum for 3 h (yield 25% based on Mn; EA as 1·H2O).",
        "reagents": [
          {
            "name": "methyl-2-pyridyl-ketone oxime (mpkoH)",
            "formula": "C7H8N2O",
            "role": "ligand",
            "amount": "0.24 g, 2.0 mmol"
          },
          {
            "name": "yttrium(III) chloride hexahydrate",
            "formula": "YCl3·6H2O",
            "role": "metal source",
            "amount": "0.61 g, 2.0 mmol"
          },
          {
            "name": "tetramethylammonium hydroxide",
            "formula": "NMe4OH",
            "role": "base",
            "amount": "316 μL, 4.0 mmol in MeOH"
          },
          {
            "name": "manganese(II) benzoate tetrahydrate",
            "formula": "Mn(O2CPh)2·4H2O",
            "role": "metal source",
            "amount": "0.74 g, 2.0 mmol"
          }
        ],
        "solvents": [
          "MeCN",
          "CH2Cl2",
          "MeOH",
          "Et2O"
        ],
        "temperature": "ambient temperature",
        "time": "stirred 6 h; crystals over 1 week; vacuum dried 3 h",
        "ph": null,
        "vessel_or_method": "aerobic solution reaction with filtration and slow evaporation",
        "workup_and_crystallization": "filtered; filtrate concentrated by slow evaporation; crystals collected, washed with Et2O, dried under vacuum 3 h",
        "yield": "25% based on Mn"
      },
