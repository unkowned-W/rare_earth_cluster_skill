          "water"
        ],
        "temperature": "100 °C (dissolution), then slow cooling",
        "time": "few minutes heating; crystals after 48 h",
        "ph": null,
        "vessel_or_method": "aqueous heating then slow evaporation",
        "workup_and_crystallization": "slow cooling of the clear solution followed by slow evaporation gave colorless X-ray quality crystals",
        "yield": "60–80%"
