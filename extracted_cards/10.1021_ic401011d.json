        "temperature": "reflux, then room temperature",
        "time": "dropwise addition 20 min; reflux 1 h; crystallization 15 days",
        "ph": null,
        "vessel_or_method": "aerobic reflux then sealed vial standing",
        "workup_and_crystallization": "cooled to RT, stood undisturbed in a sealed vial; orange needles after 15 days; filtered, washed with MeCN, dried in air",
        "yield": "40%"
