      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Under inert atmosphere, o-pbdH (0.228 g, 0.0014 mol) was dissolved in dry methanol (40 mL) and deprotonated with dropwise triethylamine (0.2 mL, 1.4 mmol). HoCl3·6H2O (0.0007 mol), prepared from Ho2O3 and aqueous HCl, was added and the mixture heated at reflux for 72 h. Solvent was evaporated, the solid redissolved in acetonitrile (40 mL) to remove excess ligand, centrifuged (7500 rpm, 5 min), and the insoluble residue dissolved in pyridine (40 mL) and centrifuged again. The supernatant was evaporated and the solid washed with diethyl ether (3 × 20 mL). Crystals of 1 formed by vapour diffusion of hexane into ethanol after 6 weeks. Yield 0.66 g (63%).",
        "reagents": [
          {
            "name": "1-(2-pyridinyl)-1,3-butanedione (o-pbdH)",
