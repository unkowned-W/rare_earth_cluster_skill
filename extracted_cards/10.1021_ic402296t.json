        "vessel_or_method": "10 mL Teflon-lined autoclave, solvothermal",
        "workup_and_crystallization": "Yellow X-ray-quality crystals obtained directly from the autoclave.",
        "yield": "35% (based on lanthanide pivalate)"
      },
      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "Room-temperature χMT for 1–5 is close to 54.1 emu K mol−1 expected for six S=1 (g=2.2) NiII and six S=7/2 (g=2.00) GdIII. χMT is nearly constant to ~50 K then rises to a maximum near 15 K. Low-T magnetization saturates near 55 μB. Compound 1 shows the largest mass-specific MCE (−ΔSM = 32 J kg−1 K−1) and a slightly higher 2 K magnetization than the {Ni6Y6} analogue plus six GdIII, suggesting weak ferromagnetic Ni···Gd exchange.",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "χMT (calculated RT sum for 1–5)",
            "value": 54.1,
            "unit": "emu K mol−1",
            "conditions": "six S=1, g=2.2 NiII and six S=7/2, g=2.00 GdIII"
          },
          {
            "property_type": "magnetic",
            "name": "Msat",
            "value": "~55",
            "unit": "μB",
            "conditions": "low temperature; applied field to saturation"
          },
          {
            "property_type": "magnetic",
            "name": "−ΔSM",
            "value": 32,
            "unit": "J kg−1 K−1",
            "conditions": "ΔH = 0–7 T, 3 K"
          },
          {
            "property_type": "magnetic",
            "name": "−ΔSM",
            "value": 116.1,
            "unit": "J mol−1 K−1",
            "conditions": "ΔH = 0–7 T, 3 K"
          }
        ]
      },
