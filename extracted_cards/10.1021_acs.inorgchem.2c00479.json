      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Under argon Schlenk/glovebox conditions, a THF solution of (Ph2SiOH)2O (81.5 mg, 0.167 mmol, 1 equiv; 1 mL) was added to a stirring yellow THF solution of [Eu{N(SiMe3)2}2(THF)2] (103 mg, 0.167 mmol, 1 equiv; 1 mL) at room temperature. The resulting orange solution was immediately concentrated to 1 mL. Storage at −40 °C for 2 days yielded orange crystals of 1-Eu3L3 (78%, 89.3 mg, 0.043 mmol). X-ray-quality yellow crystals were obtained by storing a THF solution at −40 °C for 2 days.",
