            "value": 53.7,
            "unit": "μB",
            "conditions": "2 K, 7 T"
          },
          {
            "property_type": "magnetic",
            "name": "ΔSm",
            "value": 32.3,
            "unit": "J kg−1 K−1",
            "conditions": "3 K; ΔH = 0–7 T; from Maxwell relation on M(T,H)"
