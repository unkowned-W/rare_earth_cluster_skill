        "structural_family": "chiral 3d-4f cocrystal of {Mn10Ln6} and {Mn6Ln2} clusters"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "R-H2L1 (0.006 g, 0.1 mmol), Dy(Ac)3·6H2O (0.04 g, 0.1 mmol), Mn(ClO4) (0.072 g, 0.2 mmol), and HL (0.06 g, 0.03 mmol) were added to 10 mL of ethanol. The solution was heated to about 60 °C, and freshly prepared Et3N (EtOH, 1 mol L−1) was added dropwise to incipient but permanent precipitation (pH ~6.4). The mixture was refluxed for 2 h and filtered. Evaporation of the filtrate under ambient conditions afforded dark-brown square crystals after a week.",
        "reagents": [
          {
            "name": "R-H2L1",
            "formula": "C12H17NO3",
            "role": "chiral ligand",
            "amount": "0.006 g, 0.1 mmol"
          },
          {
            "name": "dysprosium(III) acetate hexahydrate",
            "formula": "Dy(Ac)3·6H2O",
            "role": "metal source",
            "amount": "0.04 g, 0.1 mmol"
          },
          {
            "name": "manganese perchlorate",
            "formula": "Mn(ClO4)",
            "role": "metal source",
            "amount": "0.072 g, 0.2 mmol"
          },
          {
            "name": "HL (2-hydroxy-4-methoxybenzaldehyde / HL2)",
            "formula": "C8H8O3",
            "role": "ligand",
            "amount": "0.06 g, 0.03 mmol"
          },
          {
            "name": "triethylamine",
            "formula": "Et3N",
            "role": "base",
            "amount": "1 mol L−1 in EtOH, to pH ~6.4"
          }
        ],
        "solvents": [
          "ethanol"
        ],
        "temperature": "heated to about 60 °C then reflux",
        "time": "reflux 2 h; crystals after 1 week",
        "ph": "~6.4",
        "vessel_or_method": "solution reflux then ambient evaporation",
        "workup_and_crystallization": "filtered; filtrate evaporated under ambient conditions to give dark-brown square crystals",
        "yield": "38% based on Dy(Ac)3·6H2O"
      },
      "properties": {
        "reported": true,
        "property_type": "both",
        "summary": "Shows NCD/MCD (magneto-optical) activity and SMM-like slow magnetic relaxation with Ueff/kB = 25.1 K and τ0 = 2.0×10−8 s. χMT at 300 K is 170.8 cm3 K mol−1, rising to 338.5 at 4 K then 288.2 at 2 K (ferromagnetic trend). Magnetization 86.66 NμB at 7 T, 2 K.",
        "measurements": [
          {
            "property_type": "magnetic",
