      "structure_description": "A mononuclear, two-THF-solvated β-diketiminato gadolinium dichloride; the paper describes its solid-state geometry as octagonal, with the chlorides at the apexes.",
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "ph": null,
        "procedure": "Under nitrogen, nBuLi was added dropwise to HL¹ in THF at 0 °C and stirred for 1 h. The solution was added to a THF suspension of GdCl₃(THF)₄ at 0 °C, warmed gradually to room temperature, stripped of THF, and treated with toluene. The mixture was stirred at 50 °C for 24 h.",
        "reagents": [
          {
            "amount": "0.31 g, 1 mmol",
            "formula": "HL¹",
            "name": "β-diketimine HL¹",
            "role": "ligand precursor"
          },
          {
            "amount": "0.66 mL of 1.6 M solution, 1.05 mmol",
            "formula": "nBuLi",
            "name": "n-butyllithium",
            "role": "base"
          },
          {
            "amount": "0.552 g, 1 mmol",
            "formula": "GdCl3(THF)4",
            "name": "gadolinium chloride THF adduct",
            "role": "metal precursor"
          }
        ],
        "si_used": false,
        "solvents": [
          "THF",
          "toluene",
          "hexane (nBuLi solution)"
        ],
        "temperature": "0 °C initially; then 50 °C",
        "time": "1 h lithiation; 24 h after addition of toluene",
        "vessel_or_method": "Metathesis under nitrogen",
        "workup_and_crystallization": "Hot-filtered to remove LiCl; green crystals obtained from concentrated toluene at room temperature.",
        "yield": "0.59 g, 87%"
      }
    },
