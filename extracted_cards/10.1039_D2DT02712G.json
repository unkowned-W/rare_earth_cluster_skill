      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "Cluster 1 shows χmT of 189.36 cm3 mol−1 K at 300 K, a minimum of 171.17 cm3 mol−1 K at 12 K, then 172.60 cm3 mol−1 K at 5 K, interpreted as Stark-level depopulation above 12 K and ferromagnetic interactions below 12 K. Magnetization reaches 76.82 Nβ at 5 T. Zero-field ac susceptibility shows slow magnetic relaxation with Ea/kB ≈ 6.12 K and τ0 ≈ 7.48×10−6 s.",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "χmT",
            "value": 189.36,
            "unit": "cm3 mol−1 K",
            "conditions": "300 K, 1000 Oe dc field"
          },
          {
