            "value": "396",
            "unit": "nm",
            "conditions": "emission monitored at 614 nm; charge-transfer excitation also near 310 nm"
          },
          {
            "property_type": "optical",
            "name": "color purity",
            "value": "100",
            "unit": "%",
            "conditions": "vacuum-dried sample, 27 °C; CIE (0.6523, 0.3473); Pe remains 100% from 27 to 227 °C"
