      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "To a stirred solution of H2L (0.115 g, 0.3 mmol) in absolute MeCN (10 mL), Et3N (100 mL as reported in the Markdown conversion) and a solution of Nd(NO3)3·6H2O (0.3 mmol, 0.117 g) in absolute MeOH (10 mL) were added. The mixture was refluxed for 2 h, cooled to room temperature and filtered. Diethyl ether was allowed to diffuse slowly into the filtrate at room temperature, giving pale yellow microcrystals of 1 in a few weeks.",
        "reagents": [
          {
            "name": "H2L (N,N'-bis(3-methoxy-salicylidene)cyclohexane-1,2-diamine)",
