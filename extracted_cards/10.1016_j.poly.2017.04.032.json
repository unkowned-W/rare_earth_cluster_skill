          {
            "name": "lanthanum tris(bis(trimethylsilyl)amide)",
            "formula": "[La(NR2)3]",
            "role": "metal precursor",
            "amount": "0.500 g, 0.806 mmol"
          },
          {
            "name": "trifluoroacetic acid",
            "formula": "H-TFA",
            "role": "ligand/acid",
            "amount": "excess ~5 mL"
          }
        ],
        "solvents": [
          "toluene"
        ],
        "temperature": "heated until bilayer mixed, then slowly cooled",
        "time": null,
        "ph": null,
        "vessel_or_method": "inert-atmosphere glovebox; unstirred bilayer reaction",
        "workup_and_crystallization": "set aside with cap loose until crystals grew",
