      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Compounds 1–4 were obtained by reaction of Ln(tmhd)3·2H2O (0.025 mmol; Ln = Gd for 1) and HL (0.025 mmol) in a mixture of 20 mL acetonitrile and 3 mL CH2Cl2. The yellow solution was stirred at room temperature for about 4 h, filtered, and left unperturbed to evaporate slowly. Yellow block-shaped crystals suitable for single-crystal X-ray diffraction were isolated after about 5 days. Yield 52% based on HL.",
        "reagents": [
          {
            "name": "Gd(tmhd)3·2H2O",
            "formula": "Gd(tmhd)3·2H2O",
            "role": "metal precursor",
            "amount": "0.025 mmol"
          },
          {
            "name": "5-((pyridin-4-ylmethylene)amino)quinolin-8-ol (HL)",
            "formula": "HL",
            "role": "ligand",
            "amount": "0.025 mmol"
          }
        ],
        "solvents": [
          "acetonitrile (20 mL)",
          "CH2Cl2 (3 mL)"
        ],
        "temperature": "room temperature",
        "time": "stirred about 4 h; crystals after about 5 days",
        "ph": null,
        "vessel_or_method": "solution reaction, filtration, slow evaporation",
        "workup_and_crystallization": "After filtration, the solution was left unperturbed to evaporate slowly, giving yellow block-shaped crystals.",
        "yield": "52% based on HL"
      },
      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "χMT at 300 K is 31.73 cm3 K mol−1 (theory 31.52 for four Gd3+). Weak antiferromagnetic coupling (J = −0.14 cm−1, g = 1.98). Magnetization saturates at 28.19 Nβ (80 kOe, 2 K). Cryogenic magnetocaloric effect with −ΔSm max = 20.85 J K−1 kg−1 for ΔH = 7 T at 2.0 K (theoretical 23.97 J K−1 kg−1).",
        "measurements": [
