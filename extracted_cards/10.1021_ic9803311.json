          {
            "name": "europium metal",
            "formula": "Eu",
            "role": "metal source",
            "amount": "644 mg, 4.24 mmol"
          },
          {
            "name": "2-methoxyethanol",
            "formula": "HOCH2CH2OMe",
            "role": "ligand/solvent",
            "amount": "excess"
          }
        ],
        "solvents": [
          "2-methoxyethanol",
          "toluene",
          "hexanes"
        ],
        "temperature": "room temperature",
        "time": "4 h",
        "ph": null,
        "vessel_or_method": "direct metal–alcohol reaction under N2; glovebox workup",
        "workup_and_crystallization": "vacuum removal of excess alcohol; toluene dissolution and centrifugation; hexane dissolution/rotary-evaporation cycles to a powder",
        "yield": "1.27 mg, 99% based on Eu (as reported)"
      },
