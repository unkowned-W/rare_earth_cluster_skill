      "properties": {
        "reported": true,
        "property_type": "optical",
        "summary": "Ligand-centered absorption and residual visible emission accompany strong antenna-sensitized NIR Nd3+ emission in MeCN. Monoexponential NIR lifetime 1.68 μs at 1083 nm gives ΦLn = 0.67%. Energy transfer from both 1LC and 3LC of H2L is efficient (kET > 5×10^8 s−1).",
        "measurements": [
          {
