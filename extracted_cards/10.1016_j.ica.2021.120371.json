      "compound_label": "1",
      "compound_name": "[Cd6Sm4L5(OAc)5(NA)5(CH3OH)5](NO3)4·CH3OH·CH2Cl2",
      "formula": "C147H161Br10Cd6Cl2N19O63Sm4",
      "ccdc_numbers": [
