      "compound_name": "[Gd7(L)6(μ3-OH)8(NO3)4(H2O)](NO3)3·8CH3CN·H2O",
      "formula": "[Gd7(L)6(μ3-OH)8(NO3)4(H2O)]·(NO3)3·8CH3CN·H2O",
      "ccdc_numbers": [
        "1027758"
      ],
