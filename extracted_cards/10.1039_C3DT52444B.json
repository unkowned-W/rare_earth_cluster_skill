            "unit": "μB",
            "conditions": "1.9 K, 70 kOe (7 T)"
          },
          {
            "property_type": "magnetic",
            "name": "dM/dH kink field",
            "value": "~4000",
            "unit": "Oe",
            "conditions": "1.9 K; assigned to spin flip of DyIII ions"
          },
          {
