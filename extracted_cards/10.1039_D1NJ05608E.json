{
  "title": "Highly water-soluble dimeric and trimeric lanthanide carbonates with ethylenediaminetetraacetates as precursors of catalysts for the oxidative coupling reaction of methane",
  "doi": "10.1039/d1nj05608e",
  "list_of_rare_earth_compounds": [
    {
      "compound_label": "1",
      "compound_name": "ammonium trilanthanum carbonato tris(ethylenediaminetetraacetate) triaqua dodecahydrate",
      "formula": "(NH4)5[La3(CO3)(EDTA)3(H2O)3]·12H2O",
      "ccdc_numbers": [
        "2115467"
      ],
      "ccdc_refcodes": [
        "YAWHAJ"
      ],
      "material_class": {
        "material_type": "cluster",
        "nuclearity": 3,
        "metal_composition": "homometallic",
        "rare_earth_elements": [
          "La"
        ],
        "other_metal_elements": [],
        "dimensionality": "0D",
        "structural_family": "carbonato-bridged Ln-EDTA cluster"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "NH4[La(EDTA)(H2O)3]·5H2O (0.60 g, 1.0 mmol) was dissolved in 6.0 mL dimethylformamide–water (3.0 mL : 3.0 mL v/v) and stirred for 30 min. The pH was adjusted to 10.0 with 5% ammonium hydroxide and stirring continued for 30 min, allowing CO2 uptake in the mixed solvent. Slow evaporation at room temperature gave colorless flake-like crystals after one week, which were washed with ethanol and dried. Yield 71% (0.40 g).",
        "reagents": [
          {
            "name": "ammonium lanthanum ethylenediaminetetraacetate pentahydrate",
            "formula": "NH4[La(EDTA)(H2O)3]·5H2O",
            "role": "Ln starting complex",
            "amount": "0.60 g, 1.0 mmol"
          },
          {
            "name": "ammonium hydroxide",
            "formula": "NH4OH",
            "role": "base / pH adjuster",
            "amount": "5% aqueous solution to pH 10.0"
          }
        ],
        "solvents": [
          "dimethylformamide",
          "water",
          "ethanol (wash)"
        ],
        "temperature": "room temperature",
        "time": "stirred 30 min + 30 min; crystals after 1 week",
        "ph": "10.0",
        "vessel_or_method": "solution reaction with slow evaporation",
        "workup_and_crystallization": "slow evaporation at room temperature; colorless flake-like crystals after one week; washed with ethanol and filtered dry",
        "yield": "71% (0.40 g)"
      },
