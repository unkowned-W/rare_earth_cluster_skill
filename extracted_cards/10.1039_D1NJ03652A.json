        "structural_family": "dinuclear acylhydrazone lanthanide cluster"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Complexes 1–5 were prepared by a shared protocol. Triethylamine (0.24 mL, 1.8 mmol) was added dropwise to H3L (0.171 g, 0.6 mmol) in 10 mL CH3OH–DMF (7:1 v/v), turning the pale-yellow solution saffron-yellow. Ln(NO3)3·6H2O (0.6 mmol; Ln = La for 1) was then added and the mixture was stirred for 2 h. The suspension was filtered, washed with methanol and diethyl ether, dried, and redissolved in CH3OH–DMF (3:2 v/v). Slow diffusion of diethyl ether afforded X-ray quality crystals over one week.",
        "reagents": [
          {
            "name": "H3L (N'-(2-hydroxy-3-(hydroxymethyl)-5-methylbenzylidene)isonicotinohydrazide)",
            "formula": "C15H15N3O3",
            "role": "ligand",
            "amount": "0.171 g, 0.6 mmol"
          },
          {
            "name": "triethylamine",
            "formula": "NEt3",
            "role": "base",
            "amount": "0.24 mL, 1.8 mmol"
          },
          {
            "name": "lanthanum(III) nitrate hexahydrate",
            "formula": "La(NO3)3·6H2O",
            "role": "metal source",
            "amount": "0.6 mmol"
          }
        ],
        "solvents": [
          "CH3OH",
          "DMF",
          "diethyl ether"
        ],
        "temperature": null,
        "time": "stirred 2 h; crystals over 1 week",
        "ph": null,
        "vessel_or_method": "solution reaction followed by diethyl ether vapor diffusion crystallization",
        "workup_and_crystallization": "Filtered, washed with methanol and diethyl ether, dried, redissolved in CH3OH–DMF (3:2 v/v); diethyl ether slowly diffused into the solution to give crystals over one week.",
        "yield": "0.171 g, 46% (based on La)"
      },
