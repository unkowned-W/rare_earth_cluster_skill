      "structure_description": "A discrete dimer of two sandwiched Dy3 arsenotungstate units. Each triangular Dy3 core contains a μ3-OH bridge and lies between AsW9O33 and malate-functionalized AsW10O35 units; two malate ligands bridge the sandwiched units to form the Dy6 polyanion.",
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "ph": "About 7.0",
        "procedure": "Add K14[As2W19O67(H2O)] with stirring to an aqueous solution of DL-malic acid and DyCl3·6H2O. After 10 min, adjust the pH with 3.0 mol L⁻¹ LiOH, heat at 60 °C for 1 h, cool to room temperature, and leave the clear solution to crystallize.",
        "reagents": [
          {
            "amount": "1.32 g, 0.25 mmol",
            "formula": "K14[As2W19O67(H2O)]",
            "name": "Potassium arsenotungstate precursor",
            "role": "Polyoxotungstate precursor"
          },
          {
            "amount": "0.14 g, 1.04 mmol",
            "formula": "C4H6O5",
            "name": "DL-malic acid",
            "role": "Malate ligand source"
          },
          {
            "amount": "0.22 g, 0.60 mmol",
            "formula": "DyCl3·6H2O",
            "name": "Dysprosium(III) chloride hexahydrate",
            "role": "Rare-earth source"
          },
          {
            "amount": "3.0 mol L⁻¹; volume not reported",
            "formula": "LiOH",
            "name": "Lithium hydroxide solution",
            "role": "pH adjustment"
          }
        ],
        "si_used": false,
        "solvents": [
          "Distilled water (40 mL)"
        ],
        "temperature": "60 °C for reaction; room temperature for crystallization",
        "time": "10 min before pH adjustment; 1 h heating; about two weeks crystallization",
        "vessel_or_method": "Stirred aqueous solution synthesis",
        "workup_and_crystallization": "Cool the clear solution to room temperature and leave standing; collect colorless block crystals after about two weeks.",
        "yield": "0.76 g (31% based on DyCl3·6H2O)"
      }
