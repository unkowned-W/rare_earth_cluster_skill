{
  "title": "Pentanuclear lanthanide pyramids based on thiacalix[4]arene ligand exhibiting slow magnetic relaxation",
  "doi": "10.1039/c5dt02062j",
  "list_of_rare_earth_compounds": [
    {
      "compound_label": "1",
      "compound_name": "[Dy5(μ4-OH)(μ3-OH)4(L1)(acac)6]·3CH2Cl2·CH3OH·2H2O",
      "formula": "[Dy5(μ4-OH)(μ3-OH)4(L1)(acac)6]·3CH2Cl2·CH3OH·2H2O (H4L1 = p-tert-butylthiacalix[4]arene; acac = acetylacetonate); empirical C74H105Cl6Dy5O24S4",
      "ccdc_numbers": [
        "1062207"
      ],
      "ccdc_refcodes": [
        "BUSKIL"
      ],
      "material_class": {
        "material_type": "cluster",
        "nuclearity": 5,
        "metal_composition": "homometallic",
        "rare_earth_elements": [
          "Dy"
        ],
        "other_metal_elements": [],
        "dimensionality": "0D",
        "structural_family": "square-based Ln5 pyramid with μ4-OH in the basal plane"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "H4L1 (0.15 g, 0.20 mmol) and Dy(acac)3·2H2O (0.50 g, 1.00 mmol) were dissolved in toluene (4 mL), refluxed for 24 h, and cooled to room temperature. The filtered solid was dissolved in 6 mL CH2Cl2/CH3OH (1:1 v/v) and left about five days at room temperature to give colorless block-shaped crystals.",
        "reagents": [
          {
            "name": "p-tert-butylthiacalix[4]arene (H4L1)",
            "formula": "H4L1",
            "role": "ligand",
            "amount": "0.15 g, 0.20 mmol"
          },
          {
            "name": "dysprosium acetylacetonate dihydrate",
            "formula": "Dy(acac)3·2H2O",
            "role": "metal source",
            "amount": "0.50 g, 1.00 mmol"
          }
        ],
        "solvents": [
          "toluene",
          "CH2Cl2",
          "CH3OH"
        ],
        "temperature": "reflux (toluene), then room-temperature crystallization",
        "time": "reflux 24 h; crystallization about five days",
        "ph": null,
        "vessel_or_method": "reflux in toluene followed by recrystallization from mixed solvent",
        "workup_and_crystallization": "filter resulting solid; dissolve in 6 mL CH2Cl2/CH3OH (1:1 v/v); slow evaporation at room temperature yields colorless block crystals",
        "yield": "58%"
      },
      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "χMT at 300 K is 71.42 cm3 K mol−1 (five uncoupled DyIII). χMT falls to 23.43 cm3 K mol−1 at 2.0 K, consistent with thermal depopulation and weak antiferromagnetic coupling. Magnetization at 1.9 K/70 kOe is 27.84 Nβ without saturation. Zero-field ac data (1–999 Hz) show χ″ tails typical of SMM-like slow relaxation, but no χ″ maxima, so Ueff cannot be extracted; a 1000 Oe dc field does not produce peaks down to 1.9 K, attributed to fast zero-field relaxation.",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "χMT",
            "value": 71.42,
            "unit": "cm3 K mol−1",
            "conditions": "room temperature / 300 K, 1000 Oe"
          },
          {
            "property_type": "magnetic",
            "name": "χMT",
            "value": 23.43,
            "unit": "cm3 K mol−1",
            "conditions": "2.0 K, 1000 Oe"
          },
          {
            "property_type": "magnetic",
            "name": "magnetization M",
            "value": 27.84,
            "unit": "Nβ",
            "conditions": "1.9 K, 70 kOe"
          },
          {
            "property_type": "magnetic",
            "name": "ac susceptibility (χ′, χ″)",
            "value": "frequency-dependent χ″ tails; no maxima up to 999 Hz",
            "unit": null,
            "conditions": "Hac = 2 Oe; 1–999 Hz; zero dc field and 1000 Oe dc; T down to 1.9 K"
          }
        ]
      },
