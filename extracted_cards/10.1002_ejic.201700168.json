        "dimensionality": "0D",
        "structural_family": "tip-sharing double-butterfly heptanuclear Ln7 core"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Under aerobic conditions, diethylene glycol (1.068 g, 10 mmol), benzoic acid (0.122 g, 1 mmol) and Eu(NO3)3·6H2O (0.223 g, 0.5 mmol) were dissolved in CH3CN (20 mL), stirred for 30 min at 55 °C, then triethylamine (0.28 mL, 2 mmol) was added. The mixture was stirred for another 3 h at 55 °C, cooled, and filtered. Slow evaporation of the filtrate at room temperature gave colorless crystals after several days. Analogous 1–5 were prepared by the same procedure with the corresponding Ln(NO3)3·6H2O.",
        "reagents": [
          {
            "name": "diethylene glycol",
            "formula": "C4H10O3",
            "role": "ligand",
            "amount": "1.068 g, 10 mmol"
          },
          {
            "name": "benzoic acid",
            "formula": "C6H5COOH",
            "role": "ligand",
            "amount": "0.122 g, 1 mmol"
          },
          {
            "name": "europium(III) nitrate hexahydrate",
            "formula": "Eu(NO3)3·6H2O",
            "role": "metal source",
            "amount": "0.223 g, 0.5 mmol"
          },
          {
            "name": "triethylamine",
            "formula": "Et3N",
            "role": "base",
            "amount": "0.28 mL, 2 mmol"
          }
        ],
        "solvents": [
          "CH3CN"
        ],
        "temperature": "55 °C (stirring); room temperature (crystallization)",
        "time": "30 min then 3 h stirring; crystals after several days",
        "ph": null,
        "vessel_or_method": "aerobic solution reaction followed by filtration and slow evaporation",
        "workup_and_crystallization": "filtered after cooling; slow evaporation of the filtrate at room temperature afforded colorless crystals",
        "yield": "47 mg (22%, based on Eu)"
      },
      "properties": {
        "reported": true,
        "property_type": "optical",
        "summary": "Solid-state photoluminescence of 1 at room temperature shows characteristic Eu(III) red emission (excitation 393 nm) with average lifetime 580.4 μs (monitored at 617 nm). Ligands effectively sensitize Eu(III).",
        "measurements": [
          {
            "property_type": "optical",
            "name": "emission maxima",
            "value": "579, 592, 617, 652, 699",
            "unit": "nm",
            "conditions": "solid state, room temperature, λex = 393 nm; 5D0→7FJ (J = 0–4)"
          },
          {
            "property_type": "optical",
            "name": "average luminescence lifetime",
            "value": 580.4,
            "unit": "μs",
            "conditions": "solid state, room temperature, monitored at 617 nm"
          }
        ]
      },
