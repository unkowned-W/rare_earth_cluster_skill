      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "A solution of PrCl3·6H2O (0.30 g, 0.84 mmol) in water (1.5 mL), cucurbit[6]uril (0.010 g, 0.009 mmol), and 4-cyanopyridine (0.045 g, 0.43 mmol) was placed in a glass tube. The sealed tube was heated from 20 °C to 130 °C over 5 h, held at 130 °C for 12 h, then slowly cooled to room temperature over 48 h. Pale-green polyhedral crystals were filtered off and dried in air for 12 h. After crystal separation the solution pH was 5–6.",
        "reagents": [
          {
            "name": "praseodymium(III) chloride hexahydrate",
            "formula": "PrCl3·6H2O",
            "role": "metal source",
            "amount": "0.30 g, 0.84 mmol"
          },
          {
            "name": "cucurbit[6]uril",
            "formula": "C36H36N24O12·10H2O",
            "role": "macrocyclic supporting ligand",
            "amount": "0.010 g, 0.009 mmol"
          },
          {
            "name": "4-cyanopyridine",
            "formula": "C6H4N2",
            "role": "precursor of isonicotinate/isonicotinic acid (by hydrolysis)",
            "amount": "0.045 g, 0.43 mmol"
          }
        ],
        "solvents": [
          "water"
        ],
        "temperature": "heated 20 to 130 °C over 5 h, then 130 °C",
        "time": "5 h ramp + 12 h at 130 °C + 48 h cooling; crystals dried 12 h in air",
        "ph": "5–6 after crystal separation",
        "vessel_or_method": "sealed glass tube, hydrothermal",
        "workup_and_crystallization": "slow cooling of the sealed tube produced pale-green polyhedral crystals, which were filtered and air-dried",
        "yield": "0.011 g (54% based on cucurbit[6]uril)"
