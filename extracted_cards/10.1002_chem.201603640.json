      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "Dy4 butterfly cluster is an SMM with frequency-dependent ac susceptibility and one relaxation process. Room-temperature χMT is 56.51 cm3 K mol−1; χMT rises to 60.04 cm3 K mol−1 at 40 K then falls to 21.31 cm3 K mol−1 at 2 K (1 T), indicating weak ferromagnetic interactions. Orbach+QTM fit gives Ueff = 49.03 K (34.08 cm−1). Ab initio analysis also indicates a mixed toroidal moment (SMT).",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "χMT (300 K)",
            "value": 56.51,
            "unit": "cm3 K mol-1",
            "conditions": "dc susceptibility, 2–300 K, 0.1 or 1 T"
          },
          {
            "property_type": "magnetic",
            "name": "χMT (40 K)",
            "value": 60.04,
            "unit": "cm3 K mol-1",
            "conditions": "upon cooling"
          },
          {
            "property_type": "magnetic",
            "name": "χMT (2 K)",
            "value": 21.31,
            "unit": "cm3 K mol-1",
            "conditions": "1 T"
          },
          {
            "property_type": "magnetic",
            "name": "Ueff (Orbach + QTM)",
            "value": 49.03,
            "unit": "K",
            "conditions": "ac relaxation of 1; also reported as 34.08 cm-1; τ0 = 5.78e-8 s; τQTM = 4.13e-4 s"
          },
          {
            "property_type": "magnetic",
            "name": "τ0 (Orbach + QTM)",
            "value": 5.78e-08,
            "unit": "s",
            "conditions": "fit of χ″ vs frequency, 0 Oe dc field"
          },
          {
            "property_type": "magnetic",
            "name": "Ueff (high-T Arrhenius/Orbach)",
            "value": 40.92,
            "unit": "K",
            "conditions": "linear high-temperature fit; also 28.44 cm-1; τ0 = 1.5e-7 s"
          },
          {
            "property_type": "magnetic",
            "name": "exchange coupling J1, J2, J3",
            "value": "+2.35, -0.58, -0.29",
