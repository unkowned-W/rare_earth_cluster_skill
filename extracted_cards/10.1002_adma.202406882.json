{
  "title": "Air and Thermally Stable Fluoride Bridged Rare-Earth Clusters Showing Intense Photoluminescence and Potential LED Application",
  "doi": "10.1002/adma.202406882",
  "list_of_rare_earth_compounds": [
    {
      "compound_label": "EuFC-16",
      "compound_name": "hexadecanuclear fluoride-bridged europium pivalate–triethanolamine cluster",
      "formula": "Eu16(μ4-F)6(μ3-F)12(tBuCOO)18[N(CH2CH2O)3]4·2EtOH",
      "ccdc_numbers": [
        "2303359"
      ],
      "ccdc_refcodes": [
        "PUKNUI"
      ],
      "material_class": {
        "material_type": "cluster",
        "nuclearity": 16,
        "metal_composition": "homometallic",
        "rare_earth_elements": [
          "Eu"
        ],
        "other_metal_elements": [],
        "dimensionality": "0D",
        "structural_family": "fluoride-bridged truncated-tetrahedral {RE16} cluster"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": false,
        "si_used": true,
        "procedure": "The precursor Eu2(tBuCOO)6(tBuCOOH)6 was obtained by reacting the rare-earth source with pivalic acid at 150 °C for 6 h until the solution was clear, then drying by solvent evaporation (yield ~90%; method also cited to prior work). Eu2(tBuCOO)6(tBuCOOH)6 (1.5 g, 1.00 mmol), triethanolamine (0.075 g, 0.50 mmol), triethylamine (0.152 g, 1.50 mmol), and NH4F (0.084 g, 2.25 mmol) were dispersed or dissolved in EtOH/MeCN/DMF (2 mL:3 mL:4 mL), stirred in air for 10 min, transferred to a 12 mL Teflon-lined vessel, and heated at 150 °C for 1 day. The system was cooled to room temperature at 5 °C/h to give colorless block crystals of EuFC-16. Yield ~81%. Elemental analysis for C114H210N4Eu16O48F18: calcd C 25.89, H 3.97, N 1.06; found C 25.27, H 3.85, N 1.25.",
        "reagents": [
          {
            "name": "Eu2(tBuCOO)6(tBuCOOH)6",
            "formula": "Eu2(tBuCOO)6(tBuCOOH)6",
            "role": "rare-earth precursor",
            "amount": "1.5 g, 1.00 mmol"
          },
          {
            "name": "triethanolamine",
            "formula": "N(CH2CH2OH)3",
            "role": "chelating ligand",
            "amount": "0.075 g, 0.50 mmol"
          },
          {
            "name": "triethylamine",
            "formula": "NEt3",
            "role": "base",
            "amount": "0.152 g, 1.50 mmol"
          },
          {
            "name": "ammonium fluoride",
            "formula": "NH4F",
            "role": "fluoride source",
            "amount": "0.084 g, 2.25 mmol"
          }
        ],
        "solvents": [
          "EtOH",
          "MeCN",
          "DMF"
        ],
        "temperature": "150 °C",
        "time": "stirred 10 min, then heated 1 day; cooled at 5 °C/h",
        "ph": null,
        "vessel_or_method": "12 mL Teflon-lined solvothermal vessel, stirred in air before heating",
        "workup_and_crystallization": "Cooled to room temperature at 5 °C/h; colorless block-like crystals isolated. Residual DMF later removed by heating at 100 °C under vacuum for 8 h for dried samples.",
        "yield": "~81%"
      },
      "properties": {
        "reported": true,
        "property_type": "optical",
        "summary": "EuFC-16 is a bright red f–f emitter with PLQY 87.7%, color purity about 100%, and a 1.95 ms decay lifetime. Emission remains 85.5% of the initial intensity at 147 °C, and the cluster was used as a soluble red phosphor in UV-cured LEDs.",
        "measurements": [
          {
            "property_type": "optical",
            "name": "photoluminescence quantum yield",
            "value": "87.7",
            "unit": "%",
            "conditions": "vacuum-dried sample, 300 K, near maximum excitation wavelength (396 nm)"
          },
          {
            "property_type": "optical",
            "name": "photoluminescence decay lifetime",
            "value": "1.95",
            "unit": "ms",
            "conditions": "vacuum-dried sample, 300 K, single-exponential fit"
          },
          {
            "property_type": "optical",
            "name": "dominant emission wavelength",
            "value": "614",
            "unit": "nm",
            "conditions": "excitation at 396 nm; 5D0→7F2"
          },
          {
