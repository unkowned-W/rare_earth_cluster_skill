      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Solvothermal synthesis: 1,3-bis(2-pyridyl)-1,3-propanedione (0.1 mmol), Dy(ClO4)3·6H2O (0.05 mmol), Zn(L)(H2O) (0.1 mmol; H2L = N,N′-bis(3-methoxysalicylidene)-1,3-diaminopropane), and 10 mL methanol were placed in a 25 mL Teflon-lined stainless-steel vessel, heated at 100 °C for 3 days, then cooled to room temperature over 600 min. Crystals were harvested and stored in the mother liquor because they easily effloresce. Pyridine-2-carboxylate is generated in situ and a peroxide ligand forms by reduction of dioxygen. Yield 12–15% based on Ln (shared for 1–3).",
        "reagents": [
          {
