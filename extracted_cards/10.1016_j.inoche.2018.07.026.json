      "properties": {
        "reported": true,
        "property_type": "optical",
        "summary": "Complex 2 shows ligand-to-Eu3+ sensitization and color-purity red Eu3+ emission (5D0 → 7FJ) in MeCN and similar solid-state photoluminescence, with ΦEuL = 20.1%. The 5D0 → 7F2/5D0 → 7F1 intensity ratio is up to 30. Energy-transfer rate from the BTFA chromophore is reported as kET > 3.8×10^8 s−1. Lower quantum yield versus classic tris(BTFA) Eu complexes is attributed to OH-oscillator quenching from μ3-OH and coordinated water.",
        "measurements": [
          {
            "property_type": "optical",
            "name": "absorption maxima",
            "value": "254–256 and 315–317",
            "unit": "nm",
            "conditions": "MeCN, 2×10−5 M; BTFA-centered, lower-energy band assigned as IL π–π*"
          },
          {
            "property_type": "optical",
            "name": "excitation wavelength",
            "value": "350 or 375",
            "unit": "nm",
            "conditions": "MeCN solution, RT"
          },
          {
            "property_type": "optical",
            "name": "emission",
            "value": "Eu3+-centered 5D0 → 7FJ (J = 1–4) red light; hypersensitive 5D0 → 7F2 at 613 nm",
            "unit": null,
            "conditions": "MeCN, 2×10−5 M, RT; similar behavior in the solid state"
          },
          {
            "property_type": "optical",
            "name": "CIE chromatic coordinates",
            "value": "x = 0.669, y = 0.330 (point A)",
            "unit": null,
            "conditions": "MeCN solution, RT"
          },
          {
            "property_type": "optical",
            "name": "observed lifetime τobs",
            "value": 437,
            "unit": "μs",
            "conditions": "bi-exponential fit at 613 nm (5D0 → 7F2), MeCN, RT"
          },
          {
