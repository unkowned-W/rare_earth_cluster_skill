      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "General solvothermal/solution protocol for 1–3: H3L (1 mL, 0.1 mol/L) was dissolved in methanol (8 mL). Ln(NO3)3·6H2O (1 mmol; Ln = Tb for 1), pivalic acid (2 mmol) and triethylamine (1 mmol) were added. The mixture was stirred for 20 min, then Co(NO3)2·6H2O (1 mmol) was added and stirred for a further 30 min at room temperature to give a clear dark red solution. Evaporation afforded red-brown block-shaped crystals after one week.",
        "reagents": [
