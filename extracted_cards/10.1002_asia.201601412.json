          {
            "name": "H2L (2-{[2-(hydroxymethyl)phenylimino]methyl}-6-methoxyphenol)",
            "formula": "C15H15NO3",
            "role": "ligand",
            "amount": "0.1 mmol"
          },
          {
            "name": "dysprosium(III) nitrate hexahydrate",
            "formula": "Dy(NO3)3·6H2O",
            "role": "metal source",
            "amount": "0.1 mmol"
          },
          {
            "name": "manganese(II) oxalate",
            "formula": "MnC2O4",
            "role": "catalyst for in situ formate/μ4-O formation",
            "amount": "0.05 mmol"
          },
          {
            "name": "sodium hydroxide",
            "formula": "NaOH",
            "role": "base",
            "amount": "0.2 mmol"
          }
        ],
        "solvents": [
          "MeOH",
          "DMF"
        ],
        "temperature": "80 °C",
