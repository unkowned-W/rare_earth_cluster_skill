            "property_type": "magnetic",
            "name": "χMT",
            "value": 153.59,
            "unit": "cm3 K mol−1",
            "conditions": "2 K, 1000 Oe dc"
          },
          {
            "property_type": "magnetic",
            "name": "ac susceptibility / slow magnetic relaxation",
            "value": "obvious slow magnetic relaxation at low T (less prominent than 3)",
