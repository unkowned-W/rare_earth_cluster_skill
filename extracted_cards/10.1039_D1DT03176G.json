      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "DC χT at 300 K is 46.9 cm3 K mol−1 (1 kOe) and decreases on cooling, reflecting Cr–Dy antiferromagnetic exchange plus Dy single-ion anisotropy. AC susceptibility shows field-independent slow magnetization relaxation below ~4 K at 0 DC field; QTM is suppressed by Cr–Dy exchange. Two relaxation processes are observed: a faster Raman-type pathway and a slower Orbach-type process with a thermal barrier of ca. 14–20 cm−1. Ab initio exchange doublets are strongly Ising with very small tunnelling splittings.",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "χT",
            "value": 46.9,
            "unit": "cm3 K mol−1",
            "conditions": "room temperature, 1 kOe DC"
          },
          {
            "property_type": "magnetic",
            "name": "SMM blocking/relaxation onset",
            "value": "below 4 K",
            "unit": null,
            "conditions": "AC susceptibility, 0 Oe DC field"
          },
          {
            "property_type": "magnetic",
            "name": "Orbach barrier Ueff",
            "value": "ca. 14–20",
            "unit": "cm−1",
            "conditions": "slower AC relaxation process, 0–3000 Oe DC; Table 4 / Conclusions"
          },
          {
            "property_type": "magnetic",
            "name": "exchange-ground gz",
            "value": 23.1,
            "unit": null,
            "conditions": "POLY_ANISO exchange system, ground doublet (Table 3)"
          },
          {
            "property_type": "magnetic",
            "name": "tunnelling splitting Δ",
            "value": "2.22e-6",
            "unit": "cm−1",
            "conditions": "ab initio ground exchange doublet (Table 3)"
