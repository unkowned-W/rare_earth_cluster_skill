{
  "title": "Variations of heterometallic cores and magnetic properties in Co(III)–Y/Ln isobutyrate clusters with N-butyldiethanolamine: from tetranuclear to octanuclear clusters",
  "doi": "10.1039/d5ra02513c",
  "list_of_rare_earth_compounds": [
    {
      "compound_label": "1",
      "compound_name": "[Co2Y2(OH)2(ib)4(bdea)2(NO3)2]·2MeCN",
      "formula": "C36H70Co2N6O20Y2",
      "ccdc_numbers": [
        "2239014"
      ],
      "ccdc_refcodes": [],
      "material_class": {
        "material_type": "cluster",
        "nuclearity": 4,
        "metal_composition": "heterometallic",
        "rare_earth_elements": [
          "Y"
        ],
        "other_metal_elements": [
          "Co"
        ],
        "dimensionality": "0D",
        "structural_family": "rhombic butterfly {Co2Y2(μ3-OH)2} cluster"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Under aerobic conditions, Co(ib)2 (0.100 g, 0.43 mmol) was dissolved in 10 mL MeCN with N-butyldiethanolamine (H2bdea) (0.095 g, reported 5.89 mmol) and Y(NO3)3·6H2O (0.160 g, 0.42 mmol). The dark pink solution was refluxed for 30 min, filtered, and the purple filtrate left in a vial for slow evaporation. Violet crystals of 1 were filtered after 2 weeks, washed with 10 mL MeCN and air-dried. Co(II) is oxidized to Co(III) during the reaction.",
        "reagents": [
          {
            "name": "cobalt(II) isobutyrate",
            "formula": "Co(ib)2",
            "role": "Co source",
            "amount": "0.100 g, 0.43 mmol"
          },
          {
            "name": "N-butyldiethanolamine",
            "formula": "H2bdea",
            "role": "ligand",
            "amount": "0.095 g, 5.89 mmol (as reported)"
          },
          {
            "name": "yttrium(III) nitrate hexahydrate",
            "formula": "Y(NO3)3·6H2O",
            "role": "Y source",
            "amount": "0.160 g, 0.42 mmol"
          }
        ],
        "solvents": [
          "MeCN"
        ],
        "temperature": "reflux, then room-temperature evaporation",
        "time": "reflux 30 min; crystallization 2 weeks",
        "ph": null,
        "vessel_or_method": "reflux then slow evaporation in a capped vial",
        "workup_and_crystallization": "filtered after reflux; filtrate evaporated; crystals filtered, washed with 10 mL MeCN, air-dried",
        "yield": "0.035 g (21% based on Y)"
      },
      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "Used as diamagnetic-Y reference to quantify low-spin Co(III) TIP. DC data of paramagnetic analogues show non-interacting or very weakly interacting Ln(III) and low-spin Co(III).",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "χm,TIP",
            "value": "1.30e-4",
            "unit": "cm3 mol-1 per Co(III)",
            "conditions": "derived from compound 1; Fig. S25"
          },
          {
            "property_type": "magnetic",
            "name": "χm,dia",
            "value": "-6.01e-4",
            "unit": "cm3 mol-1",
            "conditions": "sample-holder and intrinsic diamagnetic correction"
          }
        ]
      },
