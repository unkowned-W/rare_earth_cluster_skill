      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Pieces of Eu metal (10 g, 65.8 mmol, 5–10 mm diameter) were reacted with approximately 50 mL of HO^iPr at room temperature under nitrogen for 6 days to give an orange solution with some insoluble material. Excess HO^iPr was removed under vacuum and the orange paste was transferred to a nitrogen glovebox, dissolved in THF, and centrifuged to remove insolubles (1.7 g). THF was removed in vacuo to yield solid 3 (16.24 g, 80% based on Eu). Elemental analysis was consistent with 0.4 equiv THF per Eu. Similar yields were obtained at 45 °C for 4 days; reflux produced mixed Eu(II)/Eu(III) products. H2 was identified as the evolved gas in a closed-system synthesis.",
        "reagents": [
          {
            "name": "europium metal",
            "formula": "Eu",
            "role": "metal source",
            "amount": "10 g, 65.8 mmol"
          },
          {
            "name": "2-propanol",
            "formula": "HO^iPr",
            "role": "solvent/reactant",
            "amount": "approximately 50 mL"
          },
          {
            "name": "THF",
            "formula": "C4H8O",
            "role": "extraction/coordination solvent",
            "amount": null
          }
        ],
        "solvents": [
          "2-propanol",
          "THF"
        ],
        "temperature": "room temperature (also 45 °C variant)",
        "time": "6 days (room temperature); 4 days at 45 °C",
        "ph": null,
        "vessel_or_method": "Schlenk/vacuum-line under nitrogen; glovebox workup; centrifugation",
        "workup_and_crystallization": "Remove excess HO^iPr under vacuum; dissolve in THF; centrifuge off insolubles; strip THF in vacuo.",
        "yield": "16.24 g, 80% based on Eu"
      },
      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "Evans-method magnetic susceptibility of divalent 3 at 298 K gives μeff = 7.5 μB, consistent with Eu(II).",
