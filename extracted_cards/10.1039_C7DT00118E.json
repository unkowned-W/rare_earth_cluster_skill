      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Ln(acac)3·2H2O (0.02 mmol; Ln = Gd for 1) was dissolved in 20 mL of acetonitrile. A 5 mL CH2Cl2 solution of HL (0.005 g, 0.02 mmol) was added to the stirred acetonitrile solution, and the mixture was heated for 2 h at 70 °C. The solution was cooled to room temperature and filtered. Yellow block crystals suitable for single-crystal X-ray diffraction were isolated by keeping the filtrate at room temperature for three days.",
        "reagents": [
          {
            "name": "gadolinium(III) acetylacetonate dihydrate",
            "formula": "Gd(acac)3·2H2O",
            "role": "metal precursor",
            "amount": "0.02 mmol"
          },
          {
            "name": "5-(benzylidene)amino-8-hydroxyquinoline",
            "formula": "HL (C16H12N2O)",
            "role": "Schiff-base ligand",
            "amount": "0.005 g, 0.02 mmol"
          }
        ],
        "solvents": [
          "acetonitrile",
          "dichloromethane"
        ],
        "temperature": "70 °C (reaction); room temperature (crystallization)",
        "time": "2 h heating; 3 days crystallization",
        "ph": null,
        "vessel_or_method": "solution reaction followed by filtration and slow evaporation/standing of the filtrate",
        "workup_and_crystallization": "cooled to room temperature, filtered; yellow block crystals grown from the filtrate at room temperature for three days",
        "yield": "54% (based on Gd)"
      },
      "properties": {
        "reported": true,
        "property_type": "both",
        "summary": "Dc susceptibility (2–300 K, 1000 Oe) shows χMT = 33.09 cm3 K mol−1 at 300 K, nearly constant to 50 K then falling to 15.21 cm3 K mol−1 at 2 K, consistent with weak intramolecular antiferromagnetic Gd···Gd coupling (Curie–Weiss C = 33.19 cm3 K mol−1, θ = −0.86 K; fit g = 2.1, J = −0.03 cm−1). Magnetization reaches 28.24 Nβ at 2 K and 8 T. Magnetocaloric effect: −ΔSm max = 25.08 J kg−1 K−1 at 2 K and ΔH = 7 T. UV-vis in CH2Cl2 shows ligand-based absorptions red-shifted to ca. 261 and 410 nm.",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "χMT",
            "value": "33.09",
            "unit": "cm3 K mol−1",
            "conditions": "room temperature; 1000 Oe; 2–300 K dc susceptibility"
          },
          {
            "property_type": "magnetic",
            "name": "χMT",
            "value": "15.21",
            "unit": "cm3 K mol−1",
            "conditions": "2 K; 1000 Oe"
          },
          {
            "property_type": "magnetic",
            "name": "Curie constant C",
            "value": "33.19",
            "unit": "cm3 K mol−1",
            "conditions": "Curie–Weiss fit of χM−1 vs T, 2–300 K"
          },
          {
            "property_type": "magnetic",
            "name": "Weiss temperature θ",
            "value": "-0.86",
            "unit": "K",
            "conditions": "Curie–Weiss fit, 2–300 K"
          },
          {
            "property_type": "magnetic",
            "name": "exchange coupling J",
            "value": "-0.03",
            "unit": "cm−1",
            "conditions": "fit of χMT vs T with g = 2.1; R = 0.997917"
          },
          {
            "property_type": "magnetic",
            "name": "magnetization M",
            "value": "28.24",
            "unit": "Nβ",
            "conditions": "2 K, 8 T"
          },
          {
            "property_type": "magnetic",
            "name": "magnetic entropy change −ΔSm",
            "value": "25.08",
