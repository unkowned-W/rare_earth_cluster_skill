          {
            "name": "Gd(acac)3·2H2O",
            "formula": "Gd(acac)3·2H2O",
            "role": "metal precursor",
            "amount": "0.03 mmol"
          },
          {
            "name": "H2L (2-hydroxybenzoic acid (5-hydroxymethyl-furan-2-ylmethylene)-hydrazide)",
            "formula": "C12H12N2O4",
            "role": "Schiff-base ligand",
            "amount": "0.03 mmol"
          }
        ],
        "solvents": [
          "ethanol",
          "dichloromethane"
        ],
        "temperature": "70 °C (after 3 h stirring)",
        "time": "stirred 3 h, then heated 48 h",
        "ph": null,
        "vessel_or_method": "solvothermal reaction in sealed 20 mL glassware in a drying oven",
        "workup_and_crystallization": "Yellow block-shaped single crystals suitable for X-ray diffraction were obtained from the solvothermal mixture.",
        "yield": "38% (based on Gd(acac)3·2H2O)"
      },
      "properties": {
        "reported": true,
