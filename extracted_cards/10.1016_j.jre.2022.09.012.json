            "property_type": "magnetic",
            "name": "−ΔSm max",
            "value": 41.43,
            "unit": "J kg−1 K−1",
            "conditions": "T = 3.0 K, ΔH = 7.0 T"
          },
          {
            "property_type": "optical",
            "name": "UV–vis absorption λmax",
            "value": 209,
            "unit": "nm",
            "conditions": "ethanol, room temperature"
          }
