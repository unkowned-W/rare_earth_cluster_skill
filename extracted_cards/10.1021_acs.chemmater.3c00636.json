      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "For 1-X, 1.28 mmol of the monocarboxylic acid was placed in a 5 mL glass vial and dissolved in 3.6 mL DMF under stirring. 1.2 mL of aqueous ceric ammonium nitrate (0.533 M, 0.64 mmol) was added, the vessel was sealed, and the mixture was left vibration-free for 72 h at room temperature (298 K). Yellow crystallites were isolated by filtration, washed three times with 3 mL DMF and 3 mL deionized water, and dried in air.",
        "reagents": [
          {
            "name": "4-chlorobenzoic acid",
            "formula": "C7H5ClO2",
            "role": "ligand",
            "amount": "1.28 mmol (200.4 mg)"
          },
          {
            "name": "ceric ammonium nitrate",
            "formula": "(NH4)2[Ce(NO3)6]",
            "role": "metal source",
            "amount": "1.2 mL of 0.533 M aqueous solution (0.64 mmol)"
          }
        ],
        "solvents": [
          "N,N-dimethylformamide",
          "water"
        ],
        "temperature": "298 K",
        "time": "72 h",
        "ph": null,
        "vessel_or_method": "5 mL glass vial, sealed, vibration-free crystallization",
        "workup_and_crystallization": "Filtration; washed three times with 3 mL DMF and 3 mL deionized water; dried in air. Yellow crystallites suitable for SC-XRD.",
        "yield": "54% based on Ce"
      },
      "properties": {
        "reported": true,
        "property_type": "optical",
        "summary": "UV–vis spectra of 1-Cl in dichloromethane at 298 K showed no major changes over 12 h, supporting solution stability. No magnetic data were reported.",
        "measurements": [
          {
            "property_type": "optical",
            "name": "UV–vis solution stability",
            "value": "no major spectral changes over 12 h",
            "unit": null,
            "conditions": "1-Cl in DCM, 298 K, spectra every hour for 12 h (Figure S34)"
          }
        ]
      },
