      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "General MeOH procedure for 1 and 3: to a MeOH (2 mL) solution of H2L1 (0.039 g, 0.2 mmol) was added dropwise a MeOH (2 mL) solution of Ln(NO3)3·5H2O (0.2 mmol) to give a yellow solution. After stirring 10 min, Co2(μ-OH2)(O2CCMe3)4(HO2CCMe3)4 (0.095 g, 0.1 mmol) in MeOH (1 mL) was added and stirred another 10 min, giving a red-brown solution. Et3N (111.2 μL, 0.4 mmol) was added, giving a dark red solution that was stirred magnetically for 3 h. The precipitate was filtered through a G4 bed and the filtrate was left for slow evaporation, yielding X-ray quality crystals after about a month. For 1 specifically: H2L1 (0.039 g, 0.2 mmol), Tb(NO3)3·5H2O (0.090 g, 0.2 mmol), Co2(μ-OH2)(O2CCMe3)4(HO2CCMe3)4 (0.095 g, 0.1 mmol), and Et3N (111.2 μL, 0.4 mmol).",
        "reagents": [
          {
            "name": "N-(2-hydroxyethyl)-salicylaldimine (H2L1)",
            "formula": "H2L1",
            "role": "ligand",
            "amount": "0.039 g, 0.2 mmol"
          },
          {
            "name": "terbium(III) nitrate pentahydrate",
