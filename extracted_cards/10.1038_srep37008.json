      "properties": {
        "reported": true,
        "property_type": "optical",
        "summary": "Shows characteristic Tb(III) 5D4 → 7FJ emission in chloroform with single-exponential decay. Emission quantum yield and lifetime increase along the Tb_nGd_9−n series as n increases. Temperature-dependent lifetimes fall above 270 K; Arrhenius analysis of BET for this cluster (minimal Tb–Tb ET) gave k_BET = 167 s−1 and Ea_BET = 38.7 kJ mol−1. All clusters have τ_210K ≈ 1.12 ms.",
        "measurements": [
          {
            "property_type": "optical",
            "name": "emission lifetime at 210 K",
            "value": "approximately 1.12",
            "unit": "ms",
            "conditions": "1.0 × 10−4 M chloroform; ligand excitation; Table 2 / Fig. 5"
          },
          {
            "property_type": "optical",
            "name": "BET rate constant k_BET",
            "value": "167",
            "unit": "s−1",
            "conditions": "Arrhenius analysis of lifetime temperature dependence (Figure S6); chloroform solution"
          },
          {
            "property_type": "optical",
            "name": "BET activation energy Ea_BET",
            "value": "38.7",
            "unit": "kJ mol−1",
            "conditions": "Arrhenius plot of Equation (8) for Tb1Gd8"
          }
        ]
      },
