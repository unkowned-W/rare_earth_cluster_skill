        "structural_family": "discrete Pascal-triangle Gd6 core bridged by oxo/hydroxo, formate, and amide oxygen"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": false,
        "si_used": true,
        "procedure": "GdCl3·6H2O (37.1 mg, 0.1 mmol) was dissolved in 5 mL methanol and combined with a 5 mL DMF solution of H4BMPC (53.4 mg, 0.1 mmol). The yellow solution was refluxed in a round-bottomed flask at 70–80 °C for 10 h, filtered hot through Whatman paper into a 20 mL beaker, and left for slow evaporation. After 7 days, needle-shaped bright-yellow crystals were collected, washed with MeOH, and air-dried. Yield 62% based on BMPC. DMF decomposes in situ to formate.",
        "reagents": [
          {
            "name": "gadolinium(III) chloride hexahydrate",
            "formula": "GdCl3·6H2O",
            "role": "metal source",
            "amount": "37.1 mg (0.1 mmol)"
          },
          {
            "name": "H4BMPC",
            "formula": null,
            "role": "ligand",
            "amount": "53.4 mg (0.1 mmol)"
          }
        ],
        "solvents": [
          "methanol",
          "DMF"
        ],
        "temperature": "70–80 °C reflux; crystallization at ambient evaporation",
        "time": "10 h reflux, then 7 days",
        "ph": null,
        "vessel_or_method": "round-bottomed flask reflux, then beaker slow evaporation",
        "workup_and_crystallization": "hot filtration, 7-day slow evaporation, MeOH wash, air drying; needle-shaped bright-yellow crystals",
        "yield": "62% based on BMPC"
      },
      "properties": {
        "reported": true,
