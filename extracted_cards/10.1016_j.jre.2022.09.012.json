      },
      "properties": {
        "reported": true,
        "property_type": "both",
        "summary": "dc susceptibility shows χMT = 47.40 cm3 K mol−1 at 300 K, remaining nearly constant to 20 K then falling to 18.24 cm3 K mol−1 at 2 K, consistent with antiferromagnetic Gd···Gd coupling. Magnetization reaches 42.17 Nβ at 2.0 K and 8 T. A relatively large magnetocaloric effect is observed (−ΔSm max = 41.43 J kg−1 K−1 at 3.0 K and 7.0 T). UV–vis absorption of 1 in ethanol is blue-shifted versus free H3L, with a peak near 209 nm assigned to a π→σ* transition.",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "χMT",
            "value": 47.4,
            "unit": "cm3 K mol−1",
            "conditions": "300 K, 0.1 T"
          },
          {
            "property_type": "magnetic",
            "name": "χMT",
            "value": 18.24,
            "unit": "cm3 K mol−1",
            "conditions": "2 K, 0.1 T"
          },
          {
            "property_type": "magnetic",
            "name": "magnetization M",
            "value": 42.17,
