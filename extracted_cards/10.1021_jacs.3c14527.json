      "properties": {
        "reported": true,
        "property_type": "both",
        "summary": "Field-induced Yb-based SMM under 1750 Oe with Raman-dominated relaxation and a modest Orbach barrier; also shows Eu→Yb NIR downshifting, Yb-to-Eu cooperative-sensitization upconversion (visible Eu emission at 612 nm upon 980 nm excitation, detectable to 100 nM), weak Yb cooperative luminescence near 505 nm, and ΦUC ≈ 4.84×10−8.",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "χmT",
            "value": 17.47,
