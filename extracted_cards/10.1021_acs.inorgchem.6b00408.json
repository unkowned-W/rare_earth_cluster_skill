      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Complexes 1–16 were prepared hydrothermally in a 23 mL Teflon-lined autoclave at 150 °C. For 1, LaCl3, 3,5-dichlorobenzoic acid, 2,2′:6′,2″-terpyridine, and distilled water (molar ratio 1:2:1:826; typically 1.5 mL water) were heated for 72 h. Autoclaves were cooled to room temperature over 4 h and opened after about 12 h. Colorless small block crystals were isolated by decanting, washing three times with distilled water and ethanol, and air-drying overnight. Doubling the water volume (1.5 to 3 mL) with LaCl3 instead yields complex 2.",
        "reagents": [
          {
            "name": "lanthanum chloride",
            "formula": "LaCl3",
            "role": "metal source",
            "amount": "1 molar equivalent"
          },
          {
            "name": "3,5-dichlorobenzoic acid",
            "formula": "C7H3Cl2O2",
            "role": "ligand",
            "amount": "2 molar equivalents"
          },
          {
            "name": "2,2′:6′,2″-terpyridine",
            "formula": "C15H11N3",
            "role": "capping ligand",
            "amount": "1 molar equivalent"
          }
        ],
        "solvents": [
          "water"
        ],
        "temperature": "150 °C",
        "time": "72 h heating; 4 h cool-down; opened after ~12 h",
        "ph": null,
        "vessel_or_method": "hydrothermal synthesis in 23 mL Teflon-lined autoclave",
        "workup_and_crystallization": "Decant supernatant; wash three times with distilled water and ethanol; air-dry at room temperature overnight. Colorless block crystals.",
        "yield": null
      },
