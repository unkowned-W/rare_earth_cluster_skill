      ],
      "material_class": {
        "material_type": "cluster",
        "nuclearity": 7,
        "metal_composition": "homometallic",
        "rare_earth_elements": [
          "Gd"
        ],
        "other_metal_elements": [],
        "dimensionality": "0D",
        "structural_family": "non-planar heptanuclear Ln7; two incomplete cubes fused through a common Ln(III)"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "General protocol for 1–5: Ln(NO3)3·xH2O (x = 6 for 1) was added to a stirred solution of LH in methanol (30 mL). Triethylamine was added dropwise and the mixture was stirred for 12 h to give a clear yellow solution. Methanol was removed under reduced pressure, the residue was redissolved in methanol–acetonitrile (1:1) and filtered, and the filtrate was left to evaporate slowly at room temperature, giving yellow block crystals after 4 days. For 1: LH (0.061 g, 0.251 mmol), Gd(NO3)3·6H2O (0.113 g, 0.251 mmol), NEt3 (0.28 mL, 2.00 mmol).",
        "reagents": [
          {
            "name": "2-methoxy-6-(pyridin-2-yl-hydrazonomethyl) phenol (LH)",
            "formula": "C13H13N3O2",
            "role": "ligand",
            "amount": "0.061 g, 0.251 mmol"
          },
          {
            "name": "gadolinium(III) nitrate hexahydrate",
            "formula": "Gd(NO3)3·6H2O",
            "role": "metal source",
            "amount": "0.113 g, 0.251 mmol"
          },
          {
            "name": "triethylamine",
            "formula": "NEt3",
            "role": "base",
            "amount": "0.28 mL, 2.00 mmol"
          }
        ],
        "solvents": [
          "methanol",
          "acetonitrile"
        ],
        "temperature": "room temperature (crystallization)",
        "time": "stirred 12 h; crystals after 4 days",
        "ph": null,
        "vessel_or_method": "solution synthesis followed by slow evaporation",
        "workup_and_crystallization": "solvent removed under reduced pressure; residue redissolved in MeOH–MeCN (1:1), filtered; slow evaporation at room temperature gave yellow block crystals",
        "yield": "0.066 g (49% based on Gd)"
      },
      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "χMT(300 K) = 55.7 cm3 K mol−1 (calc. 55.2 for seven uncoupled Gd(III)). Weak intramolecular antiferromagnetic exchange inferred from the decrease of χMT toward low T and from magnetization below the Brillouin curve for seven uncoupled S = 7/2 ions. Significant magnetocaloric effect: −ΔSm = 27.7 J kg−1 K−1 at 3 K for 0–7 T (12.5 R).",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "χMT",
            "value": 55.7,
            "unit": "cm3 K mol−1",
            "conditions": "room temperature; dc susceptibility"
          },
          {
            "property_type": "magnetic",
            "name": "−ΔSm",
            "value": 27.7,
            "unit": "J kg−1 K−1",
            "conditions": "3 K; field change 0–7 T"
          }
        ]
      },
