{
  "title": "Copper Lanthanide Phosphonate Cages: Highly Symmetric {Cu3Ln9P6} and {Cu6Ln6P6} Clusters with C3v and D3h Symmetry",
  "doi": "10.1021/acs.inorgchem.5b00649",
