            "name": "Curie constant C",
            "value": 37.78,
            "unit": "cm3 K mol−1",
            "conditions": "Curie–Weiss fit of 1/χM vs T; mixture of 1 and 3"
          },
          {
            "property_type": "magnetic",
            "name": "Weiss temperature θ",
            "value": -7.73,
            "unit": "K",
