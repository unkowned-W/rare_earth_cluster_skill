      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Under aerobic ambient conditions, dmhmpH (0.14 g, 1.0 mmol) in MeCN/MeOH (24/2 mL) was treated with Gd(NO3)3·6H2O (0.23 g, 0.50 mmol) then NEt3 (0.52 g, 2.0 mmol). After 10 min, Mn(O2CPh)2·2H2O (0.33 g, 1.0 mmol) was added and the mixture was stirred 2 h, filtered, and concentrated by slow evaporation over 5 days to give black crystals of 1·3/2MeCN. Crystals were collected, washed with Et2O, and dried under vacuum for 3 h; dried solid analyzed as solvent-free.",
        "reagents": [
          {
            "name": "2-(pyridine-2-yl)propan-2-ol (dmhmpH)",
            "formula": "C8H11NO",
            "role": "ligand",
            "amount": "0.14 g, 1.0 mmol"
          },
          {
            "name": "gadolinium(III) nitrate hexahydrate",
            "formula": "Gd(NO3)3·6H2O",
            "role": "metal source",
            "amount": "0.23 g, 0.50 mmol"
          },
          {
            "name": "triethylamine",
            "formula": "NEt3",
            "role": "base",
            "amount": "0.52 g, 2.0 mmol"
          },
