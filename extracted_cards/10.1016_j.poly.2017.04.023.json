      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "Strong antiferromagnetic Fe···Fe coupling. χmT = 4.37 cm3 K mol−1 at 300 K (vs 17.5 expected for four uncoupled FeIII), falling to 0.05 cm3 K mol−1 at 2 K (S = 0). Fit of a dinuclear S = 5/2 model gives J = −127 cm−1 (g = 2.0). Reduced magnetization is not superimposed; M = 0.0523 NμB at 2 K, 5 T. No slow magnetic relaxation in ac susceptibility.",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "χmT",
            "value": 4.37,
            "unit": "cm3 K mol−1",
            "conditions": "300 K, 0.1 T"
          },
          {
            "property_type": "magnetic",
            "name": "χmT",
            "value": 0.05,
            "unit": "cm3 K mol−1",
            "conditions": "2 K, 0.1 T"
          },
          {
            "property_type": "magnetic",
            "name": "J (Fe–Fe, Ĥ = −2J SFe1·SFe2)",
            "value": -127,
