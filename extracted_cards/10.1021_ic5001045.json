      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "DC susceptibility (5.0–300 K, 0.1 T) shows weak intramolecular antiferromagnetic Gd···Gd coupling. χMT is nearly constant (~31.4 cm3 K mol−1) from 300 to ~100 K, then falls to 18.31 cm3 K mol−1 at 5.0 K. A 1-J MAGMUN fit of Hamiltonian eq 2 gave J = −0.09(1) cm−1 and g = 2.00(1).",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "χMT (room-temperature theoretical for 4 Gd(III))",
            "value": 31.5,
            "unit": "cm3 K mol-1",
            "conditions": "four noninteracting Gd(III), 8S7/2, g = 2"
          },
          {
            "property_type": "magnetic",
            "name": "χMT",
            "value": "~31.4 (300–~100 K); 18.31 at 5.0 K",
            "unit": "cm3 K mol-1",
            "conditions": "dc, 0.1 T, 5.0–300 K, crystalline 2·2MeOH"
          },
          {
            "property_type": "magnetic",
            "name": "exchange coupling J",
            "value": "-0.09(1)",
            "unit": "cm-1",
            "conditions": "1-J MAGMUN fit; H = -2J(S1·S2 + S1·S1' + S1'·S2')"
          },
          {
            "property_type": "magnetic",
            "name": "g-factor",
            "value": "2.00(1)",
            "unit": null,
            "conditions": "same MAGMUN fit as J"
          }
        ]
