      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "S4-symmetric achiral Dy6Mo4 cluster. χMT at 300 K is 89.9 cm3 mol−1 K (six DyIII expected 85.0). χMT falls to 79.9 cm3 mol−1 K at ~12 K then rises to 89.5 at 2 K, indicating intramolecular ferromagnetic coupling. M(2 K, 7 T) = 35.4 NμB without saturation. Frequency-dependent ac susceptibility below 5 K with χ″ peaks below 2.8 K; approximate SMM barrier Ea ≈ 23 K and τ0 ≈ 7×10−5 s.",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "χMT",
            "value": 89.9,
            "unit": "cm3 mol−1 K",
            "conditions": "300 K, 1000 Oe DC"
          },
          {
            "property_type": "magnetic",
            "name": "χMT",
            "value": 79.9,
            "unit": "cm3 mol−1 K",
            "conditions": "ca. 12 K, 1000 Oe"
