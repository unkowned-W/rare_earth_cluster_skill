      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "A solution of triethylamine (0.0122 g, 0.2 mmol) in MeOH (10 mL) was gradually added to a stirred solution of sodium acetate (0.0136 g, 0.1 mmol), HL (0.0224 g, 0.1 mmol), and Ln(NO3)3·6H2O (0.1 mmol; Ln = Gd for 1) in MeCN (10 mL). The mixture was stirred for a further 4 h at room temperature. Pale yellow X-ray quality crystals of 1–4 were obtained after 3–4 days, collected by filtration, and washed with cold MeOH. Yields 31–38%.",
        "reagents": [
          {
            "name": "(E)-methyl N'-(2-hydroxy-3-methoxybenzylidene)hydrazinecarboxylate",
            "formula": "HL",
            "role": "ligand",
            "amount": "0.0224 g, 0.1 mmol"
          },
          {
            "name": "gadolinium nitrate hexahydrate",
            "formula": "Gd(NO3)3·6H2O",
            "role": "metal source",
            "amount": "0.1 mmol"
          },
