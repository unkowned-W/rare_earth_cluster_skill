      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "The precursor [Zn(L)(MeCN)] was first prepared from equimolar H2L and Zn(OAc)2·2H2O in absolute MeCN (yield 51%). Complexes 1–5 were then obtained by reacting the precursor with LnCl3·6H2O (Ln = La, Nd, Yb, Er or Gd) and NaN3 at a molar ratio of 1:1:3 in mixed MeOH–MeCN. Partial transmetallation of the precursor in alcohol-containing solution places two Zn2+ ions and one Ln3+ ion in inner cis-N2O2 cores and two Ln3+ ions in outer O2O2 moieties. Full experimental details for 1–5 are stated to be in the Supporting information.",
        "reagents": [
          {
            "name": "[Zn(L)(MeCN)]",
            "formula": "[Zn(L)(MeCN)]",
            "role": "precursor",
            "amount": "1 equiv."
          },
          {
            "name": "lanthanum(III) chloride hexahydrate",
            "formula": "LaCl3·6H2O",
            "role": "metal source",
            "amount": "1 equiv. (molar ratio 1:1:3 vs precursor and NaN3)"
          },
