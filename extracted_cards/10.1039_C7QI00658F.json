            "name": "europium(III) acetylacetonate dihydrate",
            "formula": "[Eu(acac)3(H2O)2]",
            "role": "metal precursor",
            "amount": "0.025 mmol"
          }
        ],
        "solvents": [
          "methanol",
          "dichloromethane"
        ],
        "temperature": "room temperature",
        "time": "stirred 4 h; crystals after a few days of evaporation",
        "ph": null,
        "vessel_or_method": "atmospheric stirring followed by filtration and slow evaporation",
        "workup_and_crystallization": "filtered; filtrate concentrated by slow evaporation at room temperature to give yellow-green block crystals",
        "yield": "ca. 48% (based on Eu)"
      },
      "properties": {
