      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Dy(NO3)3·6H2O (0.44 g, 1.0 mmol) was dissolved in MeOH/CH2Cl2 (1:3, 20 mL). 3-[Bis(2-hydroxyethyl)amino]propan-1-ol (0.13 mL, 1.0 mmol) and triethylamine (0.55 mL, 4.0 mmol) were added, giving a colourless solution that was stirred for 6 hours. The solution was filtered and layered with diethyl ether. Block-shaped crystals formed within 1–2 days. The ligand pdeaH3 was prepared separately by refluxing diethanolamine, 3-chloropropanol and KOH in water.",
        "reagents": [
          {
            "name": "dysprosium(III) nitrate hexahydrate",
            "formula": "Dy(NO3)3·6H2O",
            "role": "metal source",
            "amount": "0.44 g, 1.0 mmol"
          },
          {
            "name": "3-[bis(2-hydroxyethyl)amino]propan-1-ol",
            "formula": "pdeaH3",
            "role": "ligand",
            "amount": "0.13 mL, 1.0 mmol"
          },
          {
            "name": "triethylamine",
            "formula": "NEt3",
            "role": "base",
            "amount": "0.55 mL, 4.0 mmol"
          }
        ],
        "solvents": [
          "MeOH",
          "CH2Cl2",
          "diethyl ether"
        ],
        "temperature": null,
        "time": "6 h stirring; crystals within 1–2 days",
        "ph": null,
        "vessel_or_method": "solution reaction followed by diethyl ether layering",
        "workup_and_crystallization": "Filtered after stirring and layered with Et2O; block-shaped crystals within 1–2 days.",
        "yield": "approximately 23%"
      },
      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "The Dy6 wheel shows a room-temperature chiMT near the free-ion value, a sharp drop below 20 K, and a weakly S-shaped low-field magnetization at 2 K associated with toroidal magnetism. Slow relaxation is observed: a small zero-field barrier and a larger field-assisted barrier dominated by direct and Raman processes.",
