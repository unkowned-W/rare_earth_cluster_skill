      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "The dihydroxylated (OH)2-Salophen ligand H4L (N,N'-bis(3-hydroxyl salicylidene)benzene-1,2-diamine) was obtained by reaction of o-phenylenediamine with 2,3-dihydroxylbenzaldehyde in a 1:2 molar ratio (63% yield). Self-assembly of H4L with LaCl3·6H2O in a 1:1 molar ratio afforded homoleptic linear tetranuclear [La4(H2L)2(L)2(EtOH)2] (1), isostructural with crystallographically characterized 3·DMF.",
        "reagents": [
          {
            "name": "o-phenylenediamine",
            "formula": "C6H8N2",
            "role": "ligand precursor",
            "amount": "1:2 molar ratio vs 2,3-dihydroxylbenzaldehyde"
          },
          {
            "name": "2,3-dihydroxylbenzaldehyde",
            "formula": "C7H6O3",
            "role": "ligand precursor",
            "amount": "2 equiv vs o-phenylenediamine"
          },
          {
            "name": "H4L ((OH)2-Salophen)",
            "formula": "C20H16N2O4",
