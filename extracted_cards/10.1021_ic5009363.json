        "yield": null
      },
      "properties": {
        "reported": true,
        "property_type": "both",
        "summary": "PMMA films of Tb9(sal-Me) show visible Faraday rotation at 15000 Oe; Tb-normalized FRC is much larger than mononuclear Tb(acac)3(H2O)2 and ~150 times that of Tb oxide borosilicate glass per Tb ion. Shape-measure analysis indicates larger coordination-geometry strain than Tb9(sal-Bu).",
