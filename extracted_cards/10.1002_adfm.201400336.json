      "synthesis": {
        "main_text_has_explicit_synthesis": false,
        "si_used": true,
        "procedure": "Homometallic Ln6 clusters were prepared by a modified literature route. Ln(NO3)3·6H2O (0.228 g, 0.5 mmol) and 1-[N,N-bis(2-hydroxyethyl)amino]-2-propanol (Me-teaH3, 0.326 g, 2 mmol) were dissolved in MeCN/MeOH (18/14 mL) and stirred at 60 °C for 10 min. Triethylamine (0.3 mL) was added to the clear colorless solution, and the mixture was refluxed for a further 20 min. The clear solution was left undisturbed in air; after 1 day colorless block-like crystals of the Tm analogue were collected (yield 41%). Main-text crystallography and CCDC data correspond to the hexasolvate [Tm6(Me-teaH)6(NO3)6]·6MeCN.",
        "reagents": [
          {
            "name": "thulium(III) nitrate hexahydrate",
