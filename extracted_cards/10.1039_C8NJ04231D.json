            "formula": "CH3COONa",
            "role": "bridging carboxylate source",
            "amount": "0.0136 g, 0.1 mmol"
          },
          {
            "name": "triethylamine",
            "formula": "NEt3",
            "role": "base",
            "amount": "0.0122 g, 0.2 mmol"
          }
        ],
        "solvents": [
          "MeOH",
          "MeCN"
        ],
        "temperature": "room temperature",
        "time": "stirred 4 h; crystals after 3–4 days",
