{
  "title": "Synthesis and characterization of isostructural tetranuclear lanthanide complexes [Ln4(μ3-OH)2(ampdH2)2(piv)10]·4CH3CN (Ln = Sm, Eu, Gd, Tb, Dy, Ho, Er)",
  "doi": "10.1016/j.poly.2012.03.022",
  "list_of_rare_earth_compounds": [
    {
      "compound_label": "1",
      "compound_name": "[Sm4(μ3-OH)2(ampdH2)2(piv)10]·4MeCN",
      "formula": "[Sm4(μ3-OH)2(ampdH2)2(piv)10]·4MeCN",
      "ccdc_numbers": [
        "1951722"
      ],
      "ccdc_refcodes": [
        "POSHOX"
      ],
      "material_class": {
        "material_type": "cluster",
        "nuclearity": 4,
        "metal_composition": "homometallic",
        "rare_earth_elements": [
          "Sm"
        ],
        "other_metal_elements": [],
        "dimensionality": "0D",
        "structural_family": "centrosymmetric tetranuclear butterfly/planar Ln4 core with two μ3-OH"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Same procedure as for 5: a solution of 3-amino-3-methylpentane-1,5-diol (ampdH2, 1.5 mmol) in MeCN (15 mL) was added dropwise over 20 min to a stirred solution of Sm(NO3)3·xH2O (0.25 mmol) and pivalic acid (1.00 mmol) in MeCN (15 mL). The mixture was stirred at room temperature for a further 2 h, filtered, and allowed to stand undisturbed in a sealed vial. Crystals of (1)·4MeCN formed after 3 days. The later synthetic comments also describe refluxing Ln(NO3)3·6H2O, ampdH2 and pivalic acid in a 6:1:4 molar ratio in MeCN without added base.",
        "reagents": [
          {
            "name": "3-amino-3-methylpentane-1,5-diol (ampdH2)",
            "formula": "C6H15NO2",
            "role": "chelating ligand",
            "amount": "1.5 mmol"
          },
          {
            "name": "samarium(III) nitrate hydrate",
            "formula": "Sm(NO3)3·xH2O",
            "role": "metal source",
            "amount": "0.25 mmol"
          },
          {
            "name": "pivalic acid",
            "formula": "C5H10O2",
            "role": "coligand",
            "amount": "1.00 mmol"
          }
        ],
        "solvents": [
          "MeCN"
        ],
        "temperature": "room temperature (detailed procedure); refluxing conditions also stated in synthetic comments",
        "time": "dropwise addition over 20 min, then 2 h stirring; crystals after 3 days",
        "ph": null,
        "vessel_or_method": "aerobic solution reaction, filtration, crystallization in a sealed vial",
        "workup_and_crystallization": "filtered and left undisturbed in a sealed vial; crystals isolated analogously to 5",
        "yield": "ca. 48%"
      },
