            "role": "metal source",
            "amount": "0.3 mmol (approximately 135 mg)"
          },
          {
            "name": "triethylamine",
            "formula": "NEt3",
            "role": "base",
            "amount": "0.10 mL"
          }
        ],
        "solvents": [
          "CH3OH",
