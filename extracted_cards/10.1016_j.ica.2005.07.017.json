      "compound_label": "1",
      "compound_name": "[La3(qMe)9(H)(NO3)] (methanol solvate)",
      "formula": "La3(qMe)9(H)(NO3)·4MeOH",
      "ccdc_numbers": [
        "261243"
      ],
      "ccdc_refcodes": [
        "YATVEV"
      ],
      "material_class": {
        "material_type": "cluster",
        "nuclearity": 3,
        "metal_composition": "homometallic",
        "rare_earth_elements": [
          "La"
        ],
        "other_metal_elements": [],
        "dimensionality": "0D",
        "structural_family": "trinuclear 8-quinolinolate cluster"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "A methanol solution of La(NO3)3·6H2O (0.866 g, 2 mmol) and 2-methyl-8-quinolinol (1.9 g, 12 mmol) in 100 ml methanol was heated to 60 °C. Aqueous ammonia (4 ml of 1 M) was added dropwise with stirring until the mixture was slightly alkaline (pH ~8). After 30 min stirring, yellow crystals were filtered, washed with methanol and ether, dried under vacuum, and recrystallized from methanol.",
        "reagents": [
          {
            "name": "lanthanum nitrate hexahydrate",
            "formula": "La(NO3)3·6H2O",
            "role": "metal precursor",
            "amount": "0.866 g, 2 mmol"
          },
          {
            "name": "2-methyl-8-quinolinol",
            "formula": "HqMe",
            "role": "ligand",
            "amount": "1.9 g, 12 mmol"
          },
          {
            "name": "aqueous ammonia",
            "formula": "NH3(aq)",
            "role": "base",
            "amount": "4 ml of 1 M"
          }
        ],
        "solvents": [
          "methanol",
          "ether (wash)"
        ],
        "temperature": "60 °C",
        "time": "30 min",
        "ph": "~8",
        "vessel_or_method": "solution synthesis with dropwise ammonia addition",
        "workup_and_crystallization": "filtration, wash with methanol and ether, vacuum drying, recrystallization from methanol",
        "yield": "0.99 g (78%)"
      },
      "properties": {
        "reported": true,
        "property_type": "optical",
        "summary": "Photoluminescence of 1 in pyridine is ca. 3×10^3 times weaker than mononuclear La(qMe)3(py)2 (2) under identical settings, attributed to the more complicated structure and emission-quenching nitrate.",
        "measurements": [
          {
            "property_type": "optical",
            "name": "relative photoluminescence intensity vs 2",
            "value": "ca. 3e-3 times that of 2",
            "unit": null,
            "conditions": "pyridine solution; excitation ~400 nm; identical slit, integration time, concentration"
          }
        ]
      },
