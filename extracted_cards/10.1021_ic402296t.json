      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Cages 1–9 were prepared under similar solvothermal conditions. [Ni2(μ2-OH2)(O2CtBu)4(HO2CtBu)4] (0.1 g, 0.1 mmol), [Gd2(O2CtBu)6(HO2CtBu)6] (0.075 mmol), methylphosphonic acid (0.1 mmol), and triethylamine (0.1 mL, 1 mmol) in acetonitrile (8 mL) were stirred at room temperature for 5 min. The slurry was transferred into a 10 mL Teflon-lined autoclave, heated to 150 °C for 12 h, and cooled to room temperature at 0.05 °C min−1. Yellow X-ray-quality crystals of 1 were obtained directly from the autoclave.",
        "reagents": [
          {
            "name": "[Ni2(μ2-OH2)(O2CtBu)4(HO2CtBu)4]",
            "formula": "[Ni2(μ2-OH2)(O2CtBu)4(HO2CtBu)4]",
            "role": "Ni source",
            "amount": "0.1 g, 0.1 mmol"
          },
          {
            "name": "[Gd2(O2CtBu)6(HO2CtBu)6]",
            "formula": "[Gd2(O2CtBu)6(HO2CtBu)6]",
            "role": "Gd source",
            "amount": "0.075 mmol"
          },
          {
            "name": "methylphosphonic acid",
            "formula": "MePO3H2",
            "role": "phosphonate ligand",
            "amount": "0.1 mmol"
          },
          {
            "name": "triethylamine",
            "formula": "Et3N",
            "role": "base",
            "amount": "0.1 mL, 1 mmol"
          }
        ],
        "solvents": [
          "acetonitrile"
        ],
        "temperature": "stir 5 min at room temperature; then 150 °C solvothermal",
        "time": "12 h at 150 °C, then cool at 0.05 °C min−1",
