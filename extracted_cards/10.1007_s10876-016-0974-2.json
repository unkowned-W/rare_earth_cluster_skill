      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "A mixture of Tb(NO3)3·6H2O (45 mg, 0.1 mmol), Na2SiO3 (6 mg, 0.05 mmol), NaOH (10 mg, 0.25 mmol), H2L (68 mg, 0.25 mmol; H2L = 2-{[(2-hydroxy-3-methoxyphenyl)methylidene]amino}benzoic acid) and 10 mL of ethanol was placed in a glass tube and heated at 75 °C for 2 days under autogenous pressure. Slow cooling to room temperature over 24 h gave yellow crystals of 1, which were collected by filtration, washed with Et2O (2 × 3 mL) and dried in air. The anthranilate co-ligand C6H4NH2COO− is derived from decomposition of H2L.",
        "reagents": [
          {
            "name": "terbium(III) nitrate hexahydrate",
            "formula": "Tb(NO3)3·6H2O",
            "role": "metal source",
            "amount": "45 mg, 0.1 mmol"
          },
          {
            "name": "sodium silicate",
            "formula": "Na2SiO3",
            "role": "silicate source / bridging ligand precursor",
            "amount": "6 mg, 0.05 mmol"
          },
          {
            "name": "sodium hydroxide",
            "formula": "NaOH",
            "role": "base",
            "amount": "10 mg, 0.25 mmol"
          },
          {
            "name": "2-{[(2-hydroxy-3-methoxyphenyl)methylidene]amino}benzoic acid",
            "formula": "H2L",
            "role": "Schiff-base ligand",
            "amount": "68 mg, 0.25 mmol"
          }
        ],
        "solvents": [
          "ethanol"
        ],
        "temperature": "75 °C",
