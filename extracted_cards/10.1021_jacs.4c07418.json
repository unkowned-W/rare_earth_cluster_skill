        "structural_family": "{Ln20} molecular cluster-aggregate"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Following a modified Zheng procedure, Gd(NO3)3·6H2O (180.5 mg), Er(NO3)3·6H2O (44.3 mg), Yb(NO3)3·6H2O (224.5 mg), and 6-chloro-2-pyridinol (134 mg, 1.00 mmol) were added to 20 mL of MeOH/MeCN (1:1), then triethylamine (0.139 mL, 1.00 mmol) was added. After 12 h the solution was filtered and left undisturbed in an open vial for solvent evaporation at room temperature. Colorless block-like single crystals formed in 5–10 days.",
        "reagents": [
          {
            "name": "gadolinium nitrate hexahydrate",
            "formula": "Gd(NO3)3·6H2O",
            "role": "metal source",
            "amount": "180.5 mg"
          },
          {
            "name": "erbium nitrate hexahydrate",
            "formula": "Er(NO3)3·6H2O",
            "role": "metal source",
            "amount": "44.3 mg"
          },
          {
            "name": "ytterbium nitrate hexahydrate",
            "formula": "Yb(NO3)3·6H2O",
            "role": "metal source",
            "amount": "224.5 mg"
          },
          {
            "name": "6-chloro-2-pyridinol",
            "formula": "C5H4ClNO",
            "role": "ligand",
            "amount": "134 mg, 1.00 mmol"
          },
          {
            "name": "triethylamine",
            "formula": "NEt3",
            "role": "base",
            "amount": "0.139 mL, 1.00 mmol"
          }
        ],
        "solvents": [
          "MeOH/MeCN (1:1)"
        ],
        "temperature": "room temperature",
        "time": "12 h stirring, then 5–10 days crystallization",
        "ph": null,
        "vessel_or_method": "open vial, solvent evaporation",
        "workup_and_crystallization": "solution filtered after 12 h and left undisturbed for evaporation; colorless block-like single crystals",
        "yield": "41–58% (range for the MCA series)"
      },
      "properties": {
        "reported": true,
        "property_type": "optical",
        "summary": "Yb/Er molecular upconverter in deuterated methanol; two-photon UC with green (~550 nm, 4S3/2→4I15/2) and red (~667 nm, 4F9/2→4I15/2) bands. UCQY 7.2×10−6 %. Average lifetimes 146 μs (green) and 236 μs (red). First TCL luminescent thermometer based on molecular upconverters; SR max 1.64% K−1 at 268 K.",
        "measurements": [
          {
            "property_type": "optical",
            "name": "upconversion quantum yield",
            "value": "7.2e-6",
            "unit": "%",
            "conditions": "solution; 980 nm excitation; {Gd20} used as blank"
          },
          {
            "property_type": "optical",
            "name": "emission lifetime",
            "value": 146,
            "unit": "μs",
            "conditions": "4S3/2→4I15/2, 550 nm band"
          },
          {
            "property_type": "optical",
            "name": "emission lifetime",
            "value": 236,
            "unit": "μs",
            "conditions": "4F9/2→4I15/2, 667 nm band"
          },
          {
            "property_type": "optical",
            "name": "relative thermal sensitivity SR",
            "value": 1.64,
            "unit": "% K−1",
            "conditions": "TCL thermometer; maximum at −5 °C (268 K); 980 nm, P = 20 W cm−2"
          }
        ]
      },
