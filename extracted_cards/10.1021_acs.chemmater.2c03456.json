      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Cerium(IV) ammonium nitrate was added in deionized water to concentrated aqueous ammonia to precipitate hydrated cerium dioxide. The precipitate was centrifuged and washed until the supernatant was neutral, then dissolved in nitric acid to give a 0.4 mol L−1 cerium solution at approximately 3 mol L−1 acidity. Electro-oxidation at 1 mA maintained Ce(IV) during measurement. The dimeric assignment concerns this solution, not a deposited single-crystal structure.",
        "reagents": [
          {
            "name": "cerium(IV) ammonium nitrate",
            "formula": "(NH4)2Ce(NO3)6",
            "role": "cerium precursor",
            "amount": null
          },
          {
            "name": "concentrated aqueous ammonia",
            "formula": "NH3·H2O",
            "role": "precipitant",
            "amount": "28%"
          },
          {
            "name": "nitric acid",
            "formula": "HNO3",
            "role": "dissolution medium",
            "amount": "65%; approximately 3 mol L−1 final acidity"
          }
        ],
        "solvents": [
          "deionized water",
          "aqueous nitric acid"
        ],
        "temperature": null,
        "time": null,
        "ph": "Precipitate washed until the supernatant was neutral",
        "vessel_or_method": "Precipitation, centrifugation, dissolution, and in situ electro-oxidation",
        "workup_and_crystallization": "Centrifuged for 6 min at 14,000 rpm and washed with deionized water; no crystallization reported for this solution",
        "yield": null
