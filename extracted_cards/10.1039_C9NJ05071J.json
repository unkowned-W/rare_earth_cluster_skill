        ],
        "dimensionality": "0D",
        "structural_family": "{Co2Gd4} phosphonate cage with two O-bridged Gd2O2 units linked by O–P–O bridges"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "A methanol solution (10 cm3) of GdCl3·6H2O (0.245 g, 0.660 mmol), CoCl2·6H2O (0.119 g, 0.500 mmol) and 2,2′-bipyridine (0.103 g, 0.660 mmol) was added to a mixture of Na2HSAA·H2O (0.305 g, 1.00 mmol) and NaOH (1.00 mmol) in methanol (50 cm3). The clear solution immediately changed from bright-yellow to brown-orange. The closed vessel was left standing for one week; the colour darkened and dark brown crystals formed. Crystals were isolated by decantation, washed with methanol and dried in open air.",
        "reagents": [
          {
            "name": "gadolinium(III) chloride hexahydrate",
            "formula": "GdCl3·6H2O",
            "role": "metal source",
            "amount": "0.245 g, 0.660 mmol"
          },
          {
            "name": "cobalt(II) chloride hexahydrate",
            "formula": "CoCl2·6H2O",
            "role": "metal source",
            "amount": "0.119 g, 0.500 mmol"
          },
          {
            "name": "2,2′-bipyridine",
            "formula": "C10H8N2",
            "role": "coligand",
            "amount": "0.103 g, 0.660 mmol"
          },
          {
            "name": "Na2HSAA monohydrate",
            "formula": "Na2HSAA·H2O",
            "role": "phosphonate ligand",
            "amount": "0.305 g, 1.00 mmol"
          },
          {
            "name": "sodium hydroxide",
            "formula": "NaOH",
            "role": "base",
            "amount": "1.00 mmol"
          }
        ],
        "solvents": [
          "methanol"
        ],
        "temperature": "ambient (standing)",
        "time": "one week",
        "ph": null,
        "vessel_or_method": "closed vessel, solution reaction in methanol",
        "workup_and_crystallization": "Dark brown crystals formed on standing; isolated by decantation, washed with methanol and dried in open air.",
        "yield": "0.184 g, 38.9% based on Gd"
      },
      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "Diamagnetic LS Co(III); four Gd(III) centres with room-temperature χT ≈ 31 cm3 K mol−1 (spin-only 31.5). χT decreases below ~50 K to ~26 cm3 K mol−1 at 2 K. Curie–Weiss: C ≈ 31.1 cm3 K mol−1, θ ≈ −0.37 K (antiferromagnetic). Fit of two Gd2O2 pairs: J = −0.04 cm−1, g = 1.99. Magnetization saturates at ~27 Nβ at 2 K (calc. 28 Nβ). Magnetocaloric −ΔSM = 20 J kg−1 K−1 at Tav = 2.25 K and Hf = 5 T (theoretical 24 J kg−1 K−1).",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "χT (high T, 0.1 T)",
            "value": "about 31",
            "unit": "cm3 K mol−1",
            "conditions": "powdered sample, 2–300 K, dc field 0.1 T; temperature-independent down to ~50 K; virtually identical for 1–3"
          },
          {
            "property_type": "magnetic",
            "name": "χT (2 K)",
            "value": "about 26",
            "unit": "cm3 K mol−1",
            "conditions": "dc field 0.1 T; steep drop below 10 K"
          },
          {
            "property_type": "magnetic",
            "name": "Curie constant C",
            "value": "about 31.1",
            "unit": "cm3 K mol−1",
            "conditions": "Curie–Weiss fit χ = C/(T−θ); all three complexes"
          },
          {
            "property_type": "magnetic",
            "name": "Weiss temperature θ",
            "value": "about −0.37",
            "unit": "K",
            "conditions": "Curie–Weiss fit; all three complexes"
          },
          {
            "property_type": "magnetic",
            "name": "exchange coupling J",
            "value": "-0.04",
            "unit": "cm−1",
            "conditions": "Ĥ = −J(SGd1·SGd2 + SGd3·SGd4); g = 1.99; all three complexes"
          },
          {
            "property_type": "magnetic",
            "name": "saturation magnetization",
            "value": "about 27",
            "unit": "Nβ",
            "conditions": "2 K; calculated 28 Nβ"
          },
          {
            "property_type": "magnetic",
            "name": "magnetic entropy change −ΔSM",
            "value": "20",
            "unit": "J kg−1 K−1",
            "conditions": "Tav = 2.25 K, Hf = 5 T (Hi = 0); theoretical 24 J kg−1 K−1"
          }
        ]
      },
