        "structural_family": "sandglass-like Ln9 cluster"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "A mixture of Tb(NO3)3·6H2O (0.2 mmol, 90.6 mg) and H4L (0.1 mmol, 25.6 mg) in 15 mL methanol/dichloromethane (1:2 v/v) was stirred for 30 min, then Et3N (0.4 mmol) was added. The mixture was stirred for another 60 min, heated in a Teflon-lined steel bomb at 80 °C for four days, and filtered. The yellow solution was left to evaporate slowly; yellow single crystals formed after about one week, were collected by filtration, washed with cold methanol and dichloromethane, and dried in air.",
        "reagents": [
          {
            "name": "terbium(III) nitrate hexahydrate",
            "formula": "Tb(NO3)3·6H2O",
            "role": "metal source",
            "amount": "0.2 mmol, 90.6 mg"
          },
          {
            "name": "2-(((2-hydroxy-3-methoxyphenyl)methylene)amino)-2-(hydroxymethyl)-1,3-propanediol",
            "formula": "H4L",
            "role": "ligand",
            "amount": "0.1 mmol, 25.6 mg"
          },
          {
            "name": "triethylamine",
            "formula": "Et3N",
            "role": "base",
            "amount": "0.4 mmol"
          }
        ],
        "solvents": [
          "methanol",
          "dichloromethane"
        ],
        "temperature": "stirring at ambient temperature, then 80 °C solvothermal",
        "time": "30 min + 60 min stirring, then 4 days solvothermal; crystals after about 1 week",
        "ph": null,
        "vessel_or_method": "combined conventional stirring then Teflon-lined steel bomb solvothermal synthesis",
        "workup_and_crystallization": "filtered; slow evaporation of the yellow solution; crystals washed with cold methanol and dichloromethane and dried in air",
        "yield": "28.0 mg, 28.2% based on Tb"
      },
      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "Dominant antiferromagnetic interactions. χMT at 300 K is 105.46 cm3 K mol−1 (expected 106.38 for nine non-interacting TbIII) and decreases to 29.92 cm3 K mol−1 at 2 K. No SMM behavior is indicated for 1 under the reported ac conditions.",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "χMT",
            "value": 105.46,
            "unit": "cm3 K mol−1",
            "conditions": "300 K, 1000 Oe dc field, polycrystalline sample"
          },
          {
            "property_type": "magnetic",
            "name": "χMT",
            "value": 29.92,
            "unit": "cm3 K mol−1",
            "conditions": "2 K, 1000 Oe dc field"
          }
        ]
      },
