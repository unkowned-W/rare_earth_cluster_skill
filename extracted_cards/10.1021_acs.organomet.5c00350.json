        "structural_family": "tetranuclear cyclopentadienyl anthracenylboronate cluster"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Under vacuum using Schlenk techniques, a solution of 9-anthracenylboronic acid in DME (5 mL) was added to a solution of Sc(Cp)3 in DME (5 mL). The mixture was stirred for 30 min and left at ambient temperature overnight. Precipitated crystals were separated by decantation, washed with cold DME and dried in vacuum.",
        "reagents": [
          {
            "name": "scandium tris(cyclopentadienyl)",
            "formula": "Sc(Cp)3",
            "role": "metal precursor",
            "amount": "48 mg (0.200 mmol)"
          },
          {
            "name": "9-anthracenylboronic acid",
            "formula": "AntB(OH)2",
            "role": "ligand",
            "amount": "44.4 mg (0.200 mmol)"
          }
        ],
        "solvents": [
          "DME"
        ],
        "temperature": "ambient temperature after 30 min stirring",
        "time": "30 min stirring, then overnight",
        "ph": null,
        "vessel_or_method": "Schlenk techniques under vacuum",
        "workup_and_crystallization": "Crystals precipitated from the reaction mixture were isolated by decantation, washed with cold DME and dried in vacuum.",
        "yield": "60.5 mg (65%)"
      },
      "properties": {
        "reported": true,
        "property_type": "optical",
        "summary": "Solid-state ligand-centered excimer photoluminescence in the 350–650 nm region with emission maximum at 490 nm (blue-green), red-shifted relative to the free acid because of T-shaped C–H···π packing.",
        "measurements": [
          {
            "property_type": "optical",
            "name": "PL emission maximum",
            "value": 490,
            "unit": "nm",
            "conditions": "solid sample, λex = 375 nm"
          }
        ]
      },
