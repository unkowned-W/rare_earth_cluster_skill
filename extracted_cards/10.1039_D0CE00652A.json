        "dimensionality": "0D",
        "structural_family": "wheel-like hexanuclear Ln6 metallacycle"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "All {Ln6} complexes were prepared analogously to {Eu6}. H3shi (4.0 mg, 0.025 mmol), Ln(NO3)3·6H2O (0.025 mmol) and 2-pyca (6.0 mg, 0.050 mmol) were dissolved in 8 mL methanol and 24 mL acetonitrile and refluxed for 90 min. After cooling to room temperature, 0.025 mL pyridine was added, the mixture was refluxed for 15 min and filtered, and crystals formed by slow evaporation after one week.",
        "reagents": [
          {
            "name": "salicylhydroxamic acid (H3shi)",
            "formula": "C7H7NO3",
            "role": "ligand",
            "amount": "4.0 mg, 0.025 mmol"
          },
          {
            "name": "Nd(NO3)3·6H2O",
            "formula": "Nd(NO3)3·6H2O",
            "role": "metal source",
            "amount": "0.025 mmol (same stoichiometry as Eu analogue)"
          },
          {
            "name": "2-pyridinecarboxylic acid (2-pyca)",
            "formula": "C6H5NO2",
            "role": "coligand",
            "amount": "6.0 mg, 0.050 mmol"
          },
          {
            "name": "pyridine",
            "formula": "C5H5N",
            "role": "base",
            "amount": "0.025 mL"
          }
        ],
        "solvents": [
          "methanol",
          "acetonitrile"
        ],
        "temperature": "reflux, then room-temperature crystallization",
        "time": "reflux 90 min, then 15 min after pyridine addition; crystals after 1 week",
        "ph": null,
        "vessel_or_method": "solution reflux then slow evaporation",
        "workup_and_crystallization": "filtered; slow evaporation of the filtrate yielded crystals after one week",
        "yield": "9.2 mg (65.4%)"
      },
      "properties": {
        "reported": true,
        "property_type": "optical",
        "summary": "Solid-state NIR emission of Nd3+ at 900, 1060 and 1340 nm (4F3/2→4I9/2, 4I11/2, 4I13/2) upon 339 nm excitation; τ = 10.3 μs and overall QY = 0.10% at room temperature.",
        "measurements": [
          {
            "property_type": "optical",
            "name": "NIR emission maxima",
            "value": "900, 1060, 1340",
            "unit": "nm",
            "conditions": "solid state, λex = 339 nm, room temperature"
          },
          {
            "property_type": "optical",
            "name": "luminescence lifetime",
            "value": 10.3,
            "unit": "μs",
            "conditions": "solid state, room temperature; Table 2, λex = 346–360 nm"
          },
          {
            "property_type": "optical",
            "name": "overall quantum yield",
            "value": 0.1,
            "unit": "%",
            "conditions": "solid state, room temperature"
          },
          {
