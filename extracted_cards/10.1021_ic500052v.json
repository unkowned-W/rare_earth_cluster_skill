      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "χMT of 2 is 84.2 cm3 mol−1 K at 300 K (anticipated 85.0) and 50.4 cm3 mol−1 K at 2 K, with the low-T drop attributed mainly to crystal-field effects. Only the Dy analogue shows slowly relaxing magnetization: χM″ is nonzero below 15 K without a zero-field peak due to QTM; under Hdc = 5 kOe frequency-dependent χ′ and χ″ maxima give Arrhenius parameters Δ/kB = 46.2 K and τ0 = 2.85 × 10−7 s (SMM). Cole–Cole analysis gives a large α ≈ 0.40, suggesting a distribution of relaxation times from the three distinct Dy sites.",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "χMT",
            "value": "84.2",
            "unit": "cm3 mol−1 K",
            "conditions": "300 K, Hdc = 1000 Oe"
          },
          {
            "property_type": "magnetic",
            "name": "χMT",
            "value": "50.4",
            "unit": "cm3 mol−1 K",
            "conditions": "2 K, Hdc = 1000 Oe"
          },
          {
            "property_type": "magnetic",
            "name": "effective energy barrier Δ/kB",
            "value": "46.2",
            "unit": "K",
            "conditions": "ac susceptibility, Hac = 3 Oe, Hdc = 5 kOe; Arrhenius fit of ln τ vs 1/TB"
          },
          {
            "property_type": "magnetic",
            "name": "relaxation time prefactor τ0",
            "value": "2.85e-7",
            "unit": "s",
            "conditions": "ac susceptibility, Hac = 3 Oe, Hdc = 5 kOe; Arrhenius fit"
          },
          {
            "property_type": "magnetic",
            "name": "Cole–Cole α",
            "value": "ca. 0.40",
            "unit": null,
            "conditions": "compound 2; distribution of relaxation times"
          }
        ]
