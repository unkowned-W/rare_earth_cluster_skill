        }
      ],
      "structure_description": "The octameric polyoxoanion is assembled from two equivalent trimeric Bi6O3(OH)3Ce3(H2O)6(CO3)(B-α-SbW9O33)3 subunits linked by a central Krebs-type (WO2)2(WO3)2(B-β-BiW9O33)2 sandwich. Each trimeric subunit contains a central nonanuclear Bi6Ce3 oxo cluster encapsulated by three SbW9 fragments; the central Bi6Ce3 cluster comprises a basket-shaped Bi6 unit and a corner-sharing Ce3 carbonate cluster.",
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "ph": "5.0",
        "procedure": "Dissolve the reagents in water with stirring; add the bismuth nitrate solution dropwise; adjust pH to 5.0 with NaOH; add the Ce(III) nitrate solution and readjust pH to 5.0; stir for 10 min, heat, cool, filter, and slowly evaporate to crystallize.",
        "reagents": [
          {
            "amount": "1.503 g (0.525 mmol)",
            "formula": "Na9[B-α-SbW9O33]·19.5H2O",
            "name": "sodium trivacant antimonotungstate",
            "role": "POM precursor"
          },
          {
            "amount": "1.002 g (3.038 mmol)",
            "formula": "Na2WO4·2H2O",
            "name": "sodium tungstate dihydrate",
            "role": "tungstate source"
          },
          {
            "amount": "0.997 g (12.227 mmol)",
            "formula": "[(CH3)2NH2]Cl",
            "name": "dimethylammonium chloride",
            "role": "counterion source"
          },
          {
            "amount": "1.004 g (7.378 mmol)",
            "formula": "NaCH3COO·3H2O",
            "name": "sodium acetate trihydrate",
            "role": "buffer/reagent"
          },
          {
            "amount": "0.105 g (0.991 mmol)",
            "formula": "Na2CO3",
            "name": "sodium carbonate",
            "role": "carbonate source"
          },
          {
            "amount": "0.397 g (0.818 mmol), in 1 mL of 6 mol·L−1 HCl",
            "formula": "Bi(NO3)3·5H2O",
            "name": "bismuth nitrate pentahydrate",
            "role": "bismuth source"
          },
          {
            "amount": "0.254 g (0.585 mmol)",
            "formula": "Ce(NO3)3·6H2O",
            "name": "cerium(III) nitrate hexahydrate",
            "role": "rare-earth source"
          },
          {
            "amount": "2 mol·L−1 solution; amount not stated",
            "formula": "NaOH",
