      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "Dominant antiferromagnetic interactions and SMM behavior. χMT at 300 K is 119.37 cm3 K mol−1 (expected 127.53) and 25.46 cm3 K mol−1 at 2 K. Ac susceptibility in zero dc field shows frequency-dependent slow relaxation below 5 K; χ″ increases on cooling without a maximum above 2 K. Arrhenius fit of frequency-dependent ac data gives Ueff = 15.3(3) K and τ0 = 3.17×10−8 s; Cole–Cole plots fit a single relaxation process with α < 0.13. Magnetization versus H/T is not superimposable, consistent with anisotropy/low-lying excited states; a hysteresis at 2 K is noted.",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "χMT",
            "value": 119.37,
            "unit": "cm3 K mol−1",
            "conditions": "300 K, 1000 Oe dc field"
          },
          {
            "property_type": "magnetic",
            "name": "χMT",
            "value": 25.46,
            "unit": "cm3 K mol−1",
            "conditions": "2 K, 1000 Oe dc field"
          },
          {
            "property_type": "magnetic",
            "name": "Ueff",
            "value": "15.3(3)",
            "unit": "K",
            "conditions": "zero dc field ac; Arrhenius fit of frequency-dependent data (no χ″ maxima above 2 K)"
          },
          {
            "property_type": "magnetic",
            "name": "τ0",
            "value": 3.17e-08,
            "unit": "s",
            "conditions": "Arrhenius law from frequency-dependent ac susceptibility"
          },
          {
            "property_type": "magnetic",
            "name": "Cole–Cole α",
            "value": "<0.13",
            "unit": null,
            "conditions": "generalized Debye model, Fig. S14"
          },
          {
            "property_type": "magnetic",
            "name": "ac susceptibility",
            "value": "frequency-dependent χ′ and χ″ below 5 K; no χ″ peak above 2 K",
            "unit": null,
            "conditions": "zero dc field, 2.5 Oe ac field, 10–1000 Hz"
          }
        ]
      },
