      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "Compound 3 is a single-molecule magnet with two distinct thermal relaxation processes. Room-temperature χmT is close to four independent Dy(III) ions, low-temperature magnetization saturates, and any Dy···Dy exchange is very weak. AC susceptibility gives Ueff of 692 and 316 K. Dilution as Dy@7 raises the dominant barrier to 842 K by quenching relaxation through the first excited Kramers doublet; that doped phase is not a separate CCDC structure.",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "χmT",
            "value": "56.34",
            "unit": "cm^3 K mol^-1",
            "conditions": "room temperature; calculated 56.68 cm^3 K mol^-1 for four independent Dy(III) ions"
          },
          {
            "property_type": "magnetic",
            "name": "saturation magnetization",
            "value": "21.43",
            "unit": "μB",
            "conditions": "1.8 K, 70 kG"
          },
          {
            "property_type": "magnetic",
            "name": "Ueff (faster high-temperature process)",
            "value": "692",
            "unit": "K",
            "conditions": "zero d.c. field; τ0 = 6.6×10^-11 s; χ'' peak near 47 K at 1.2 kHz; 0.03 < α < 0.08"
          },
          {
            "property_type": "magnetic",
            "name": "Ueff (slower high-temperature process)",
            "value": "316",
            "unit": "K",
            "conditions": "zero d.c. field; τ0 = 2.6×10^-9 s; χ'' peak near 30 K at 1.2 kHz; 0.16 < α < 0.31"
          },
          {
            "property_type": "magnetic",
            "name": "a.c. field",
            "value": "1.55",
            "unit": "Oe",
            "conditions": "χ''(T) measured at 0.1–1.2 kHz in zero d.c. field"
          }
        ]
      },
