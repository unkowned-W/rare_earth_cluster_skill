      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "H2L1 was first prepared by dropwise addition of 2-amino-2-methyl-1-propanol (0.09 g, 1 mmol) in 5 mL methanol to 3-methoxysalicylaldehyde (0.15 g, 1 mmol) in 10 mL methanol under warming, refluxing 2 h, cooling, and diluting to 25 mL (1 mmol ligand stock). For 1, 5 mL of this H2L1 solution (0.2 mmol) was diluted to 15 mL with acetonitrile. Triethylamine (0.056 mL, 0.4 mmol) and Tb(NO3)3·5H2O (0.2 mmol in 2 mL methanol) were added and stirred 20 min. MnCl2·4H2O (0.04 g, 0.2 mmol) in 2 mL methanol was added, then pivalic acid (0.04 g, 0.4 mmol) and triethylamine (0.056 g, 0.4 mmol) in 3 mL methanol, and the mixture was stirred 5 h. The brown mixture was filtered and the filtrate evaporated at ambient temperature for a few days to give dark brown crystals, which were washed with cold methanol and dried in vacuo. Recrystallization from acetonitrile/diethyl ether by diffusion afforded diffraction-quality crystals.",
        "reagents": [
          {
            "name": "H2L1 (Schiff base from 3-methoxysalicylaldehyde and 2-amino-2-methyl-1-propanol)",
            "formula": "H2L1",
            "role": "ligand",
            "amount": "5 mL stock solution, 0.2 mmol"
          },
          {
