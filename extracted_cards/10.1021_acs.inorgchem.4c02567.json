        "VUCZOM"
      ],
      "material_class": {
        "material_type": "cluster",
        "nuclearity": 4,
        "metal_composition": "homometallic",
        "rare_earth_elements": [
          "Er"
        ],
        "other_metal_elements": [],
        "dimensionality": "0D",
        "structural_family": "[2×2] square-grid Ln4 phosphinate/pivalate cluster with μ4-carbonate template"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "To a 60 mL methanolic solution of R2PO2H [R = CH(OH)PhBr] was added ErCl3·6H2O and the mixture was stirred for 2–3 min. Tetramethylammonium hydroxide was added dropwise and stirring continued. After 30 min, a 2 mL methanolic solution of pivalic acid with Me4NOH was added. The reaction mixture was stirred for 5 h at room temperature. The solvent was evaporated; the white solid was washed twice with diethyl ether and crystallized from acetonitrile by slow evaporation to give X-ray-quality crystals.",
        "reagents": [
          {
            "name": "bis[α-hydroxy(p-bromophenyl)methyl]phosphinic acid (R2PO2H)",
            "formula": "R2PO2H (R = CH(OH)PhBr)",
            "role": "ligand",
            "amount": "0.100 g, 0.229 mmol"
          },
          {
            "name": "erbium(III) chloride hexahydrate",
            "formula": "ErCl3·6H2O",
            "role": "metal source",
            "amount": "0.043 g, 0.114 mmol"
          },
          {
            "name": "pivalic acid",
            "formula": "tBuCO2H",
            "role": "coligand",
            "amount": "0.023 g, 0.229 mmol"
          },
          {
            "name": "tetramethylammonium hydroxide (25% in MeOH)",
            "formula": "Me4NOH",
            "role": "base",
            "amount": "0.035 mL + 0.011 mL, 0.458 mmol"
          }
        ],
        "solvents": [
          "methanol",
          "diethyl ether (wash)",
          "acetonitrile (crystallization)"
        ],
        "temperature": "room temperature",
        "time": "2–3 min initial stir; 30 min after base; 5 h after pivalic acid addition",
        "ph": null,
        "vessel_or_method": "solution synthesis in methanol; rotary evaporation; crystallization by slow evaporation from acetonitrile",
        "workup_and_crystallization": "Solvent evaporated; white solid washed twice with diethyl ether and crystallized in acetonitrile to give X-ray-quality single crystals.",
        "yield": "0.92 g, 70.76% (based on ErCl3·6H2O)"
      },
      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "Room-temperature χMT = 46.15 cm3 K mol−1, consistent with four ErIII ions; χMT decreases on cooling to 22.15 cm3 K mol−1 at 2 K, indicating antiferromagnetic Er···Er interactions plus thermal depopulation of mJ levels. Magnetization at 2 K reaches 19.24 Nβ at 50 kOe without saturation. No slow magnetic relaxation at 0 Oe; under applied field only a χM″ contribution with maxima above 10 kHz. Calculated Jtot values are antiferromagnetic (J1 = −1.0, J2 = −0.8). Mixed toroidal moment computed (ground-state moment 16.42 μB) but experimental SMM/SMT behavior is not observed.",
        "measurements": [
          {
