      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "A mixture of bis(carboxyethylgermanium sesquioxide) (L; 0.0421 g, 0.124 mmol), 1,10-phenanthroline (0.0356 g, 0.197 mmol), Dy2O3 (0.0374 g, 0.100 mmol), and water (2 mL) was stirred for 0.5 h. The pH was adjusted to 2 with HCl (12 mol L−1). The mixture was sealed in a 20 mL Teflon-lined autoclave and heated at 150 °C for 7 days. After slow cooling to room temperature, yellow block crystals of 1a were obtained.",
        "reagents": [
          {
            "name": "bis(carboxyethylgermanium sesquioxide) (L)",
            "formula": "(HOOCCH2CH2Ge)2O3",
            "role": "Ge/carboxylate source",
            "amount": "0.0421 g, 0.124 mmol"
          },
          {
            "name": "1,10-phenanthroline",
            "formula": "C12H8N2",
            "role": "auxiliary chromophore ligand",
            "amount": "0.0356 g, 0.197 mmol"
          },
          {
            "name": "dysprosium(III) oxide",
            "formula": "Dy2O3",
            "role": "lanthanide source",
            "amount": "0.0374 g, 0.100 mmol"
          },
          {
            "name": "hydrochloric acid",
            "formula": "HCl",
            "role": "pH adjuster",
            "amount": "12 mol L−1, to pH 2"
          }
        ],
        "solvents": [
          "water"
        ],
        "temperature": "150 °C",
        "time": "stir 0.5 h; hydrothermal 7 days",
        "ph": "2",
        "vessel_or_method": "20 mL Teflon-lined autoclave, hydrothermal",
        "workup_and_crystallization": "slow cooling to room temperature; yellow block crystals",
        "yield": "45% based on Dy2O3"
      },
      "properties": {
        "reported": true,
        "property_type": "both",
        "summary": "Solid-state photoluminescence of 1a is ligand-sensitized Dy3+ emission (yellow CIE). χMT at 300 K is close to eight isolated Dy3+ ions and decreases on cooling, consistent with crystal-field depopulation and antiferromagnetic Dy···Dy interactions (negative Weiss constant).",
        "measurements": [
