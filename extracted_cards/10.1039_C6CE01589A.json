      },
      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "Dc susceptibility (1.8–300 K, 1 kOe) shows χMT = 55.13 cm3 mol−1 K at 300 K (close to 56.68 expected for four isolated DyIII; CoIII diamagnetic), a minimum of 50.20 cm3 mol−1 K at 14 K, then a rise to 57.91 cm3 mol−1 K at 1.8 K indicating intramolecular ferromagnetic Dy···Dy interactions. Zero-field ac data show frequency-dependent χ″ and SMM behaviour. Arrhenius analysis above 5 K gives Ueff = 41.9 K and τ0 = 1.21 × 10−7 s. Cole–Cole plots fit a generalized Debye model with α = 0.078–0.23, consistent with a single relaxation process.",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "χMT",
            "value": 55.13,
            "unit": "cm3 mol−1 K",
            "conditions": "300 K, 1 kOe dc field"
          },
          {
            "property_type": "magnetic",
            "name": "χMT",
            "value": 50.2,
            "unit": "cm3 mol−1 K",
            "conditions": "14 K (minimum)"
          },
          {
            "property_type": "magnetic",
            "name": "χMT",
            "value": 57.91,
            "unit": "cm3 mol−1 K",
            "conditions": "1.8 K"
          },
          {
            "property_type": "magnetic",
            "name": "Ueff",
            "value": 41.9,
            "unit": "K",
            "conditions": "zero dc field; thermally activated regime above 5 K from ac data 2–7 K"
          },
          {
            "property_type": "magnetic",
            "name": "τ0",
            "value": "1.21e-7",
            "unit": "s",
            "conditions": "Arrhenius fit above 5 K, zero dc field"
          },
          {
            "property_type": "magnetic",
            "name": "Cole–Cole α",
            "value": "0.078–0.23",
            "unit": null,
            "conditions": "2.0–7.0 K, zero dc field; generalized Debye model"
          }
        ]
      },
