        "workup_and_crystallization": "filtered; filtrate left undisturbed for slow evaporation to yellow single crystals after a week",
        "yield": "36 mg, 41.2% (based on Gd)"
      },
      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "Dc susceptibility (1.8–300 K, 1 kOe) shows χMT = 43.55 cm3 K mol-1 at 300 K, remaining fairly constant until ~50 K then dropping to 17.62 cm3 K mol-1 at 2 K, assigned to intramolecular antiferromagnetic Gd–Gd coupling. Curie–Weiss fit gives C = 44.40 cm3 K mol-1 and θ = -2.17 K. Ac susceptibility under zero dc field does not indicate SMM behavior.",
        "measurements": [
          {
            "property_type": "magnetic",
