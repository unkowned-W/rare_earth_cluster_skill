        ],
        "other_metal_elements": [],
        "dimensionality": "0D",
        "structural_family": "centrosymmetric tetranuclear butterfly/planar Dy4 core with two μ3-OH; intermolecular H-bonded chains"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "A solution of ampdH2 (1.5 mmol) in MeCN (15 mL) was added dropwise over 20 min to a stirred solution of Dy(NO3)3·xH2O (0.25 mmol) and pivalic acid (1.00 mmol) in MeCN (15 mL). The resulting mixture was stirred at room temperature for a further 2 h, filtered and allowed to stand undisturbed in a sealed vial. Colourless needles of (5)·4CH3CN suitable for X-ray crystallography were obtained after 3 days. Crystals were maintained in mother liquor for crystallography or collected by filtration, washed with MeCN and dried in vacuum for magnetic studies. Aerobic conditions.",
        "reagents": [
          {
            "name": "3-amino-3-methylpentane-1,5-diol (ampdH2)",
            "formula": "C6H15NO2",
            "role": "chelating ligand",
            "amount": "1.5 mmol"
          },
          {
            "name": "dysprosium(III) nitrate hydrate",
            "formula": "Dy(NO3)3·xH2O",
            "role": "metal source",
            "amount": "0.25 mmol"
          },
          {
            "name": "pivalic acid",
            "formula": "C5H10O2",
            "role": "coligand",
            "amount": "1.00 mmol"
          }
        ],
        "solvents": [
          "MeCN"
        ],
        "temperature": "room temperature",
        "time": "20 min addition + 2 h stirring; crystals after 3 days",
        "ph": null,
        "vessel_or_method": "aerobic stirring, filtration, sealed-vial crystallization",
        "workup_and_crystallization": "filtered and left undisturbed; crystals washed with MeCN and dried in vacuum for magnetism",
        "yield": "ca. 46%"
      },
      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "Weak intramolecular Dy···Dy coupling; χT decrease attributed mainly to Stark-level depopulation, with possible intermolecular AF contacts via H-bonds. Frequency-dependent ac susceptibility under zero dc field indicates SMM behaviour with Ueff = 5.4 K and τ0 = 1.1×10−5 s.",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "χT",
            "value": 56.16,
            "unit": "cm3 K mol−1",
            "conditions": "300 K, 1000 Oe dc field; expected 56.68 cm3 K mol−1 for four non-interacting DyIII"
          },
          {
            "property_type": "magnetic",
            "name": "χT",
            "value": 27.5,
            "unit": "cm3 K mol−1",
            "conditions": "1.8 K, 1000 Oe"
          },
          {
            "property_type": "magnetic",
            "name": "magnetization",
            "value": null,
            "unit": null,
            "conditions": "low T; no saturation at 70 kOe"
          },
          {
            "property_type": "magnetic",
            "name": "ac susceptibility / SMM energy barrier Δ",
            "value": 5.4,
            "unit": "K",
            "conditions": "zero dc field; Arrhenius fit of frequency-dependent ac data; oscillating ac field 3 Oe"
          },
          {
            "property_type": "magnetic",
            "name": "relaxation time prefactor τ0",
            "value": "1.1e-5",
            "unit": "s",
            "conditions": "zero dc field Arrhenius fit"
          }
        ]
      },
