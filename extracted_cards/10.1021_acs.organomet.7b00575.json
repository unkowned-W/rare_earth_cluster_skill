      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Under dry, oxygen-free argon (Schlenk or glovebox), a THF (15.0 mL) solution of 2-(2,6-DippNHCH2)C8H5NH (0.31 g, 1.0 mmol) was treated with a THF or toluene (15.0 mL) solution of (Me3SiCH2)3Yb(THF) (0.58 g, 1.0 mmol) at room temperature. The mixture was stirred at room temperature for 3 h (solution remained red). Solvent was removed under reduced pressure and the residue extracted with hexane (10.0 mL) and toluene (3.5 mL). Red crystals formed on standing at 0 °C for several days.",
        "reagents": [
