      "ccdc_refcodes": [],
      "material_class": {
        "material_type": "cluster",
        "nuclearity": 2,
        "metal_composition": "homometallic",
        "rare_earth_elements": [
          "Ce"
        ],
        "other_metal_elements": [],
        "dimensionality": "0D",
        "structural_family": "edge-sharing square-antiprism Ce2Br6 methanol dimer"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "In an argon glovebox, approximately 0.5 g of CeBr3 was placed in a round-bottom flask and septa-sealed. After removal from the glovebox, approximately 10 mL of anhydrous methanol was syringed in to give a supersaturated solution with some undissolved solid. The solution was syringe-filtered into a purged glass vessel and allowed to slowly evaporate under nitrogen, with care to exclude water. Colorless plate crystals of 1 formed.",
        "reagents": [
          {
            "name": "cerium(III) bromide",
            "formula": "CeBr3",
            "role": "metal salt",
            "amount": "approximately 0.5 g"
          }
        ],
        "solvents": [
          "anhydrous methanol"
        ],
        "temperature": null,
        "time": null,
        "ph": null,
        "vessel_or_method": "slow evaporation under nitrogen from a syringe-filtered supersaturated solution in a purged glass vessel; salt loaded in an argon glovebox",
        "workup_and_crystallization": "syringe filtration into a purged vessel followed by slow evaporation; colorless plate crystals",
        "yield": null
      },
      "properties": {
        "reported": true,
        "property_type": "optical",
        "summary": "Room-temperature photoluminescence of polycrystalline 1 (excitation 232 nm) shows a maximum emission at 368 nm, slightly blue-shifted versus CeBr3 (371 nm). Compound 1 was previously reported to scintillate.",
        "measurements": [
          {
            "property_type": "optical",
            "name": "excitation wavelength",
            "value": 232,
            "unit": "nm",
            "conditions": "room temperature; polycrystalline powder sealed under nitrogen"
          },
          {
            "property_type": "optical",
            "name": "emission maximum",
            "value": 368,
            "unit": "nm",
            "conditions": "excitation 232 nm; room temperature"
          }
        ]
      },
