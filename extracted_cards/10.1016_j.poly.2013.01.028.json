      "compound_label": "1",
      "compound_name": "((CH3)3NH)0.5[Nd9(L)16(μ3-OH)8(μ5-O)2](H2O)6",
      "formula": "((CH3)3NH)0.5[Nd9(L)16(μ3-OH)8(μ5-O)2](H2O)6",
      "ccdc_numbers": [],
      "ccdc_refcodes": [],
      "material_class": {
        "material_type": "cluster",
        "nuclearity": 9,
        "metal_composition": "homometallic",
        "rare_earth_elements": [
          "Nd"
        ],
        "other_metal_elements": [],
        "dimensionality": "0D",
        "structural_family": "nonanuclear Ln9 oxo/hydroxo cluster with (2-hydroxy-5-methylphenyl)propan-1-one"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Shared procedure for compounds 1–7: triethylamine (0.717 mmol, 0.1 mL) in 10 mL methanol was added slowly to a mixture of Ln(ClO4)3·nH2O (0.167 mmol; Ln = Nd, Eu, Tb, Gd, Dy, Er, Yb) and HL (0.305 mmol) in 20 mL methanol. The mixture was covered with parafilm or aluminum foil with pin holes and left for slow evaporation on a sand bath at 65 °C; for Ln = Nd the final mixture was placed in a refrigerator at 5 °C. Yellow plate-like crystals were obtained after 24 h. Lanthanide perchlorates were handled with care because of their explosive nature. Crystals are air-sensitive.",
        "reagents": [
          {
            "name": "neodymium perchlorate hydrate",
            "formula": "Nd(ClO4)3·nH2O",
            "role": "metal source",
            "amount": "0.167 mmol"
          },
          {
            "name": "(2-hydroxy-5-methylphenyl)propan-1-one",
            "formula": "HL",
            "role": "ligand",
            "amount": "0.305 mmol"
          },
          {
            "name": "triethylamine",
            "formula": "NEt3",
            "role": "base",
            "amount": "0.717 mmol, 0.1 mL"
          }
        ],
        "solvents": [
          "methanol"
        ],
        "temperature": "5 °C (refrigerator) for Nd; 65 °C sand bath for other analogues",
        "time": "24 h",
        "ph": null,
        "vessel_or_method": "slow evaporation; parafilm or perforated aluminum foil",
        "workup_and_crystallization": "yellow plate-like crystals from methanol; stored in mother liquor/paraffin oil for diffraction",
        "yield": "25–30% depending on the lanthanide(III) ion"
      },
