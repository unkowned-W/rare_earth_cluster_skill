          {
            "amount": "0.658 g, 0.125 mmol",
            "formula": "K14[As2W19O67(H2O)]",
            "name": "Polytungstoarsenate precursor",
            "role": "POM precursor"
          },
          {
            "amount": "0.075 g, 0.50 mmol",
            "formula": "C4H6O6",
            "name": "Racemic tartaric acid",
            "role": "Bridging ligand"
          },
          {
            "amount": "0.114 g, 0.30 mmol",
            "formula": "HoCl3·6H2O",
            "name": "Holmium(III) chloride hexahydrate",
            "role": "Rare-earth source"
          },
          {
            "amount": "1.00 mol L−1 solution; volume not reported",
            "formula": "LiOH",
            "name": "Lithium hydroxide",
            "role": "pH adjustment"
          }
        ],
        "si_used": false,
        "solvents": [
          "Water, 15 mL"
        ],
        "temperature": "60 °C; subsequently cooled to room temperature",
        "time": "10 min before pH adjustment; 1 h heating; about two weeks crystallization",
        "vessel_or_method": "Stirred aqueous solution",
        "workup_and_crystallization": "Cool the clear solution to room temperature and leave to crystallize; collect colorless block crystals after about two weeks.",
        "yield": "0.10 g (19.67% based on HoCl3·6H2O)"
      }
