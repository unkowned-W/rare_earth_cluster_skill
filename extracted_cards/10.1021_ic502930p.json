      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "General method for all compounds: CrCl2 (0.124 g, 1.00 mmol), NaN3 (0.110 g, 1.69 mmol) and H2bdea (541 μL, 3.55 mmol) in MeCN (15 mL) were stirred at room temperature under inert atmosphere for 50 min. La(NO3)3·6H2O (0.44 mmol) and pivalic acid (400 mg, 3.91 mmol) were added, stirred 10 min, then CH2Cl2 (10 mL) was added and the mixture was stirred overnight (13 h) under inert atmosphere. The solution was filtered under argon; slow evaporation with admission of air gave magenta crystals (typical yield 30–50%).",
        "reagents": [
          {
            "name": "chromium(II) chloride",
            "formula": "CrCl2",
            "role": "Cr source",
            "amount": "0.124 g, 1.00 mmol"
          },
