      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "Dc susceptibility (2.0–300 K, 0.1 T) is dominated by Dy single-ion effects. χmT = 66.17 cm3 K mol−1 at 300 K, decreasing to 61.65 cm3 K mol−1 at 15 K and 43.08 cm3 K mol−1 at 2 K. Reduced magnetization is nonsuperimposable (anisotropy/low-lying states). A hysteresis loop is observed in M vs H at 2 K. Frequency-dependent ac signals (zero dc field, 3.0 G ac, 311–2311 Hz) indicate SMM behavior with χm″ peak maxima above 2.0 K; Arrhenius fit gives Ueff = 9.27 K and τ0 = 7.37 × 10−6 s.",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "χmT",
            "value": 66.17,
            "unit": "cm3 K mol−1",
            "conditions": "300 K, 0.1 T"
          },
          {
            "property_type": "magnetic",
            "name": "χmT",
            "value": 61.65,
            "unit": "cm3 K mol−1",
            "conditions": "15 K, 0.1 T"
          },
          {
            "property_type": "magnetic",
            "name": "χmT",
            "value": 43.08,
            "unit": "cm3 K mol−1",
            "conditions": "2 K, 0.1 T"
          },
          {
            "property_type": "magnetic",
            "name": "Ueff",
            "value": 9.27,
            "unit": "K",
            "conditions": "zero dc field, 3.0 G ac field, Arrhenius fit of thermally activated region"
          },
          {
            "property_type": "magnetic",
            "name": "τ0",
            "value": "7.37e-6",
            "unit": "s",
            "conditions": "Arrhenius fit of ac relaxation times"
          }
