            "name": "neodymium(III) nitrate hexahydrate",
            "formula": "Nd(NO3)3·6H2O",
            "role": "metal source",
            "amount": "0.117 g, 0.3 mmol"
          }
        ],
        "solvents": [
          "MeCN",
          "MeOH",
          "diethyl ether"
        ],
        "temperature": "reflux, then room temperature",
        "time": "reflux 2 h; crystallization over a few weeks",
        "ph": null,
        "vessel_or_method": "solution reflux followed by diethyl ether vapor diffusion",
        "workup_and_crystallization": "cooled, filtered; diethyl ether slow diffusion into the filtrate at room temperature gave pale yellow microcrystals; single crystals of 1·3H2O used for X-ray diffraction",
