      "compound_label": "1",
      "compound_name": "trapezoidal-pyramid Dy(III) pentanuclear cluster [Dy5L5(OH)2(CO3)(O2COMe)(MeOH)3(H2O)]·3MeOH·3.5H2O",
      "formula": "C69H73Dy5F5N20O28.5",
