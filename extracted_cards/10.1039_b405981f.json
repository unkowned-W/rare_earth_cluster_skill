      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "TbCl3·6H2O (0.037 g, 0.10 mmol) dissolved in MeOH (5 ml) was added to a solution of HL (0.023 g, 0.10 mmol) and Zn(OAc)2·2H2O (0.044 g, 0.20 mmol) in MeOH (5 ml). The mixture was stirred and refluxed for 12 h, filtered, and allowed to evaporate in air. Yellow crystals of 1 were obtained after 2 weeks. Zn(OAc)2·2H2O is required for formation of the Tb10 product.",
