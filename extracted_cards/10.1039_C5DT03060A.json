      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "LH3 (0.04 g, 0.18 mmol) was dissolved in 40 mL methanol. Under stirring, DyCl3·6H2O (0.087 g, 0.23 mmol) was added and the mixture was stirred for 20 min at room temperature. Et3N (0.096 mL, 0.73 mmol) was added dropwise, stirring was continued for 10 min, and pivalic acid (0.028 g, 0.27 mmol) was added. The yellow solution was stirred for 12 h at room temperature, evaporated in vacuo, washed 2–3 times with diethyl ether and dried. The solid was redissolved in MeOH/CHCl3 (1:1) and crystallized by slow evaporation over about 12 days to give needle-shaped yellow crystals.",
        "reagents": [
          {
            "name": "N′-(2-hydroxy-3-(hydroxymethyl)-5-methylbenzylidene)acetohydrazide (LH3)",
            "formula": "LH3",
            "role": "ligand",
            "amount": "0.04 g, 0.18 mmol"
          },
          {
            "name": "dysprosium(III) chloride hexahydrate",
