          "Y"
        ],
        "other_metal_elements": [],
        "dimensionality": "0D",
        "structural_family": "centrosymmetric linear tetranuclear RE4 cluster"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "General protocol for 1–6: RE(dbm)3·2H2O (RE = Y, 0.05 mmol) was dissolved in acetonitrile (20 mL). A solution of HL (0.05 mmol, 0.0136 g) in dichloromethane (10 mL) and DMF (2 mL) was added. The mixture was stirred and refluxed at 70 °C for 3 h, cooled to room temperature, filtered, and the filtrate was concentrated by slow evaporation to give block-shaped yellow crystals after a few days.",
        "reagents": [
          {
            "name": "Y(dbm)3·2H2O",
            "formula": "Y(dbm)3·2H2O",
            "role": "metal precursor",
            "amount": "0.05 mmol"
          },
          {
            "name": "HL (2-[(2-(hydroxyimino)propanehydrazide)methyl]-8-hydroxyquinoline)",
            "formula": "C13H12N4O3",
            "role": "ligand",
            "amount": "0.05 mmol, 0.0136 g"
          }
        ],
        "solvents": [
          "acetonitrile",
          "dichloromethane",
          "DMF"
        ],
        "temperature": "70 °C (reflux)",
        "time": "3 h",
        "ph": null,
        "vessel_or_method": "solution reflux then slow evaporation",
        "workup_and_crystallization": "filtered; filtrate concentrated by slow evaporation at room temperature; block-shaped yellow crystals",
        "yield": "ca. 57% (based on Y)"
      },
      "properties": {
        "reported": true,
        "property_type": "optical",
        "summary": "UV–vis of 1–9 in MeOH shows analogous bands at ca. 204.5, 250 and 349 nm. Photoluminescence of 1 in MeOH is similar to free HL.",
        "measurements": [
          {
            "property_type": "optical",
            "name": "UV-vis absorption maxima",
            "value": "ca. 204.5, 250, 349",
            "unit": "nm",
            "conditions": "MeOH, 1e-5 mol L-1, 200–400 nm, ambient temperature (complexes 1–9)"
          }
        ]
      },
