      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Compounds 1–5 were obtained by mixing [Cu2(O2CtBu)4(HO2CtBu)2] (18 mg, 0.024 mmol) and Ln(NO3)3·nH2O (0.1 mmol; Ln = Gd for 1) in MeCN (16 mL) for 15 min. A solution of H2O3PtBu (14 mg, 0.1 mmol) and Et3N (0.1 mL, 1 mmol) in MeCN (4 mL) was added. The resulting solution was refluxed for 3 h and then filtered. Blue hexagonal X-ray-quality crystals of 1 were collected after 2 weeks of slow-evaporation crystallization.",
        "reagents": [
          {
            "name": "[Cu2(O2CtBu)4(HO2CtBu)2]",
            "formula": "[Cu2(O2CtBu)4(HO2CtBu)2]",
            "role": "Cu precursor",
            "amount": "18 mg, 0.024 mmol"
          },
          {
            "name": "gadolinium nitrate hydrate",
            "formula": "Gd(NO3)3·nH2O",
            "role": "Ln source",
            "amount": "0.1 mmol"
          },
          {
            "name": "tert-butylphosphonic acid",
            "formula": "H2O3PtBu",
            "role": "phosphonate ligand",
            "amount": "14 mg, 0.1 mmol"
          },
          {
            "name": "triethylamine",
            "formula": "Et3N",
            "role": "base",
            "amount": "0.1 mL, 1 mmol"
          }
        ],
        "solvents": [
          "MeCN"
        ],
        "temperature": "reflux",
