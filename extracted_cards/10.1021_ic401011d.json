      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Under aerobic conditions, a solution of N-methyldiethanolamine (mdeaH2; 0.148 g, 1.25 mmol) in MeCN (20 mL) was added dropwise over 20 min to a stirred solution of Gd(NO3)3·6H2O (0.113 g, 0.25 mmol), benzoic acid (0.030 g, 0.25 mmol), FeCl3 (0.040 g, 0.25 mmol), and NaN3 (0.051 g, 0.75 mmol) in MeCN (20 mL). The mixture was heated under reflux for 1 h, cooled to room temperature, and allowed to stand undisturbed in a sealed vial. Orange needles of 1 suitable for X-ray crystallography were obtained after 15 days, collected by filtration, washed with MeCN, and dried in air. Crystals for X-ray crystallography were maintained under mother liquor to avoid solvent loss.",
        "reagents": [
          {
            "name": "N-methyldiethanolamine (mdeaH2)",
            "formula": "C5H13NO2",
            "role": "ligand",
            "amount": "0.148 g, 1.25 mmol"
          },
          {
            "name": "gadolinium(III) nitrate hexahydrate",
