      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Under argon, anhydrous LaCl3 (0.50 g, 2.04 mmol) was added to dry THF (20 mL) and stirred overnight. The mixture was cooled to −78 °C, and H2O (0.0092 g, 0.51 mmol) in THF (5 mL) was added dropwise over 10 min. After warming to room temperature and stirring 4 h, the mixture was heated at 60 °C for 12 h until homogeneous. The solution was cooled to −78 °C and compound 1 (1.44 g, 2.55 mmol) in THF (20 mL) was added in vacuo (5:4:1 molar ratio of 1:LaCl3:H2O). After warming and 4 h stirring, the mixture was refluxed 24 h at 70 °C, becoming pale yellow. Filtration, benzene extraction of the residue (NaCl discarded), solvent removal, and n-hexane washing gave a pale yellow powder of 2.",
        "reagents": [
          {
            "name": "anhydrous lanthanum(III) chloride",
            "formula": "LaCl3",
            "role": "metal source",
            "amount": "0.50 g (2.04 mmol)"
          },
          {
            "name": "water",
            "formula": "H2O",
            "role": "oxide source",
            "amount": "0.0092 g (0.51 mmol)"
          },
          {
            "name": "closo-exo-5,6-Na(THF)2-1-Na(THF)2-2,4-(SiMe3)2-2,4-C2B4H4",
            "formula": "Na2[2,4-(SiMe3)2-2,4-C2B4H4]·4THF",
            "role": "carborane ligand precursor (1)",
            "amount": "1.44 g (2.55 mmol)"
          }
        ],
        "solvents": [
          "THF",
          "benzene",
          "n-hexane"
        ],
        "temperature": "−78 °C then RT, 60 °C, reflux 70 °C",
        "time": "overnight stir; 10 min addition; 4 h RT; 12 h at 60 °C; 4 h RT; 24 h reflux",
        "ph": null,
        "vessel_or_method": "100 mL Pyrex round-bottom flask with magnetic stirring and high-vacuum Teflon valves; argon/high vacuum",
        "workup_and_crystallization": "Filtered in vacuo; benzene extraction of residue; combined filtrates evaporated; washed with n-hexane to give pale yellow powder.",
        "yield": "0.60 g, 0.38 mmol (75%)"
      },
