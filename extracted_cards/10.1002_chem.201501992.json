      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "General procedure for 1–3: [LnCl3]·6H2O (0.28 mmol) was added to LH3 (0.06 g, 0.28 mmol) in methanol (5 mL) and stirred at room temperature for 5 min. Triethylamine (0.08 g, 0.84 mmol) and pivalic acid (0.03 g, 0.28 mmol) were added dropwise. The mixture was stirred a further 2 h at room temperature, giving a light-yellow precipitate that was filtered and washed with cold methanol (2 mL), redissolved in 10 mL acetonitrile/chloroform (1:1), and crystallized by slow evaporation (~1 week) as colorless block crystals. For 1: LH3 (0.06 g, 0.28 mmol), [DyCl3]·6H2O (0.10 g, 0.28 mmol), Et3N (0.08 g, 0.84 mmol), PivH (0.03 g, 0.28 mmol).",
        "reagents": [
          {
            "name": "(E)-2-((2-hydroxyethylimino)methyl)-6-(hydroxymethyl)-4-methylphenol (LH3)",
            "formula": "C11H15NO3",
            "role": "ligand",
            "amount": "0.06 g, 0.28 mmol"
          },
          {
            "name": "dysprosium(III) chloride hexahydrate",
            "formula": "DyCl3·6H2O",
            "role": "metal salt",
            "amount": "0.10 g, 0.28 mmol"
          },
          {
            "name": "triethylamine",
            "formula": "Et3N",
            "role": "base",
            "amount": "0.08 g, 0.84 mmol"
          },
          {
            "name": "pivalic acid",
            "formula": "PivH",
            "role": "coligand",
            "amount": "0.03 g, 0.28 mmol"
          }
        ],
