            "conditions": "dc field 1750 Oe; frequency 1–1500 Hz"
          },
          {
            "property_type": "magnetic",
            "name": "Ueff/kB",
            "value": 8.48,
            "unit": "K",
            "conditions": "Raman plus Orbach fit; τ0 = 4.4×10−6 s; C = 718.46 s−1 K−2.27; m = 2.27"
          },
          {
