      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "All clusters were synthesized from Dy(III) salts, 2,6-diformyl-4-methylphenol and threonine in a molar ratio of 8:1:2 in the presence of Et3N. Single crystals of 1R were obtained by slow evaporation of organic–aqueous mixed solvents at room temperature (full experimental details referred to ESI). In situ Schiff-base formation of R-Hftp2− and R-H2btp3− and controlled hydrolysis of Dy(III) generated the oxo-bridged Dy18 cluster; nitrate anions from the Dy(III) salt are incorporated in 1R.",
        "reagents": [
          {
            "name": "Dy(III) salt",
            "formula": null,
            "role": "metal source",
            "amount": "8 equiv (molar ratio 8:1:2 vs aldehyde and threonine)"
          },
          {
            "name": "2,6-diformyl-4-methylphenol",
            "formula": "C9H8O3",
            "role": "aldehyde precursor for in situ Schiff bases",
            "amount": "1 equiv"
          },
          {
            "name": "threonine",
            "formula": "C4H9NO3",
            "role": "chiral amino-acid source (R)",
            "amount": "2 equiv"
          },
          {
            "name": "triethylamine",
            "formula": "Et3N",
            "role": "base",
            "amount": null
          }
        ],
        "solvents": [
          "organic–aqueous mixed solvents"
        ],
        "temperature": "room temperature",
        "time": null,
        "ph": null,
        "vessel_or_method": "slow evaporation of mixed solvents",
        "workup_and_crystallization": "single crystals obtained by slow evaporation of organic–aqueous mixed solvents at room temperature",
        "yield": null
      },
      "properties": {
        "reported": true,
        "property_type": "both",
        "summary": "Solid-state CD confirms homochirality of 1R versus 1S with mirror-image Cotton effects. Variable-temperature dc susceptibility (300–2 K, 1 kOe) gives χMT = 254.81 cm3 K mol−1 at 300 K, close to 18 isolated Dy(III) ions, decreasing to 153.36 cm3 K mol−1 at 2 K, consistent with Stark depopulation and possible antiferromagnetic Dy···Dy coupling. M–H (0–70 kOe) rises slowly without saturation at 2 K/70 kOe, indicating anisotropy and/or low-lying excited states. χMT–T of 1R nearly coincides with 1S.",
        "measurements": [
          {
            "property_type": "magnetic",
