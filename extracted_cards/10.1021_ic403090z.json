      "compound_name": "[Ni3Dy3(μ3-O)(μ3-OH)3(L)3(μ-OOCCMe3)3](ClO4)·8CH3CN·3CH2Cl2·5.5H2O",
      "formula": "[Ni3Dy3(μ3-O)(μ3-OH)3(L)3(μ-OOCCMe3)3](ClO4)·8CH3CN·3CH2Cl2·5.5H2O",
      "ccdc_numbers": [
        "1020356"
      ],
