          {
            "name": "yttrium(III) chloride",
            "formula": "YCl3",
            "role": "metal precursor",
            "amount": "0.41 g, 2.1 mmol"
          },
          {
            "name": "3,5-dimethylpyrazolylsodium",
            "formula": "Na(pzMe2)",
            "role": "ligand source",
            "amount": "0.78 g, 6.6 mmol"
          },
          {
            "name": "water",
            "formula": "H2O",
            "role": "oxo source (traces)",
            "amount": null
          }
        ],
        "solvents": [
          "THF",
          "toluene"
        ],
        "temperature": "reflux (THF stage)",
        "time": "6 d reflux in THF",
