        "structural_family": "homoleptic nonanuclear Ln9 OH-Salen acetate cluster"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "To a stirred solution of OH-H Salen ligand H3L1 (0.149 g, 0.5 mmol) in absolute MeCN (6 mL), Et3N (210 μL) was added and the mixture was stirred at room temperature for 3 h. A solution of La(OAc)3·6H2O (0.212 g, 0.5 mmol) in absolute MeOH (6 mL) was then added and the mixture was refluxed for another 3 h. After cooling to room temperature, the pale yellow solution was filtered. Diethyl ether was allowed to diffuse slowly into the filtrate at room temperature, giving pale yellow microcrystals of 1 after a few weeks.",
        "reagents": [
          {
            "name": "H3L1 (N,N'-bis(salicylidene)(propylene-2-ol)-1,3-diamine)",
            "formula": "H3L1",
            "role": "ligand",
            "amount": "0.149 g, 0.5 mmol"
          },
          {
            "name": "triethylamine",
            "formula": "Et3N",
            "role": "base",
            "amount": "210 μL"
          },
          {
            "name": "lanthanum acetate hexahydrate",
            "formula": "La(OAc)3·6H2O",
            "role": "metal source",
            "amount": "0.212 g, 0.5 mmol"
          }
        ],
        "solvents": [
          "MeCN",
          "MeOH",
          "diethyl ether"
        ],
        "temperature": "RT then reflux",
        "time": "3 h at RT then 3 h reflux; crystallization over a few weeks",
        "ph": null,
        "vessel_or_method": "solution self-assembly followed by diethyl ether vapor diffusion",
        "workup_and_crystallization": "cool to RT, filter, slow diffusion of diethyl ether into the filtrate at RT",
