            "formula": "NaN3",
            "role": "coligand/base",
            "amount": "0.110 g, 1.69 mmol"
          },
          {
            "name": "N-n-butyldiethanolamine",
            "formula": "H2bdea",
            "role": "ligand",
            "amount": "541 μL, 3.55 mmol"
          },
          {
            "name": "lanthanum(III) nitrate hexahydrate",
            "formula": "La(NO3)3·6H2O",
            "role": "Ln source",
            "amount": "0.44 mmol"
          },
          {
            "name": "pivalic acid",
            "formula": "Hpiv",
            "role": "coligand",
            "amount": "400 mg, 3.91 mmol"
          }
        ],
        "solvents": [
          "acetonitrile",
          "dichloromethane"
        ],
