            "property_type": "magnetic",
            "name": "Ueff (fast relaxation)",
            "value": 3.7,
            "unit": "K",
            "conditions": "1 kOe dc field; FR Arrhenius fit; τ0 = 1.86×10−4 s"
          },
          {
