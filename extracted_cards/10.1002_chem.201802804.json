      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Gd2O3 (0.1994 g, 0.55 mmol), CrCl3·6H2O (0.1465 g, 0.55 mmol), HIN (0.2462 g, 2.00 mmol), and HCOOH (0.0184 g, 0.35 mmol) were stirred for 12 h at ambient atmosphere. The pH was adjusted to 4 with 2 mol L−1 NaOH. The mixture was placed in a 25 mL Teflon reactor and kept at 170 °C for 7 days. After cooling to ambient temperature, purple block-like crystals were obtained. Enantiomers 1 and 3 were separated by hand under a polarizing microscope.",
        "reagents": [
          {
            "name": "gadolinium(III) oxide",
            "formula": "Gd2O3",
            "role": "Ln source",
            "amount": "0.1994 g, 0.55 mmol"
          },
          {
            "name": "chromium(III) chloride hexahydrate",
            "formula": "CrCl3·6H2O",
            "role": "Cr source",
            "amount": "0.1465 g, 0.55 mmol"
          },
          {
            "name": "isonicotinic acid",
            "formula": "HIN",
            "role": "ligand",
            "amount": "0.2462 g, 2.00 mmol"
          },
          {
            "name": "formic acid",
            "formula": "HCOOH",
            "role": "additive",
            "amount": "0.0184 g, 0.35 mmol"
          },
          {
            "name": "sodium hydroxide",
            "formula": "NaOH",
            "role": "pH adjuster",
            "amount": "2 mol L−1, to pH 4"
          }
        ],
        "solvents": [],
        "temperature": "stirring at ambient temperature, then hydrothermal 170 °C",
        "time": "stirred 12 h; hydrothermal 7 days",
        "ph": "4",
