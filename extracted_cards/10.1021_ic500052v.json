      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "LH3 (0.060 g, 0.20 mmol) was dissolved in methanol (10 mL) and chloroform (5 mL). GdCl3·6H2O (0.111 g, 0.30 mmol; 1.5 equiv) was added and the mixture was stirred at room temperature for 10 min. Excess triethylamine (0.10 mL, 1 mmol) was added dropwise and stirring was continued for 10 h at room temperature to afford a clear yellow solution, which was filtered and kept for crystallization. After about 10 days, block-shaped colorless crystals suitable for X-ray crystallography were obtained by slow evaporation.",
        "reagents": [
          {
            "name": "N'-(2-hydroxy-3-methoxybenzylidene)-6-(hydroxymethyl)picolinohydrazide (LH3)",
            "formula": "LH3",
            "role": "ligand",
            "amount": "0.060 g, 0.20 mmol"
          },
          {
            "name": "gadolinium(III) chloride hexahydrate",
            "formula": "GdCl3·6H2O",
            "role": "metal salt",
            "amount": "0.111 g, 0.30 mmol"
          },
          {
            "name": "triethylamine",
            "formula": "Et3N",
            "role": "base",
            "amount": "0.10 mL, 1 mmol"
          }
        ],
        "solvents": [
          "methanol (10 mL)",
          "chloroform (5 mL)"
        ],
        "temperature": "room temperature",
        "time": "10 min then 10 h; crystallization ~10 days",
        "ph": null,
        "vessel_or_method": "solution stirring followed by slow evaporation",
        "workup_and_crystallization": "filtered yellow solution; block-shaped colorless crystals by slow evaporation after about 10 days",
        "yield": "42 mg, 30% (based on Gd)"
      },
      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "Dc susceptibility of 1 matches six noninteracting Gd(III) ions at 300 K (χMT = 47.2 cm3 mol−1 K vs 47.25 anticipated) and falls to 26.8 cm3 mol−1 K at 2 K. The decrease below 50 K, Curie–Weiss parameters Θ = −1.5 K and C = 7.90 per Gd, and magnetization below the Brillouin curve for six S = 7/2, g = 2 spins indicate weak antiferromagnetic Gd–Gd exchange. No SMM behavior is reported for the Gd analogue.",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "χMT",
            "value": "47.2",
            "unit": "cm3 mol−1 K",
            "conditions": "300 K, Hdc = 1000 Oe"
          },
          {
            "property_type": "magnetic",
            "name": "χMT",
            "value": "26.8",
            "unit": "cm3 mol−1 K",
            "conditions": "2 K, Hdc = 1000 Oe"
          },
          {
