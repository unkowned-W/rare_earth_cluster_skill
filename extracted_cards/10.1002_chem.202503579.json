      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "A mixture of Gd(NO3)3·6H2O (100 mg, 0.222 mmol), H5bt (46 mg, 0.222 mmol), 4-formylbenzoic acid (45 mg, 0.222 mmol), and TEA hydroxide (443 μL, 0.665 mmol) was dissolved in 5 mL of methanol/acetonitrile (1:4, v/v). Toluene (0.5 mL) was added. The mixture was heated at 120 °C for 12 h in a 25 mL hydrothermal autoclave and cooled to room temperature over 36 h. Colorless needle crystals suitable for SCXRD were isolated from the mother liquor; remaining solid was filtered, washed with mother liquor, and dried under ambient conditions.",
        "reagents": [
          {
