            "formula": "NaN(SiMe3)2",
            "role": "base / NaNHPh generator",
            "amount": "17 mL of 1 M THF solution (targeted); 5.21 mL of 1 M THF solution (unplanned)"
          },
          {
            "name": "hexamethylcyclotrisiloxane",
            "formula": "(Me2SiO)3",
            "role": "oxasilylamido ligand source",
            "amount": "0.34 g (1.55 mmol) in targeted synthesis"
          }
        ],
