            "name": "2,2'-diphenol (H2L1)",
            "formula": "H2L1",
            "role": "ligand",
            "amount": "0.1 mmol, 0.0186 g"
          },
          {
            "name": "5,7-dichloro-8-hydroxyquinoline (HL2)",
            "formula": "HL2",
            "role": "ligand",
            "amount": "0.05 mmol, 0.0107 g"
