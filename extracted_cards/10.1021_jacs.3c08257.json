            "property_type": "optical",
            "name": "Ni(II) d–d NCD/MCD",
            "value": "broad peaks essentially unchanged vs B = 0 T",
            "unit": null,
            "conditions": "380, 590, 950 nm; KBr; compared at 0 and ±1.6 T"
          }
        ]
