      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "DC magnetism of the {Cr3Gd3} triangle-in-triangle cluster is dominated by antiferromagnetic Cr(III)–Gd(III) coupling; Cr–Cr and Gd–Gd interactions are negligible. χT at 300 K is 28.6 cm3 K mol−1 (1 kOe). χT shows a minimum near 10 K then rises; 1.8 K χT is 21.0 cm3 K mol−1 consistent with an S = 6 ground state. Magnetization saturates at 12.2 NμB below 60 kOe at 1.8 K. Simultaneous fit of χT and magnetization gives g = 2.03 and J = −0.92 cm−1.",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "χT",
            "value": 28.6,
            "unit": "cm3 K mol−1",
            "conditions": "room temperature, 1 kOe DC"
          },
          {
            "property_type": "magnetic",
            "name": "χT",
            "value": 21.0,
            "unit": "cm3 K mol−1",
            "conditions": "1.8 K"
          },
          {
            "property_type": "magnetic",
            "name": "magnetization",
            "value": 12.2,
            "unit": "NμB",
            "conditions": "1.8 K, below 60 kOe"
          },
          {
            "property_type": "magnetic",
            "name": "g",
            "value": 2.03,
            "unit": null,
            "conditions": "PHI fit of χT and magnetization, Hamiltonian eqn (1)"
          },
          {
            "property_type": "magnetic",
            "name": "J(Cr–Gd)",
            "value": -0.92,
            "unit": "cm−1",
            "conditions": "PHI simultaneous susceptibility/magnetization fit"
          }
        ]
