      ],
      "structure_description": "A discrete spherical tridecanuclear lanthaball has a central 12-coordinate Ce bound by six carbonate ligands, surrounded by 12 further Ce centers and additional bridging carbonates in a [Ce13(CO3)14] core. Its molecular structure is essentially that of the previously reported α-1Ce, but β-1Ce is a distinct packing pseudopolymorph.",
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "ph": null,
        "procedure": "Add methanolic (Et4N)(dcnm) to 1,10-phenanthroline monohydrate in methanol, then add methanolic CeCl3·7H2O. Allow the solution to evaporate to dryness over one month; carbonate forms through atmospheric CO2 fixation. Only one crystal was obtained, and its degree of solvation could not be determined.",
        "reagents": [
          {
            "amount": "100 mg, 446 μmol",
            "formula": "(Et4N)(dcnm)",
            "name": "tetraethylammonium dicyanonitrosomethanide",
            "role": "ccnm precursor"
          },
          {
            "amount": "44 mg, 222 μmol",
            "formula": null,
            "name": "1,10-phenanthroline monohydrate",
            "role": "ligand"
          },
          {
            "amount": "41 mg, 110 μmol",
            "formula": "CeCl3·7H2O",
            "name": "cerium(III) chloride heptahydrate",
            "role": "metal source"
          }
        ],
        "si_used": false,
        "solvents": [
          "methanol (1 mL for dcnm salt, 4 mL for phenanthroline, 1 mL for cerium salt)"
        ],
        "temperature": null,
        "time": "1 month",
        "vessel_or_method": "Solution evaporation",
        "workup_and_crystallization": "A single small orange crystal was removed from an amorphous white precipitate.",
        "yield": "One crystal; bulk yield not reported"
      }
