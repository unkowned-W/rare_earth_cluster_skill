      "structure_description": "Three approximately parallel Tb(III) hexaazamacrocyclic units form a triplex. Each adjacent pair is connected by two bridging fluorides; the terminal Tb(III) ions also bind bidentate nitrate.",
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "ph": null,
        "procedure": "Stir the mononuclear Tb(III) nitrate macrocyclic complex in chloroform and methanol for 30 min, add tetraethylammonium fluoride monohydrate with stirring, and allow the clear solution to evaporate slowly to about 10 mL over 4 days.",
        "reagents": [
          {
            "amount": "68.1 mg (0.1 mmol)",
            "formula": "[Tb(L)(NO3)2](NO3)·H2O",
            "name": "mononuclear terbium(III) hexaazamacrocyclic nitrate complex",
            "role": "starting complex"
          },
          {
            "amount": "30.1 mg (0.18 mmol)",
            "formula": "NEt4F·H2O",
            "name": "tetraethylammonium fluoride monohydrate",
            "role": "fluoride source"
          }
        ],
        "si_used": false,
        "solvents": [
          "chloroform (15 mL)",
          "methanol (15 mL)"
        ],
        "temperature": null,
        "time": "30 min stirring; 4 days evaporation",
        "vessel_or_method": "solution reaction and slow evaporation",
        "workup_and_crystallization": "Filter the X-ray-quality crystals and wash with 1 mL methanol. The efflorescent crystals lose organic crystallization solvents on drying.",
        "yield": null
      }
    },
