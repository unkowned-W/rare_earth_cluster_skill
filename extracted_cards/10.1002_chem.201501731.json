          {
            "name": "diethylenetriamine",
            "formula": "C4H13N3",
            "role": "N,N,N-donor capping ligand L1",
            "amount": "0.1290 g, 0.135 mL, 1.25 mmol"
          }
        ],
        "solvents": [
          "CH3CN"
        ],
