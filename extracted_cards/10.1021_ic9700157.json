        "other_metal_elements": [],
        "dimensionality": "0D",
        "structural_family": "oxo-hydroxo-alkoxide butterfly cluster"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "In a glovebox, Lu[N(SiMe3)2]3 was suspended in n-hexane, cooled to -35 °C, and treated by slow addition of alcohol 1a that had not been predried over molecular sieves. The cloudy solution was stirred for 88 h at room temperature, filtered, and the filtrate evaporated to dryness. The residue was dried under high vacuum (10^-3 Torr) for 6 h to give white powder 3, which can be sublimed above 220 °C/10^-3 Torr. Crystallization of the sublimed material from n-hexane at -35 °C yielded a few colorless single crystals of 3a.",
        "reagents": [
          {
            "name": "lutetium tris[bis(trimethylsilyl)amide]",
            "formula": "Lu[N(SiMe3)2]3",
            "role": "metal precursor",
            "amount": "0.51 g, 0.78 mmol"
          },
          {
            "name": "1-methoxy-2-methylpropan-2-ol (1a, not predried)",
            "formula": "HOCMe2CH2OMe",
            "role": "ligand precursor / adventitious water source",
            "amount": "0.24 g, 2.30 mmol"
          }
        ],
        "solvents": [
          "n-hexane"
        ],
        "temperature": "-35 °C addition, then room temperature stirring; crystallization at -35 °C",
        "time": "88 h stirring; dried 6 h under high vacuum",
        "ph": null,
        "vessel_or_method": "glovebox; silylamide alcoholysis with water-contaminated alcohol",
        "workup_and_crystallization": "filtration, evaporation, high-vacuum drying to powder 3; sublimation >220 °C/10^-3 Torr; crystals of 3a from n-hexane at -35 °C",
        "yield": "0.30 g of powder 3; a few single crystals of 3a"
      },
