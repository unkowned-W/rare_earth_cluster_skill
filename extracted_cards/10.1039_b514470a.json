          {
            "property_type": "magnetic",
            "name": "χT (observed, per Ln3+)",
            "value": 1.07,
            "unit": "emu K mol−1",
            "conditions": "SQUID, 100 G, 5–300 K"
          },
          {
            "property_type": "magnetic",
            "name": "χT (calculated free-ion, per Ln3+)",
            "value": 1.64,
            "unit": "emu K mol−1",
            "conditions": "gJ = 8/11"
          },
          {
            "property_type": "magnetic",
            "name": "Weiss constant θ",
            "value": -63,
            "unit": "K",
            "conditions": "from Curie–Weiss analysis of 1"
