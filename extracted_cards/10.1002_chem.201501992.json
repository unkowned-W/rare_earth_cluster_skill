        "time": "5 min then 2 h; crystallization ~1 week",
        "ph": null,
        "vessel_or_method": "stirred solution; slow evaporation crystallization from MeCN/CHCl3 (1:1)",
        "workup_and_crystallization": "Light-yellow precipitate filtered, washed with cold methanol (2 mL), redissolved in 10 mL MeCN/CHCl3 (1:1); colorless blocks after ~1 week.",
        "yield": "0.078 g, 47% (based on Dy)"
      },
      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "Dy10 wheel shows field-induced SMM behavior. χMT at 300 K is 141.30 cm3 K mol−1 (calc. 141.7), falling to 99.19 at 2 K; M(2 K, 5 T)=55.54 NμB. Under 0.4 T dc, Ueff=16.12(8) K and τ0=3.3×10−5 s; Cole–Cole α=0.55–0.64.",
