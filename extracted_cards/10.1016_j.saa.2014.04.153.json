            "name": "visible emission maximum",
            "value": "462",
            "unit": "nm",
            "conditions": "MeCN, RT; τ < 1 ns, Φem < 10−5"
          },
          {
            "property_type": "optical",
            "name": "NIR emission maxima",
            "value": "890, 1083, 1330",
            "unit": "nm",
            "conditions": "λex = 350 nm, MeCN, 1×10−5 M, RT; 4F3/2 → 4I9/2, 4I11/2, 4I13/2"
          },
          {
            "property_type": "optical",
            "name": "NIR lifetime",
            "value": 1.68,
            "unit": "μs",
            "conditions": "1083 nm, MeCN, monoexponential"
          },
          {
            "property_type": "optical",
            "name": "intrinsic quantum yield ΦLn",
            "value": 0.67,
            "unit": "%",
            "conditions": "estimated as τobs/τ0 with τ0(Nd) = 0.25 ms"
          }
        ]
