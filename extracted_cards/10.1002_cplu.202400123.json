      "compound_label": "1S",
      "compound_name": "[Cu8Gd4(OH)8(OMe)4(O2CBut)8(L-S)4(H2O)4]·5.5MeOH·5.25H2O",
      "formula": "C88H152Cu8Gd4N4O44·5.5MeOH·5.25H2O",
      "ccdc_numbers": [
        "2332082"
      ],
      "ccdc_refcodes": [
        "SABSAU"
      ],
      "material_class": {
        "material_type": "cluster",
        "nuclearity": 12,
        "metal_composition": "heterometallic",
        "rare_earth_elements": [
          "Gd"
        ],
        "other_metal_elements": [
          "Cu"
        ],
        "dimensionality": "0D",
        "structural_family": "Cu8Ln4 cyclic cubane-based cluster"
      },
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "si_used": false,
        "procedure": "Under aerobic conditions, o-vanillin (0.50 mmol, 0.0761 g), (S)-(+)-2-amino-1-propanol (0.50 mmol, 40 μL) and Et3N (1.0 mmol, 140 μL) were dissolved in MeOH (10 mL) to give a yellow solution, stirred at room temperature for 10 min. Gd(NO3)3·6H2O (0.2257 g, 0.50 mmol) was added and stirred for 10 min. [Cu2(O2CBut)4(HO2CBut)2] (0.25 mmol, 0.1840 g) in MeOH (10 mL) was added; the solution immediately turned emerald green and was stirred at room temperature for 10 min. X-ray quality crystals of 1S·5.5MeOH·5.25H2O formed in closed vials after 20 days.",
        "reagents": [
          {
            "name": "o-vanillin",
            "formula": "C8H8O3",
            "role": "Schiff-base precursor",
            "amount": "0.50 mmol, 0.0761 g"
          },
          {
            "name": "(S)-(+)-2-amino-1-propanol",
            "formula": "C3H9NO",
            "role": "chiral amine / Schiff-base precursor",
            "amount": "0.50 mmol, 40 μL"
          },
          {
            "name": "triethylamine",
            "formula": "Et3N",
            "role": "base",
            "amount": "1.0 mmol, 140 μL"
          },
          {
            "name": "gadolinium(III) nitrate hexahydrate",
            "formula": "Gd(NO3)3·6H2O",
            "role": "Ln source",
            "amount": "0.2257 g (0.50 mmol)"
          },
          {
            "name": "copper(II) pivalate",
            "formula": "[Cu2(O2CBut)4(HO2CBut)2]",
            "role": "Cu source / carboxylate ligand",
            "amount": "0.25 mmol, 0.1840 g"
          }
        ],
        "solvents": [
          "MeOH"
        ],
        "temperature": "room temperature",
        "time": "stirring 10 min after each addition; crystallization 20 days",
        "ph": null,
        "vessel_or_method": "aerobic solution synthesis; crystallization in closed vials",
        "workup_and_crystallization": "X-ray quality crystals obtained in closed vials after 20 days.",
        "yield": "0.0265 g, ~6.8% based on Gd(III)"
      },
      "properties": {
        "reported": true,
        "property_type": "both",
        "summary": "Dominant antiferromagnetic Cu/Gd coupling. CD spectroscopy of the family confirms retained chirality in DMSO; enantiomeric pairs give mirror-image spectra.",
