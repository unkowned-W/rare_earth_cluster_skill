      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "Hexanuclear Tb6 wheel SMT candidate: room-temperature χMT matches six non-interacting TbIII ions; χMT decreases on cooling (depopulation of mJ states and possible AF exchange). Weak broad χM'' in zero dc field; field-dependent ac data give Ueff ≈ 23 K. Low-field magnetization does not show an S-shape, but fast relaxation below 2 K is interpreted as consistent with a toroidal moment. Ab initio analysis supports a net toroidal magnetic ground state.",
        "measurements": [
          {
            "property_type": "magnetic",
