      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "Dc susceptibility and magnetization of 5 show weak magnetic interactions (room-temperature χmT ≈ free-ion value; small negative Weiss constant) and mixed antiferromagnetic/ferromagnetic Gd–Gd and Gd–Cu couplings from Hamiltonian fitting. A magnetocaloric effect is observed, with −ΔSm = 19.6 J kg−1 K−1 at 3 K and 7 T, below the 15R spin-only maximum of 34.1 J kg−1 K−1.",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "χmT",
            "value": 41.7,
            "unit": "cm3 K mol−1",
            "conditions": "room temperature; polycrystalline; compared with expected 41.6 cm3 K mol−1 for 5 Gd(III) (S=7/2, g=2) + 6 Cu(II) (S=1/2, g=2)"
          },
          {
            "property_type": "magnetic",
            "name": "χmT",
            "value": 41.2,
            "unit": "cm3 K mol−1",
            "conditions": "30 K; dc susceptibility 2–300 K"
          },
          {
            "property_type": "magnetic",
            "name": "χmT",
            "value": 18.1,
            "unit": "cm3 K mol−1",
            "conditions": "2 K (minimum)"
          },
          {
            "property_type": "magnetic",
            "name": "Weiss constant θ",
            "value": -3.4,
            "unit": "K",
            "conditions": "Curie–Weiss fit of χm−1 vs T, 50–300 K"
          },
          {
            "property_type": "magnetic",
            "name": "magnetization M",
            "value": 40.5,
            "unit": "Nβ",
            "conditions": "2–10 K, 0–7 T; nearly saturates at 7 T (Msat = 41 Nβ)"
          },
          {
            "property_type": "magnetic",
            "name": "exchange coupling J1 (axial–equatorial Gd–Gd)",
            "value": -0.16,
            "unit": "K",
            "conditions": "isotropic Hamiltonian fit with g=2.0 for all ions; T=2–65 K, 0–7 T; J3, J4, J6 omitted"
          },
          {
            "property_type": "magnetic",
            "name": "exchange coupling J2 (axial Gd–Cu)",
            "value": 4,
            "unit": "K",
            "conditions": "same Hamiltonian fit; ferromagnetic; Gd–Gd exchange of order 0.2 K, Gd–Cu an order of magnitude larger"
          },
          {
            "property_type": "magnetic",
            "name": "−ΔSm (magnetocaloric entropy change)",
            "value": 19.6,
            "unit": "J kg−1 K−1",
            "conditions": "from Maxwell relation on magnetization data; maximum at 3 K and 7 T (Fig. 4); theoretical maximum 34.1 J kg−1 K−1 (15R)"
          }
        ]
      },
