      "properties": {
        "reported": true,
        "property_type": "magnetic",
        "summary": "DC susceptibility of 1 under 1000 Oe (2–300 K) shows χMT = 115.3 cm3 K mol−1 at room temperature (calc. 113.3 cm3 K mol−1 for eight Dy3+), nearly constant to 100 K then decreasing (90.15 cm3 K mol−1 at lowest T), indicating antiferromagnetic Dy···Dy interactions and thermal depopulation of Dy3+ CF levels; CoIII is trivalent. Magnetization below 10 K rises rapidly at low field then slowly at high field, consistent with Dy3+ anisotropy. Zero-field AC data (1–1000 Hz, 2–12 K) show frequency-dependent χ″ without a maximum even at 2 K; a 1000 Oe dc field does not clearly suppress tunneling. Linear fits of ln(χ″/χ′) vs 1/T give Ueff = 1.46 K and τ0 = 2.4 × 10−5 s, supporting slow relaxation/SMM behavior.",
        "measurements": [
          {
            "property_type": "magnetic",
            "name": "χMT",
            "value": 115.3,
            "unit": "cm3 K mol−1",
            "conditions": "room temperature; Hdc = 1000 Oe"
          },
          {
            "property_type": "magnetic",
            "name": "χMT (calculated, 8 Dy3+)",
            "value": 113.3,
            "unit": "cm3 K mol−1",
            "conditions": "S = 5/2, L = 5, 6H15/2"
          },
          {
            "property_type": "magnetic",
            "name": "χMT",
            "value": 90.15,
            "unit": "cm3 K mol−1",
            "conditions": "lowest temperature measured; Hdc = 1000 Oe; 2.0–300 K scan"
          },
          {
            "property_type": "magnetic",
            "name": "Ueff",
            "value": 1.46,
            "unit": "K",
            "conditions": "estimated from ln(χ″M/χ′M) vs 1/T; 3–1000 Hz; zero dc field"
          },
          {
