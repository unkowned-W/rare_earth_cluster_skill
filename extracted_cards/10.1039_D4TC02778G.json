      "structure_description": "A discrete, crown-like triangular Dy3 core has one μ-Cl bridge along each Dy–Dy edge and is capped on opposite sides by μ3-Cl and μ3-S. Each Dy bears an η5-Cp* and a coordinated THF ligand.",
      "synthesis": {
        "main_text_has_explicit_synthesis": true,
        "ph": null,
        "procedure": "Under argon in a glovebox, mix a THF solution of DyCl3 and NaCp* with a THF solution of sulfur and NaBH4. Stir at room temperature for 24 h, then centrifuge at 5000 rpm for 5 min.",
        "reagents": [
          {
            "amount": "403.3 mg, 1.500 mmol",
            "formula": "DyCl3",
            "name": "dysprosium trichloride",
            "role": "rare-earth precursor"
          },
          {
            "amount": "237.3 mg, 1.500 mmol",
            "formula": "NaCp*",
            "name": "sodium pentamethylcyclopentadienide",
            "role": "Cp* source"
          },
          {
            "amount": "16.0 mg, 0.50 mmol",
            "formula": "S",
            "name": "sulfur",
            "role": "chalcogen source"
          },
          {
            "amount": "37.8 mg, 1.00 mmol",
            "formula": "NaBH4",
            "name": "sodium borohydride",
            "role": "reducing agent"
          }
        ],
        "si_used": false,
        "solvents": [
          "THF (2.5 mL for each solution)"
        ],
        "temperature": "room temperature",
        "time": "24 h",
        "vessel_or_method": "argon-filled glovebox",
        "workup_and_crystallization": "Concentrate the bright-yellow filtrate to approximately 3 mL and leave at room temperature to obtain bright-yellow single crystals.",
        "yield": "80 mg, 12% based on DyCl3"
      }
    },
